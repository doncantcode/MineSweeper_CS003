     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    27                                  
    28                                  ; --- code ----------------------------------------------------------
    29                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 B81300              <1>     mov ax,0013h                ; 320x200x256
     6 00000003 CD10                <1>     int 10h
     7 00000005 FC                  <1>     cld
     8 00000006 E88A00              <1>     call SetPalette
     9                              <1> 
    10 00000009 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    11 0000000B CD33                <1>     int 33h
    12 0000000D B80700              <1>     mov ax,7                    ; X range 0..639
    13 00000010 31C9                <1>     xor cx,cx
    14 00000012 BA7F02              <1>     mov dx,639
    15 00000015 CD33                <1>     int 33h
    16 00000017 B80800              <1>     mov ax,8                    ; Y range 0..199
    17 0000001A 31C9                <1>     xor cx,cx
    18 0000001C BAC700              <1>     mov dx,199
    19 0000001F CD33                <1>     int 33h
    20                              <1> 
    21 00000021 E8B100              <1>     call NewGame
    22 00000024 E8E905              <1>     call DrawStatic
    23 00000027 E8C407              <1>     call Redraw
    24                              <1>     SHOWM
    10 0000002A B80100              <2>  mov ax,1
    11 0000002D CD33                <2>  int 33h
    25                              <1> 
    26                              <1> GameLoop:
    27 0000002F E85B02              <1>     call UpdateTimer
    28                              <1> 
    29 00000032 B401                <1>     mov ah,01h                  ; key waiting?
    30 00000034 CD16                <1>     int 16h
    31 00000036 752B                <1>     jnz KeyPressed
    32                              <1> 
    33 00000038 B80300              <1>     mov ax,0003h                ; poll mouse
    34 0000003B CD33                <1>     int 33h
    35 0000003D 80E303              <1>     and bl,3
    36 00000040 741A                <1>     jz .released
    37 00000042 803E[710E]00        <1>     cmp byte [PrevMouse],0
    38 00000047 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    39 00000049 881E[710E]          <1>     mov [PrevMouse],bl
    40 0000004D D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    41 0000004F 890E[6D0E]          <1>     mov [MouseX],cx
    42 00000053 8916[6F0E]          <1>     mov [MouseY],dx
    43 00000057 E87D03              <1>     call HandleClick
    44 0000005A EBD3                <1>     jmp GameLoop
    45                              <1> .released:
    46 0000005C C606[710E]00        <1>     mov byte [PrevMouse],0
    47 00000061 EBCC                <1>     jmp GameLoop
    48                              <1> 
    49                              <1> KeyPressed:
    50 00000063 B400                <1>     mov ah,00h
    51 00000065 CD16                <1>     int 16h
    52 00000067 3C1B                <1>     cmp al,27                   ; ESC
    53 00000069 7414                <1>     je ExitGame
    54 0000006B 0C20                <1>     or al,20h                   ; to lower case
    55 0000006D 3C6D                <1>     cmp al,'m'
    56 0000006F 7409                <1>     je .mute
    57 00000071 3C72                <1>     cmp al,'r'
    58 00000073 75BA                <1>     jne GameLoop
    59 00000075 E81400              <1>     call DoRestart
    60 00000078 EBB5                <1>     jmp GameLoop
    61                              <1> .mute:
    62 0000007A E81B03              <1>     call ToggleMusic
    63 0000007D EBB0                <1>     jmp GameLoop
    64                              <1> 
    65                              <1> ExitGame:
    66 0000007F E84E03              <1>     call SpeakerOff
    67 00000082 B80300              <1>     mov ax,0003h
    68 00000085 CD10                <1>     int 10h
    69 00000087 B8004C              <1>     mov ax,4C00h
    70 0000008A CD21                <1>     int 21h
    71                              <1> 
    72                              <1> DoRestart:
    73 0000008C E84600              <1>     call NewGame
    74 0000008F E85C07              <1>     call Redraw
    75 00000092 C3                  <1>     ret
    30                                  %include "src/palette.asm"      ; DAC palette setup
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Palette: gradient background (32..51), number colours (52..59),
     3                              <1> ; classic light/dark grey for tile faces and shadows (7, 8)
     4                              <1> ; -------------------------------------------------------------------
     5                              <1> SetPalette:
     6 00000093 60                  <1>     pusha
     7 00000094 FC                  <1>     cld
     8 00000095 BAC803              <1>     mov dx,3C8h
     9 00000098 B007                <1>     mov al,7
    10 0000009A EE                  <1>     out dx,al
    11 0000009B 42                  <1>     inc dx
    12 0000009C BE[740A]            <1>     mov si,PalGrays
    13 0000009F B90600              <1>     mov cx,6
    14 000000A2 F36E                <1>     rep outsb
    15                              <1> 
    16 000000A4 4A                  <1>     dec dx
    17 000000A5 B020                <1>     mov al,32
    18 000000A7 EE                  <1>     out dx,al
    19 000000A8 42                  <1>     inc dx
    20 000000A9 30DB                <1>     xor bl,bl
    21 000000AB B91400              <1>     mov cx,20
    22                              <1> .grad:
    23 000000AE 88D8                <1>     mov al,bl
    24 000000B0 C0E802              <1>     shr al,2
    25 000000B3 0403                <1>     add al,3                    ; R
    26 000000B5 EE                  <1>     out dx,al
    27 000000B6 88D8                <1>     mov al,bl
    28 000000B8 D0E8                <1>     shr al,1
    29 000000BA 0406                <1>     add al,6                    ; G
    30 000000BC EE                  <1>     out dx,al
    31 000000BD 88D8                <1>     mov al,bl
    32 000000BF 0410                <1>     add al,16                   ; B
    33 000000C1 EE                  <1>     out dx,al
    34 000000C2 FEC3                <1>     inc bl
    35 000000C4 E2E8                <1>     loop .grad
    36                              <1> 
    37 000000C6 4A                  <1>     dec dx
    38 000000C7 B034                <1>     mov al,52
    39 000000C9 EE                  <1>     out dx,al
    40 000000CA 42                  <1>     inc dx
    41 000000CB BE[7A0A]            <1>     mov si,PalNums
    42 000000CE B91800              <1>     mov cx,24
    43 000000D1 F36E                <1>     rep outsb
    44 000000D3 61                  <1>     popa
    45 000000D4 C3                  <1>     ret
    31                                  %include "src/game.asm"         ; board state, mines, reveal, win check
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Game state
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> NewGame:
     5 000000D5 60                  <1>     pusha
     6 000000D6 1E                  <1>     push ds
     7 000000D7 07                  <1>     pop es
     8 000000D8 FC                  <1>     cld
     9 000000D9 BF[7F0E]            <1>     mov di,Board
    10 000000DC B95100              <1>     mov cx,CELLS
    11 000000DF 30C0                <1>     xor al,al
    12 000000E1 F3AA                <1>     rep stosb
    13                              <1> 
    14 000000E3 B400                <1>     mov ah,00h
    15 000000E5 CD1A                <1>     int 1Ah
    16 000000E7 3116[7D0E]          <1>     xor [RndSeed],dx
    17                              <1> 
    18 000000EB 30DB                <1>     xor bl,bl                   ; mines placed
    19                              <1> .place:
    20 000000ED E84200              <1>     call GetRandom
    21 000000F0 31D2                <1>     xor dx,dx
    22 000000F2 B95100              <1>     mov cx,CELLS
    23 000000F5 F7F1                <1>     div cx                      ; DX = 0..80
    24 000000F7 89D6                <1>     mov si,dx
    25 000000F9 F684[7F0E]01        <1>     test byte [Board+si],1
    26 000000FE 75ED                <1>     jnz .place
    27 00000100 808C[7F0E]01        <1>     or byte [Board+si],1
    28 00000105 FEC3                <1>     inc bl
    29 00000107 80FB0A              <1>     cmp bl,TOTAL_MINES
    30 0000010A 72E1                <1>     jb .place
    31                              <1> 
    32 0000010C E84300              <1>     call ComputeNumbers
    33                              <1> 
    34 0000010F C606[720E]00        <1>     mov byte [GameOver],0
    35 00000114 C606[730E]00        <1>     mov byte [Started],0
    36 00000119 C606[740E]00        <1>     mov byte [TimerOn],0
    37 0000011E C706[750E]0000      <1>     mov word [Seconds],0
    38 00000124 C706[770E]0000      <1>     mov word [TickAcc],0
    39 0000012A C706[7B0E]FFFF      <1>     mov word [HitCell],0FFFFh
    40 00000130 61                  <1>     popa
    41 00000131 C3                  <1>     ret
    42                              <1> 
    43                              <1> GetRandom:
    44 00000132 52                  <1>     push dx
    45 00000133 A1[7D0E]            <1>     mov ax,[RndSeed]
    46 00000136 BA5562              <1>     mov dx,25173
    47 00000139 F7E2                <1>     mul dx
    48 0000013B 051936              <1>     add ax,13849
    49 0000013E A3[7D0E]            <1>     mov [RndSeed],ax
    50 00000141 5A                  <1>     pop dx
    51 00000142 C3                  <1>     ret
    52                              <1> 
    53                              <1> ; BH=row BL=col -> SI = index   (AX preserved)
    54                              <1> CellIndex:
    55 00000143 50                  <1>     push ax
    56 00000144 88F8                <1>     mov al,bh
    57 00000146 B409                <1>     mov ah,GRID_COLS
    58 00000148 F6E4                <1>     mul ah
    59 0000014A 00D8                <1>     add al,bl
    60 0000014C 30E4                <1>     xor ah,ah
    61 0000014E 89C6                <1>     mov si,ax
    62 00000150 58                  <1>     pop ax
    63 00000151 C3                  <1>     ret
    64                              <1> 
    65                              <1> ; Fill high nibble of every safe cell with its neighbour-mine count
    66                              <1> ComputeNumbers:
    67 00000152 60                  <1>     pusha
    68 00000153 31F6                <1>     xor si,si
    69 00000155 30ED                <1>     xor ch,ch
    70                              <1> .r:
    71 00000157 30C9                <1>     xor cl,cl
    72                              <1> .c:
    73 00000159 80A4[7F0E]0F        <1>     and byte [Board+si],0Fh
    74 0000015E F684[7F0E]01        <1>     test byte [Board+si],1
    75 00000163 750A                <1>     jnz .n
    76 00000165 E81800              <1>     call CountMines
    77 00000168 C0E004              <1>     shl al,4
    78 0000016B 0884[7F0E]          <1>     or [Board+si],al
    79                              <1> .n:
    80 0000016F 46                  <1>     inc si
    81 00000170 FEC1                <1>     inc cl
    82 00000172 80F909              <1>     cmp cl,GRID_COLS
    83 00000175 72E2                <1>     jb .c
    84 00000177 FEC5                <1>     inc ch
    85 00000179 80FD09              <1>     cmp ch,GRID_ROWS
    86 0000017C 72D9                <1>     jb .r
    87 0000017E 61                  <1>     popa
    88 0000017F C3                  <1>     ret
    89                              <1> 
    90                              <1> ; CH=row CL=col -> AL = mines around
    91                              <1> CountMines:
    92 00000180 53                  <1>     push bx
    93 00000181 52                  <1>     push dx
    94 00000182 56                  <1>     push si
    95 00000183 30D2                <1>     xor dl,dl
    96 00000185 88EF                <1>     mov bh,ch
    97 00000187 FECF                <1>     dec bh
    98                              <1> .lr:
    99 00000189 80FF00              <1>     cmp bh,0
   100 0000018C 7C29                <1>     jl .nr
   101 0000018E 80FF09              <1>     cmp bh,GRID_ROWS
   102 00000191 7D24                <1>     jge .nr
   103 00000193 88CB                <1>     mov bl,cl
   104 00000195 FECB                <1>     dec bl
   105                              <1> .lc:
   106 00000197 80FB00              <1>     cmp bl,0
   107 0000019A 7C11                <1>     jl .nc
   108 0000019C 80FB09              <1>     cmp bl,GRID_COLS
   109 0000019F 7D0C                <1>     jge .nc
   110 000001A1 E89FFF              <1>     call CellIndex
   111 000001A4 F684[7F0E]01        <1>     test byte [Board+si],1
   112 000001A9 7402                <1>     jz .nc
   113 000001AB FEC2                <1>     inc dl
   114                              <1> .nc:
   115 000001AD FEC3                <1>     inc bl
   116 000001AF 88C8                <1>     mov al,cl
   117 000001B1 FEC0                <1>     inc al
   118 000001B3 38C3                <1>     cmp bl,al
   119 000001B5 7EE0                <1>     jle .lc
   120                              <1> .nr:
   121 000001B7 FEC7                <1>     inc bh
   122 000001B9 88E8                <1>     mov al,ch
   123 000001BB FEC0                <1>     inc al
   124 000001BD 38C7                <1>     cmp bh,al
   125 000001BF 7EC8                <1>     jle .lr
   126 000001C1 88D0                <1>     mov al,dl
   127 000001C3 5E                  <1>     pop si
   128 000001C4 5A                  <1>     pop dx
   129 000001C5 5B                  <1>     pop bx
   130 000001C6 C3                  <1>     ret
   131                              <1> 
   132                              <1> ; First click must never be a mine: move it to the first free cell
   133                              <1> ; SI = clicked cell
   134                              <1> RelocateMine:
   135 000001C7 60                  <1>     pusha
   136 000001C8 31DB                <1>     xor bx,bx
   137                              <1> .find:
   138 000001CA F687[7F0E]01        <1>     test byte [Board+bx],1
   139 000001CF 7403                <1>     jz .found
   140 000001D1 43                  <1>     inc bx
   141 000001D2 EBF6                <1>     jmp .find
   142                              <1> .found:
   143 000001D4 808F[7F0E]01        <1>     or byte [Board+bx],1
   144 000001D9 80A4[7F0E]FE        <1>     and byte [Board+si],0FEh
   145 000001DE E871FF              <1>     call ComputeNumbers
   146 000001E1 61                  <1>     popa
   147 000001E2 C3                  <1>     ret
   148                              <1> 
   149                              <1> ; Flood fill.  BH=row BL=col
   150                              <1> RevealCell:
   151 000001E3 60                  <1>     pusha
   152 000001E4 E85CFF              <1>     call CellIndex
   153 000001E7 F684[7F0E]06        <1>     test byte [Board+si],6      ; opened or flagged
   154 000001EC 7546                <1>     jnz .done
   155 000001EE 808C[7F0E]02        <1>     or byte [Board+si],2
   156 000001F3 8A84[7F0E]          <1>     mov al,[Board+si]
   157 000001F7 24F0                <1>     and al,0F0h
   158 000001F9 7539                <1>     jnz .done                   ; has neighbour mines -> stop
   159 000001FB 88FE                <1>     mov dh,bh
   160 000001FD FECE                <1>     dec dh
   161                              <1> .rr:
   162 000001FF 80FE00              <1>     cmp dh,0
   163 00000202 7C26                <1>     jl .rn
   164 00000204 80FE09              <1>     cmp dh,GRID_ROWS
   165 00000207 7D21                <1>     jge .rn
   166 00000209 88DA                <1>     mov dl,bl
   167 0000020B FECA                <1>     dec dl
   168                              <1> .cc:
   169 0000020D 80FA00              <1>     cmp dl,0
   170 00000210 7C0E                <1>     jl .cn
   171 00000212 80FA09              <1>     cmp dl,GRID_COLS
   172 00000215 7D09                <1>     jge .cn
   173 00000217 53                  <1>     push bx
   174 00000218 88F7                <1>     mov bh,dh
   175 0000021A 88D3                <1>     mov bl,dl
   176 0000021C E8C4FF              <1>     call RevealCell
   177 0000021F 5B                  <1>     pop bx
   178                              <1> .cn:
   179 00000220 FEC2                <1>     inc dl
   180 00000222 88D8                <1>     mov al,bl
   181 00000224 FEC0                <1>     inc al
   182 00000226 38C2                <1>     cmp dl,al
   183 00000228 7EE3                <1>     jle .cc
   184                              <1> .rn:
   185 0000022A FEC6                <1>     inc dh
   186 0000022C 88F8                <1>     mov al,bh
   187 0000022E FEC0                <1>     inc al
   188 00000230 38C6                <1>     cmp dh,al
   189 00000232 7ECB                <1>     jle .rr
   190                              <1> .done:
