   236 00000288 E8F900              <1>     call StartSfx
   237                              <1> .out:
   238 0000028B 61                  <1>     popa
   239 0000028C C3                  <1>     ret
    32                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 0000028D 60                  <1>     pusha
     6 0000028E B400                <1>     mov ah,00h
     7 00000290 CD1A                <1>     int 1Ah
     8 00000292 89D0                <1>     mov ax,dx
     9 00000294 2B06[790E]          <1>     sub ax,[LastTick]
    10 00000298 743E                <1>     jz .done
    11 0000029A 8916[790E]          <1>     mov [LastTick],dx
    12 0000029E 50                  <1>     push ax
    13 0000029F E83800              <1>     call MusicStep              ; AX = ticks elapsed
    14 000002A2 58                  <1>     pop ax
    15 000002A3 803E[740E]00        <1>     cmp byte [TimerOn],0
    16 000002A8 742E                <1>     je .done
    17 000002AA BB0500              <1>     mov bx,5
    18 000002AD F7E3                <1>     mul bx
    19 000002AF 0106[770E]          <1>     add [TickAcc],ax
    20 000002B3 30DB                <1>     xor bl,bl
    21                              <1> .sec:
    22 000002B5 833E[770E]5B        <1>     cmp word [TickAcc],91
    23 000002BA 7215                <1>     jb .chk
    24 000002BC 832E[770E]5B        <1>     sub word [TickAcc],91
    25 000002C1 813E[750E]E703      <1>     cmp word [Seconds],999
    26 000002C7 73EC                <1>     jae .sec
    27 000002C9 FF06[750E]          <1>     inc word [Seconds]
    28 000002CD B301                <1>     mov bl,1
    29 000002CF EBE4                <1>     jmp .sec
    30                              <1> .chk:
    31 000002D1 08DB                <1>     or bl,bl
