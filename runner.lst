   211                              <1> CheckWin:
   212 00000252 60                  <1>     pusha
   213 00000253 31F6                <1>     xor si,si
   214                              <1> .l:
   215 00000255 8A84[7F0E]          <1>     mov al,[Board+si]
   216 00000259 A801                <1>     test al,1
   217 0000025B 7504                <1>     jnz .n
   218 0000025D A802                <1>     test al,2
   219 0000025F 742A                <1>     jz .out                     ; a safe tile is still closed
   220                              <1> .n:
   221 00000261 46                  <1>     inc si
   222 00000262 83FE51              <1>     cmp si,CELLS
   223 00000265 72EE                <1>     jb .l
