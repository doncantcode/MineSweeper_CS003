    33                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 000002DA 60                  <1>     pusha
    10 000002DB 803E[490E]00        <1>     cmp byte [SfxOn],0
    11 000002E0 741D                <1>     je .music
    12 000002E2 8B1E[4C0E]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 000002E6 39D8                <1>     cmp ax,bx
    14 000002E8 7205                <1>     jb .sfxhold
    15 000002EA E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 000002ED EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 000002EF 29C3                <1>     sub bx,ax
    19 000002F1 891E[4C0E]          <1>     mov [SfxLeft],bx
    20 000002F5 83FB01              <1>     cmp bx,1
    21 000002F8 774D                <1>     ja .done
    22 000002FA E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 000002FD EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 000002FF 803E[440E]00        <1>     cmp byte [MusicOn],0
    27 00000304 7441                <1>     je .done
    28 00000306 8B1E[450E]          <1>     mov bx,[NoteLeft]
    29 0000030A 39D8                <1>     cmp ax,bx
    30 0000030C 7310                <1>     jae .next                   ; current note finished
    31 0000030E 29C3                <1>     sub bx,ax
    32 00000310 891E[450E]          <1>     mov [NoteLeft],bx
    33 00000314 83FB01              <1>     cmp bx,1
    34 00000317 772E                <1>     ja .done
    35 00000319 E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 0000031C EB29                <1>     jmp .done
    37                              <1> .next:
    38 0000031E 8B36[470E]          <1>     mov si,[MusicPtr]
    39 00000322 8B1C                <1>     mov bx,[si]
    40 00000324 83FBFF              <1>     cmp bx,0FFFFh
    41 00000327 7505                <1>     jne .play
    42 00000329 BE[E00B]            <1>     mov si,SongTable            ; end of tune -> loop
    43 0000032C 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 0000032E 8B4402              <1>     mov ax,[si+2]
    46 00000331 A3[450E]            <1>     mov [NoteLeft],ax
    47 00000334 83C604              <1>     add si,4
    48 00000337 8936[470E]          <1>     mov [MusicPtr],si
    49 0000033B 09DB                <1>     or bx,bx
    50 0000033D 7405                <1>     jz .rest
    51 0000033F E87100              <1>     call SpeakerOn
    52 00000342 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00000344 E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 00000347 61                  <1>     popa
    57 00000348 C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 00000349 60                  <1>     pusha
    63 0000034A 8B36[4A0E]          <1>     mov si,[SfxPtr]
    64 0000034E 8B1C                <1>     mov bx,[si]
    65 00000350 83FBFF              <1>     cmp bx,0FFFFh
    66 00000353 741B                <1>     je .end
    67 00000355 8B4402              <1>     mov ax,[si+2]
    68 00000358 A3[4C0E]            <1>     mov [SfxLeft],ax
    69 0000035B 83C604              <1>     add si,4
    70 0000035E 8936[4A0E]          <1>     mov [SfxPtr],si
    71 00000362 09DB                <1>     or bx,bx
    72 00000364 7405                <1>     jz .rest
    73 00000366 E84A00              <1>     call SpeakerOn
    74 00000369 61                  <1>     popa
    75 0000036A C3                  <1>     ret
    76                              <1> .rest:
    77 0000036B E86200              <1>     call SpeakerOff
    78 0000036E 61                  <1>     popa
    79 0000036F C3                  <1>     ret
    80                              <1> .end:
    81 00000370 C606[490E]00        <1>     mov byte [SfxOn],0
    82 00000375 C706[450E]0000      <1>     mov word [NoteLeft],0
    83 0000037B BE[E00B]            <1>     mov si,SongTable
    84 0000037E 8936[470E]          <1>     mov [MusicPtr],si
    85 00000382 61                  <1>     popa
    86 00000383 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 00000384 53                  <1>     push bx
    91 00000385 56                  <1>     push si
    92 00000386 E84700              <1>     call SpeakerOff
    93 00000389 8936[4A0E]          <1>     mov [SfxPtr],si
    94 0000038D C606[490E]01        <1>     mov byte [SfxOn],1
    95 00000392 E8B4FF              <1>     call SfxAdvance
    96 00000395 5E                  <1>     pop si
    97 00000396 5B                  <1>     pop bx
    98 00000397 C3                  <1>     ret
    99                              <1> 
   100                              <1> ToggleMusic:
   101 00000398 8036[440E]01        <1>     xor byte [MusicOn],1
   102 0000039D C706[450E]0000      <1>     mov word [NoteLeft],0
   103 000003A3 803E[440E]00        <1>     cmp byte [MusicOn],0
   104 000003A8 7508                <1>     jne .r
   105 000003AA C606[490E]00        <1>     mov byte [SfxOn],0
   106 000003AF E81E00              <1>     call SpeakerOff
   107                              <1> .r:
   108 000003B2 C3                  <1>     ret
    34                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 000003B3 BA1200              <1>     mov dx,0012h
    10 000003B6 B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 000003B9 F7F3                <1>     div bx                      ; AX = PIT divisor
    12 000003BB 89C3                <1>     mov bx,ax
    13 000003BD B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 000003BF E643                <1>     out 43h,al
    15 000003C1 88D8                <1>     mov al,bl
    16 000003C3 E642                <1>     out 42h,al
    17 000003C5 88F8                <1>     mov al,bh
    18 000003C7 E642                <1>     out 42h,al
    19 000003C9 E461                <1>     in al,61h
    20 000003CB 0C03                <1>     or al,3                     ; gate + speaker on
    21 000003CD E661                <1>     out 61h,al
    22 000003CF C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 000003D0 E461                <1>     in al,61h
    26 000003D2 24FC                <1>     and al,0FCh
    27 000003D4 E661                <1>     out 61h,al
    28 000003D6 C3                  <1>     ret
    35                                  %include "src/input.asm"        ; mouse click handling
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Mouse click handling.  MouseX/MouseY = pixel, PrevMouse = buttons
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> HandleClick:
     5 000003D7 60                  <1>     pusha
     6                              <1> 
     7                              <1>     ; --- face button (new game) ---
     8 000003D8 A1[6D0E]            <1>     mov ax,[MouseX]
     9 000003DB 3D9500              <1>     cmp ax,149
    10 000003DE 7C21                <1>     jl .board
    11 000003E0 3DAB00              <1>     cmp ax,171
    12 000003E3 7D1C                <1>     jge .board
    13 000003E5 A1[6F0E]            <1>     mov ax,[MouseY]
    14 000003E8 83F80C              <1>     cmp ax,12
    15 000003EB 7C14                <1>     jl .board
    16 000003ED 83F822              <1>     cmp ax,34
    17 000003F0 7D0F                <1>     jge .board
    18 000003F2 F606[710E]01        <1>     test byte [PrevMouse],1
    19 000003F7 0F84B700            <1>     jz .out
    20 000003FB E88EFC              <1>     call DoRestart
    21 000003FE E9B100              <1>     jmp .out
    22                              <1> 
    23                              <1>     ; --- board ---
    24                              <1> .board:
    25 00000401 803E[720E]00        <1>     cmp byte [GameOver],0
    26 00000406 0F85A800            <1>     jne .out
    27                              <1> 
    28 0000040A A1[6D0E]            <1>     mov ax,[MouseX]
    29 0000040D 83E858              <1>     sub ax,START_X
    30 00000410 0F8C9E00            <1>     jl .out
    31 00000414 3D9000              <1>     cmp ax,GRID_COLS*16
    32 00000417 0F8D9700            <1>     jge .out
    33 0000041B C1E804              <1>     shr ax,4
    34 0000041E 88C2                <1>     mov dl,al                   ; column
    35 00000420 A1[6F0E]            <1>     mov ax,[MouseY]
    36 00000423 83E82D              <1>     sub ax,START_Y
    37 00000426 0F8C8800            <1>     jl .out
    38 0000042A 3D9000              <1>     cmp ax,GRID_ROWS*16
    39 0000042D 0F8D8100            <1>     jge .out
    40 00000431 C1E804              <1>     shr ax,4
    41 00000434 88C6                <1>     mov dh,al                   ; row
    42                              <1> 
    43 00000436 88F7                <1>     mov bh,dh
    44 00000438 88D3                <1>     mov bl,dl
    45 0000043A E806FD              <1>     call CellIndex              ; SI = cell index
    46                              <1> 
    47 0000043D F606[710E]01        <1>     test byte [PrevMouse],1
    48 00000442 7509                <1>     jnz .left
    49 00000444 F606[710E]02        <1>     test byte [PrevMouse],2
    50 00000449 7558                <1>     jnz .right
    51 0000044B EB65                <1>     jmp .out
    52                              <1> 
    53                              <1> .left:
    54 0000044D F684[7F0E]06        <1>     test byte [Board+si],6      ; flagged or already open
    55 00000452 755E                <1>     jnz .out
    56 00000454 803E[730E]00        <1>     cmp byte [Started],0
    57 00000459 751A                <1>     jne .go
    58 0000045B C606[730E]01        <1>     mov byte [Started],1        ; first click: start timer, be safe
    59 00000460 C606[740E]01        <1>     mov byte [TimerOn],1
    60 00000465 C706[770E]0000      <1>     mov word [TickAcc],0
    61 0000046B F684[7F0E]01        <1>     test byte [Board+si],1
    62 00000470 7403                <1>     jz .go
    63 00000472 E852FD              <1>     call RelocateMine
    64                              <1> .go:
    65 00000475 F684[7F0E]01        <1>     test byte [Board+si],1
    66 0000047A 750B                <1>     jnz .boom
    67 0000047C E864FD              <1>     call RevealCell
    68 0000047F E8D0FD              <1>     call CheckWin
    69 00000482 E86903              <1>     call Redraw
    70 00000485 EB2B                <1>     jmp .out
    71                              <1> .boom:
    72 00000487 C606[720E]01        <1>     mov byte [GameOver],1
    73 0000048C C606[740E]00        <1>     mov byte [TimerOn],0
    74 00000491 8936[7B0E]          <1>     mov [HitCell],si
    75 00000495 E89EFD              <1>     call RevealMines
    76 00000498 E85303              <1>     call Redraw
    77 0000049B BE[C00D]            <1>     mov si,SfxBoom
    78 0000049E E8E3FE              <1>     call StartSfx
    79 000004A1 EB0F                <1>     jmp .out
    80                              <1> 
    81                              <1> .right:
    82 000004A3 F684[7F0E]02        <1>     test byte [Board+si],2      ; can't flag an open tile
    83 000004A8 7508                <1>     jnz .out
    84 000004AA 80B4[7F0E]04        <1>     xor byte [Board+si],4       ; toggle flag
    85 000004AF E83C03              <1>     call Redraw
    86                              <1> 
    87                              <1> .out:
    88 000004B2 61                  <1>     popa
    89 000004B3 C3                  <1>     ret
