   192 00000235 C3                  <1>     ret
   193                              <1> 
   194                              <1> RevealMines:                    ; show all un-flagged mines
   195 00000236 60                  <1>     pusha
   196 00000237 31F6                <1>     xor si,si
   197                              <1> .l:
   198 00000239 8A84[7F0E]          <1>     mov al,[Board+si]
   199 0000023D A801                <1>     test al,1
   200 0000023F 7409                <1>     jz .n
   201 00000241 A804                <1>     test al,4
   202 00000243 7505                <1>     jnz .n
   203 00000245 808C[7F0E]02        <1>     or byte [Board+si],2
   204                              <1> .n:
