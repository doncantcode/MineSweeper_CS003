   229 00000278 7405                <1>     jz .fn
   230 0000027A 808C[7F0E]04        <1>     or byte [Board+si],4
   231                              <1> .fn:
   232 0000027F 46                  <1>     inc si
   233 00000280 83FE51              <1>     cmp si,CELLS
   234 00000283 72EE                <1>     jb .f
