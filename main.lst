   309 00000A3F 83FE01              <1>     cmp si,1
   310 00000A42 7EBB                <1>     jle .dyloop
   311 00000A44 61                  <1>     popa
   312 00000A45 C3                  <1>     ret
    37                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 00000A46 60                  <1>     pusha
     6 00000A47 B400                <1>     mov ah,00h
     7 00000A49 CD1A                <1>     int 1Ah
     8 00000A4B 89D0                <1>     mov ax,dx
     9 00000A4D 2B06[2717]          <1>     sub ax,[LastTick]
    10 00000A51 7479                <1>     jz .done
    11 00000A53 8916[2717]          <1>     mov [LastTick],dx
    12 00000A57 50                  <1>     push ax
    13 00000A58 E87300              <1>     call MusicStep              ; AX = ticks elapsed
    14 00000A5B 58                  <1>     pop ax
    15 00000A5C 803E[2217]00        <1>     cmp byte [TimerOn],0
    16 00000A61 7469                <1>     je .done
    17 00000A63 BB0500              <1>     mov bx,5
    18 00000A66 F7E3                <1>     mul bx
    19 00000A68 0106[2517]          <1>     add [TickAcc],ax
    20 00000A6C 30DB                <1>     xor bl,bl
    21                              <1> .sec:
    22 00000A6E 833E[2517]5B        <1>     cmp word [TickAcc],91
    23 00000A73 7250                <1>     jb .chk
    24 00000A75 832E[2517]5B        <1>     sub word [TickAcc],91
    25                              <1>     ; Rapid mode counts down instead of up
    26 00000A7A 803E[7E17]02        <1>     cmp byte [CurrentMode],2
    27 00000A7F 7410                <1>     je .rapid
    28                              <1> 
    29                              <1>     ; Normal timer for Vanilla / other modes
    30 00000A81 813E[2317]E703      <1>     cmp word [Seconds],999
    31 00000A87 73E5                <1>     jae .sec
    32 00000A89 FF06[2317]          <1>     inc word [Seconds]
    33 00000A8D B301                <1>     mov bl,1
    34 00000A8F EBDD                <1>     jmp .sec
    35                              <1> 
    36                              <1> .rapid:
    37 00000A91 833E[2317]00        <1>     cmp word [Seconds],0
    38 00000A96 740F                <1>     je .rapidTimeout
    39                              <1> 
    40 00000A98 FF0E[2317]          <1>     dec word [Seconds]
    41 00000A9C B301                <1>     mov bl,1
    42                              <1> 
    43 00000A9E 833E[2317]00        <1>     cmp word [Seconds],0
    44 00000AA3 7402                <1>     je .rapidTimeout
    45                              <1> 
    46 00000AA5 EBC7                <1>     jmp .sec
    47                              <1> 
