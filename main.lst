   247 0000087D BE[4714]            <1>     mov si,SfxWin               ; board cleared: victory fanfare
   248 00000880 E83401              <1>     call StartSfx
   249                              <1> .out:
   250 00000883 61                  <1>     popa
   251 00000884 C3                  <1>     ret
    37                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 00000885 60                  <1>     pusha
     6 00000886 B400                <1>     mov ah,00h
     7 00000888 CD1A                <1>     int 1Ah
     8 0000088A 89D0                <1>     mov ax,dx
     9 0000088C 2B06[AC14]          <1>     sub ax,[LastTick]
    10 00000890 7479                <1>     jz .done
    11 00000892 8916[AC14]          <1>     mov [LastTick],dx
    12 00000896 50                  <1>     push ax
    13 00000897 E87300              <1>     call MusicStep              ; AX = ticks elapsed
    14 0000089A 58                  <1>     pop ax
    15 0000089B 803E[A714]00        <1>     cmp byte [TimerOn],0
    16 000008A0 7469                <1>     je .done
    17 000008A2 BB0500              <1>     mov bx,5
    18 000008A5 F7E3                <1>     mul bx
    19 000008A7 0106[AA14]          <1>     add [TickAcc],ax
    20 000008AB 30DB                <1>     xor bl,bl
    21                              <1> .sec:
    22 000008AD 833E[AA14]5B        <1>     cmp word [TickAcc],91
    23 000008B2 7250                <1>     jb .chk
    24 000008B4 832E[AA14]5B        <1>     sub word [TickAcc],91
    25                              <1>     ; Rapid mode counts down instead of up
    26 000008B9 803E[0315]02        <1>     cmp byte [CurrentMode],2
    27 000008BE 7410                <1>     je .rapid
    28                              <1> 
    29                              <1>     ; Normal timer for Vanilla / other modes
    30 000008C0 813E[A814]E703      <1>     cmp word [Seconds],999
    31 000008C6 73E5                <1>     jae .sec
    32 000008C8 FF06[A814]          <1>     inc word [Seconds]
    33 000008CC B301                <1>     mov bl,1
    34 000008CE EBDD                <1>     jmp .sec
    35                              <1> 
    36                              <1> .rapid:
    37 000008D0 833E[A814]00        <1>     cmp word [Seconds],0
    38 000008D5 740F                <1>     je .rapidTimeout
    39                              <1> 
    40 000008D7 FF0E[A814]          <1>     dec word [Seconds]
    41 000008DB B301                <1>     mov bl,1
    42                              <1> 
    43 000008DD 833E[A814]00        <1>     cmp word [Seconds],0
    44 000008E2 7402                <1>     je .rapidTimeout
    45                              <1> 
    46 000008E4 EBC7                <1>     jmp .sec
    47                              <1> 
    48                              <1> .rapidTimeout:
    49 000008E6 C606[A514]01        <1>     mov byte [GameOver],1
    50 000008EB C606[A714]00        <1>     mov byte [TimerOn],0
    51 000008F0 C706[AE14]FFFF      <1>     mov word [HitCell],0FFFFh
    52                              <1> 
    53 000008F6 E835FF              <1>     call RevealMines
    54 000008F9 E82505              <1>     call Redraw
    55                              <1> 
    56 000008FC BE[F313]            <1>     mov si,SfxBoom
    57 000008FF E8B500              <1>     call StartSfx
    58                              <1> 
    59 00000902 EB07                <1>     jmp .done
    60                              <1> 
    61                              <1> .chk:
    62 00000904 08DB                <1>     or bl,bl
    63 00000906 7403                <1>     jz .done
    64 00000908 E82C05              <1>     call DrawTimer
    65                              <1> .done:
    66 0000090B 61                  <1>     popa
    67 0000090C C3                  <1>     ret
    38                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 0000090D 60                  <1>     pusha
    10 0000090E 803E[7C14]00        <1>     cmp byte [SfxOn],0
    11 00000913 741D                <1>     je .music
    12 00000915 8B1E[7F14]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00000919 39D8                <1>     cmp ax,bx
    14 0000091B 7205                <1>     jb .sfxhold
    15 0000091D E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 00000920 EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00000922 29C3                <1>     sub bx,ax
    19 00000924 891E[7F14]          <1>     mov [SfxLeft],bx
    20 00000928 83FB01              <1>     cmp bx,1
    21 0000092B 774D                <1>     ja .done
    22 0000092D E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 00000930 EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00000932 803E[7714]00        <1>     cmp byte [MusicOn],0
    27 00000937 7441                <1>     je .done
    28 00000939 8B1E[7814]          <1>     mov bx,[NoteLeft]
    29 0000093D 39D8                <1>     cmp ax,bx
    30 0000093F 7310                <1>     jae .next                   ; current note finished
    31 00000941 29C3                <1>     sub bx,ax
    32 00000943 891E[7814]          <1>     mov [NoteLeft],bx
    33 00000947 83FB01              <1>     cmp bx,1
    34 0000094A 772E                <1>     ja .done
    35 0000094C E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 0000094F EB29                <1>     jmp .done
    37                              <1> .next:
    38 00000951 8B36[7A14]          <1>     mov si,[MusicPtr]
    39 00000955 8B1C                <1>     mov bx,[si]
    40 00000957 83FBFF              <1>     cmp bx,0FFFFh
    41 0000095A 7505                <1>     jne .play
    42 0000095C BE[1312]            <1>     mov si,SongTable            ; end of tune -> loop
    43 0000095F 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00000961 8B4402              <1>     mov ax,[si+2]
    46 00000964 A3[7814]            <1>     mov [NoteLeft],ax
    47 00000967 83C604              <1>     add si,4
    48 0000096A 8936[7A14]          <1>     mov [MusicPtr],si
    49 0000096E 09DB                <1>     or bx,bx
    50 00000970 7405                <1>     jz .rest
    51 00000972 E87100              <1>     call SpeakerOn
    52 00000975 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00000977 E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 0000097A 61                  <1>     popa
    57 0000097B C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 0000097C 60                  <1>     pusha
    63 0000097D 8B36[7D14]          <1>     mov si,[SfxPtr]
    64 00000981 8B1C                <1>     mov bx,[si]
    65 00000983 83FBFF              <1>     cmp bx,0FFFFh
    66 00000986 741B                <1>     je .end
    67 00000988 8B4402              <1>     mov ax,[si+2]
    68 0000098B A3[7F14]            <1>     mov [SfxLeft],ax
    69 0000098E 83C604              <1>     add si,4
    70 00000991 8936[7D14]          <1>     mov [SfxPtr],si
    71 00000995 09DB                <1>     or bx,bx
    72 00000997 7405                <1>     jz .rest
    73 00000999 E84A00              <1>     call SpeakerOn
    74 0000099C 61                  <1>     popa
    75 0000099D C3                  <1>     ret
    76                              <1> .rest:
    77 0000099E E86200              <1>     call SpeakerOff
    78 000009A1 61                  <1>     popa
    79 000009A2 C3                  <1>     ret
    80                              <1> .end:
    81 000009A3 C606[7C14]00        <1>     mov byte [SfxOn],0
    82 000009A8 C706[7814]0000      <1>     mov word [NoteLeft],0
    83 000009AE BE[1312]            <1>     mov si,SongTable
    84 000009B1 8936[7A14]          <1>     mov [MusicPtr],si
    85 000009B5 61                  <1>     popa
    86 000009B6 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 000009B7 53                  <1>     push bx
    91 000009B8 56                  <1>     push si
    92 000009B9 E84700              <1>     call SpeakerOff
    93 000009BC 8936[7D14]          <1>     mov [SfxPtr],si
    94 000009C0 C606[7C14]01        <1>     mov byte [SfxOn],1
    95 000009C5 E8B4FF              <1>     call SfxAdvance
    96 000009C8 5E                  <1>     pop si
    97 000009C9 5B                  <1>     pop bx
    98 000009CA C3                  <1>     ret
    99                              <1> 
   100                              <1> ToggleMusic:
   101 000009CB 8036[7714]01        <1>     xor byte [MusicOn],1
   102 000009D0 C706[7814]0000      <1>     mov word [NoteLeft],0
   103 000009D6 803E[7714]00        <1>     cmp byte [MusicOn],0
   104 000009DB 7508                <1>     jne .r
   105 000009DD C606[7C14]00        <1>     mov byte [SfxOn],0
   106 000009E2 E81E00              <1>     call SpeakerOff
   107                              <1> .r:
   108 000009E5 C3                  <1>     ret
    39                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 000009E6 BA1200              <1>     mov dx,0012h
    10 000009E9 B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 000009EC F7F3                <1>     div bx                      ; AX = PIT divisor
    12 000009EE 89C3                <1>     mov bx,ax
    13 000009F0 B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 000009F2 E643                <1>     out 43h,al
    15 000009F4 88D8                <1>     mov al,bl
    16 000009F6 E642                <1>     out 42h,al
    17 000009F8 88F8                <1>     mov al,bh
    18 000009FA E642                <1>     out 42h,al
    19 000009FC E461                <1>     in al,61h
    20 000009FE 0C03                <1>     or al,3                     ; gate + speaker on
    21 00000A00 E661                <1>     out 61h,al
    22 00000A02 C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00000A03 E461                <1>     in al,61h
    26 00000A05 24FC                <1>     and al,0FCh
    27 00000A07 E661                <1>     out 61h,al
    28 00000A09 C3                  <1>     ret
    40                                  %include "src/input.asm"        ; mouse click handling
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Mouse click handling.  MouseX/MouseY = pixel, PrevMouse = buttons
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> HandleClick:
     5 00000A0A 60                  <1>     pusha
     6                              <1> 
     7                              <1>     ; --- face button (new game) ---
     8 00000A0B A1[A014]            <1>     mov ax,[MouseX]
     9 00000A0E 3D9500              <1>     cmp ax,149
    10 00000A11 7C21                <1>     jl .board
    11 00000A13 3DAB00              <1>     cmp ax,171
    12 00000A16 7D1C                <1>     jge .board
    13 00000A18 A1[A214]            <1>     mov ax,[MouseY]
    14 00000A1B 83F80C              <1>     cmp ax,12
    15 00000A1E 7C14                <1>     jl .board
    16 00000A20 83F822              <1>     cmp ax,34
    17 00000A23 7D0F                <1>     jge .board
    18 00000A25 F606[A414]01        <1>     test byte [PrevMouse],1
    19 00000A2A 0F84B700            <1>     jz .out
    20 00000A2E E861F6              <1>     call DoRestart
    21 00000A31 E9B100              <1>     jmp .out
    22                              <1> 
    23                              <1>     ; --- board ---
    24                              <1> .board:
    25 00000A34 803E[A514]00        <1>     cmp byte [GameOver],0
    26 00000A39 0F85A800            <1>     jne .out
    27                              <1> 
    28 00000A3D A1[A014]            <1>     mov ax,[MouseX]
    29 00000A40 83E858              <1>     sub ax,START_X
    30 00000A43 0F8C9E00            <1>     jl .out
    31 00000A47 3D9000              <1>     cmp ax,GRID_COLS*16
    32 00000A4A 0F8D9700            <1>     jge .out
    33 00000A4E C1E804              <1>     shr ax,4
    34 00000A51 88C2                <1>     mov dl,al                   ; column
    35 00000A53 A1[A214]            <1>     mov ax,[MouseY]
    36 00000A56 83E82D              <1>     sub ax,START_Y
    37 00000A59 0F8C8800            <1>     jl .out
    38 00000A5D 3D9000              <1>     cmp ax,GRID_ROWS*16
    39 00000A60 0F8D8100            <1>     jge .out
    40 00000A64 C1E804              <1>     shr ax,4
    41 00000A67 88C6                <1>     mov dh,al                   ; row
    42                              <1> 
    43 00000A69 88F7                <1>     mov bh,dh
    44 00000A6B 88D3                <1>     mov bl,dl
    45 00000A6D E8CBFC              <1>     call CellIndex              ; SI = cell index
    46                              <1> 
    47 00000A70 F606[A414]01        <1>     test byte [PrevMouse],1
    48 00000A75 7509                <1>     jnz .left
    49 00000A77 F606[A414]02        <1>     test byte [PrevMouse],2
    50 00000A7C 7558                <1>     jnz .right
    51 00000A7E EB65                <1>     jmp .out
    52                              <1> 
    53                              <1> .left:
    54 00000A80 F684[B214]06        <1>     test byte [Board+si],6      ; flagged or already open
    55 00000A85 755E                <1>     jnz .out
    56 00000A87 803E[A614]00        <1>     cmp byte [Started],0
    57 00000A8C 751A                <1>     jne .go
    58 00000A8E C606[A614]01        <1>     mov byte [Started],1        ; first click: start timer, be safe
    59 00000A93 C606[A714]01        <1>     mov byte [TimerOn],1
    60 00000A98 C706[AA14]0000      <1>     mov word [TickAcc],0
    61 00000A9E F684[B214]01        <1>     test byte [Board+si],1
    62 00000AA3 7403                <1>     jz .go
    63 00000AA5 E817FD              <1>     call RelocateMine
    64                              <1> .go:
    65 00000AA8 F684[B214]01        <1>     test byte [Board+si],1
    66 00000AAD 750B                <1>     jnz .boom
    67 00000AAF E829FD              <1>     call RevealCell
    68 00000AB2 E895FD              <1>     call CheckWin
    69 00000AB5 E86903              <1>     call Redraw
    70 00000AB8 EB2B                <1>     jmp .out
    71                              <1> .boom:
    72 00000ABA C606[A514]01        <1>     mov byte [GameOver],1
    73 00000ABF C606[A714]00        <1>     mov byte [TimerOn],0
    74 00000AC4 8936[AE14]          <1>     mov [HitCell],si
    75 00000AC8 E863FD              <1>     call RevealMines
    76 00000ACB E85303              <1>     call Redraw
    77 00000ACE BE[F313]            <1>     mov si,SfxBoom
    78 00000AD1 E8E3FE              <1>     call StartSfx
    79 00000AD4 EB0F                <1>     jmp .out
    80                              <1> 
    81                              <1> .right:
    82 00000AD6 F684[B214]02        <1>     test byte [Board+si],2      ; can't flag an open tile
    83 00000ADB 7508                <1>     jnz .out
    84 00000ADD 80B4[B214]04        <1>     xor byte [Board+si],4       ; toggle flag
    85 00000AE2 E83C03              <1>     call Redraw
    86                              <1> 
    87                              <1> .out:
    88 00000AE5 61                  <1>     popa
    89 00000AE6 C3                  <1>     ret
    41                                  %include "src/video.asm"        ; FillRect/bevel/sprite/glyph primitives
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Drawing primitives
