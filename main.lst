     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  B + click   : use a collected 3x3 bomb
    11                                  ;  M           : music on/off (PC speaker)
    12                                  ;
    13                                  ;  This file is only the include manifest.  The code lives in src/,
    14                                  ;  included below in the order the modules are laid out in the .COM
    15                                  ;  image, so keeping this list in order matters.
    16                                  ; ===================================================================
    17                                  bits 16
    18                                  org 100h
    19                                  
    20                                  GRID_COLS   equ 9
    21                                  GRID_ROWS   equ 9
    22                                  TOTAL_MINES equ 10
    23                                  CELLS       equ GRID_COLS*GRID_ROWS
    24                                  START_X     equ 88
    25                                  START_Y     equ 45
    26                                  
    27                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros + shared constants (prices, sizes)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros & Shared Constants
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> MAX_CELLS   equ 600
     5                              <1> SAVE_SIZE   equ 13              ; +1 byte: unlocked Endless level
     6                              <1> WIN_REWARD  equ 5
     7                              <1> ITEM_BIT    equ 8
     8                              <1> POTION_PRICE equ 10
     9                              <1> POTION_MAX  equ 99              ; per-potion carry limit (2-digit HUD fields)
    10                              <1> MAX_LEVEL   equ 10              ; Endless levels on the level select
    11                              <1> TANK_PRICE  equ 0               ; Tank is free (always owned)
    12                              <1> MAGE_PRICE  equ 10
    13                              <1> ART_PRICE   equ 10
    14                              <1> 
    15                              <1> %macro HIDEM 0
    16                              <1>     mov ax,2
    17                              <1>     int 33h
    18                              <1> %endmacro
    19                              <1> 
    20                              <1> %macro SHOWM 0
    21                              <1>     mov ax,1
    22                              <1>     int 33h
    23                              <1> %endmacro
    24                              <1> 
    25                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    26                              <1> %macro BEVEL 6
    27                              <1>     mov byte [BevFace],%6
    28                              <1>   %if %1
    29                              <1>     mov byte [BevTL],15
    30                              <1>     mov byte [BevBR],8
    31                              <1>   %else
    32                              <1>     mov byte [BevTL],8
    33                              <1>     mov byte [BevBR],15
    34                              <1>   %endif
    35                              <1>     mov ax,%2
    36                              <1>     mov bx,%3
    37                              <1>     mov cx,%4
    38                              <1>     mov dx,%5
    39                              <1>     call DrawBevel
    40                              <1> %endmacro
    41                              <1> 
    42                              <1> ; TXT row, col, colour, 'string'
    43                              <1> %macro TXT 4
    44                              <1>     jmp short %%skip
    45                              <1> %%str: db %4,0
    46                              <1> %%skip:
    47                              <1>     mov dh,%1
    48                              <1>     mov dl,%2
    49                              <1>     mov bl,%3
    50                              <1>     mov si,%%str
    51                              <1>     call PrintAt
    52                              <1> %endmacro
    28                                  
    29                                  ; --- code ----------------------------------------------------------
    30                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    31                                  ; and shop) -> VGA mode 13h -> game loop. ESC in game returns to the
    32                                  ; menu; leaving via menu option [5] is the only DOS exit.
    33                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 8926[4C65]          <1>     mov [StackTop],sp           ; restored by ExitGame (see below)
     6 00000004 FC                  <1>     cld
     7                              <1>     ; Check command tail for /t or -t (self-test mode)
     8 00000005 8A0E8000            <1>     mov cl, [80h]
     9 00000009 08C9                <1>     or cl, cl
    10 0000000B 7427                <1>     jz .normalBoot
    11 0000000D BE8100              <1>     mov si, 81h
    12                              <1> .chkCmd:
    13 00000010 AC                  <1>     lodsb
    14 00000011 3C2F                <1>     cmp al, '/'
    15 00000013 7404                <1>     je .chkSwitch
    16 00000015 3C2D                <1>     cmp al, '-'
    17 00000017 7508                <1>     jne .nextCh
    18                              <1> .chkSwitch:
    19 00000019 8A04                <1>     mov al, [si]
    20 0000001B 0C20                <1>     or al, 20h
    21 0000001D 3C74                <1>     cmp al, 't'
    22 0000001F 7406                <1>     je .doTest
    23                              <1> .nextCh:
    24 00000021 FEC9                <1>     dec cl
    25 00000023 75EB                <1>     jnz .chkCmd
    26 00000025 EB0D                <1>     jmp .normalBoot
    27                              <1> 
    28                              <1> .doTest:
    29 00000027 C606[4E65]01        <1>     mov byte [TestMode], 1
    30 0000002C E8FD02              <1>     call RunTestSuite
    31 0000002F B8004C              <1>     mov ax, 4C00h
    32 00000032 CD21                <1>     int 21h
    33                              <1> 
    34                              <1> .normalBoot:
    35                              <1> MenuEntry:                      ; ExitGame comes back here (stack reset)
    36 00000034 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
    37 00000037 CD10                <1>     int 10h
    38 00000039 E8F714              <1>     call HideCursor
    39 0000003C 803E[C864]00        <1>     cmp byte [ProgressLoaded],0
    40 00000041 7508                <1>     jne .progressReady
    41 00000043 E80B2B              <1>     call LoadProgress
    42 00000046 C606[C864]01        <1>     mov byte [ProgressLoaded],1
    43                              <1> .progressReady:
    44 0000004B E80A1B              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
    45 0000004E E8D038              <1>     call SpeakerOff             ; silence menu music before switching to game
    46 00000051 C706[F064]0000      <1>     mov word [MenuNoteLeft], 0
    47 00000057 C706[EE64][AD5C]    <1>     mov word [MenuMusicPtr], track3
    48 0000005D C706[F161]0000      <1>     mov word [NoteLeft], 0
    49 00000063 C706[F361][CD5A]    <1>     mov word [MusicPtr], SongTable
    50 00000069 C606[F561]00        <1>     mov byte [SfxOn], 0
    51 0000006E C606[E664]00        <1>     mov byte [MageScans], 0
    52 00000073 803E[E464]02        <1>     cmp byte [SelectedClass],2  ; grant the mage's session scan for this run
    53 00000078 7505                <1>     jne .noMageScan
    54 0000007A C606[E664]01        <1>     mov byte [MageScans],1
    55                              <1> .noMageScan:
    56 0000007F B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    57 00000082 CD10                <1>     int 10h
    58 00000084 E8152F              <1>     call SetPalette
    59                              <1> 
    60 00000087 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    61 00000089 CD33                <1>     int 33h
    62 0000008B B80700              <1>     mov ax,7                    ; X range 0..639
    63 0000008E 31C9                <1>     xor cx,cx
    64 00000090 BA7F02              <1>     mov dx,639
    65 00000093 CD33                <1>     int 33h
    66 00000095 B80800              <1>     mov ax,8                    ; Y range 0..199
    67 00000098 31C9                <1>     xor cx,cx
    68 0000009A BAC700              <1>     mov dx,199
    69 0000009D CD33                <1>     int 33h
    70                              <1> 
    71 0000009F E84830              <1>     call NewGame
    72 000000A2 803E[9D64]01        <1>     cmp byte [CurrentMode],1    ; Endless opens on the level select
    73 000000A7 7505                <1>     jne .drawBoard
    74 000000A9 E8773B              <1>     call GoLevelSelect
    75 000000AC EB06                <1>     jmp .boardShown
    76                              <1> .drawBoard:
    77 000000AE E8413F              <1>     call DrawStatic
    78 000000B1 E88242              <1>     call Redraw
    79                              <1> .boardShown:
    80                              <1>     SHOWM
    21 000000B4 B80100              <2>  mov ax,1
    22 000000B7 CD33                <2>  int 33h
    81                              <1> 
    82                              <1> GameLoop:
    83 000000B9 E82D36              <1>     call UpdateTimer
    84                              <1> 
    85 000000BC B401                <1>     mov ah,01h                  ; key waiting?
    86 000000BE CD16                <1>     int 16h
    87 000000C0 752B                <1>     jnz KeyPressed
    88                              <1> 
    89 000000C2 B80300              <1>     mov ax,0003h                ; poll mouse
    90 000000C5 CD33                <1>     int 33h
    91 000000C7 80E303              <1>     and bl,3
    92 000000CA 741A                <1>     jz .released
    93 000000CC 803E[1D62]00        <1>     cmp byte [PrevMouse],0
    94 000000D1 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    95 000000D3 881E[1D62]          <1>     mov [PrevMouse],bl
    96 000000D7 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    97 000000D9 890E[1962]          <1>     mov [MouseX],cx
    98 000000DD 8916[1B62]          <1>     mov [MouseY],dx
    99 000000E1 E84438              <1>     call HandleClick
   100 000000E4 EBD3                <1>     jmp GameLoop
   101                              <1> .released:
   102 000000E6 C606[1D62]00        <1>     mov byte [PrevMouse],0
   103 000000EB EBCC                <1>     jmp GameLoop
   104                              <1> 
   105                              <1> KeyPressed:
   106 000000ED B400                <1>     mov ah,00h
   107 000000EF CD16                <1>     int 16h
   108                              <1> 
   109                              <1>     ; --- Level select: arrows / Enter / digits / ESC ---
   110 000000F1 803E[A664]04        <1>     cmp byte [EndlessState],4
