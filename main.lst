    33                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 000003E4 60                  <1>     pusha
     6 000003E5 B400                <1>     mov ah,00h
     7 000003E7 CD1A                <1>     int 1Ah
     8 000003E9 89D0                <1>     mov ax,dx
     9 000003EB 2B06[0B10]          <1>     sub ax,[LastTick]
    10 000003EF 7479                <1>     jz .done
    11 000003F1 8916[0B10]          <1>     mov [LastTick],dx
    12 000003F5 50                  <1>     push ax
    13 000003F6 E87300              <1>     call MusicStep              ; AX = ticks elapsed
    14 000003F9 58                  <1>     pop ax
    15 000003FA 803E[0610]00        <1>     cmp byte [TimerOn],0
    16 000003FF 7469                <1>     je .done
    17 00000401 BB0500              <1>     mov bx,5
    18 00000404 F7E3                <1>     mul bx
    19 00000406 0106[0910]          <1>     add [TickAcc],ax
    20 0000040A 30DB                <1>     xor bl,bl
    21                              <1> .sec:
    22 0000040C 833E[0910]5B        <1>     cmp word [TickAcc],91
    23 00000411 7250                <1>     jb .chk
    24 00000413 832E[0910]5B        <1>     sub word [TickAcc],91
    25                              <1>     ; Rapid mode counts down instead of up
    26 00000418 803E[6210]02        <1>     cmp byte [CurrentMode],2
    27 0000041D 7410                <1>     je .rapid
    28                              <1> 
    29                              <1>     ; Normal timer for Vanilla / other modes
    30 0000041F 813E[0710]E703      <1>     cmp word [Seconds],999
    31 00000425 73E5                <1>     jae .sec
    32 00000427 FF06[0710]          <1>     inc word [Seconds]
    33 0000042B B301                <1>     mov bl,1
    34 0000042D EBDD                <1>     jmp .sec
    35                              <1> 
    36                              <1> .rapid:
    37 0000042F 833E[0710]00        <1>     cmp word [Seconds],0
    38 00000434 740F                <1>     je .rapidTimeout
    39                              <1> 
    40 00000436 FF0E[0710]          <1>     dec word [Seconds]
    41 0000043A B301                <1>     mov bl,1
    42                              <1> 
    43 0000043C 833E[0710]00        <1>     cmp word [Seconds],0
    44 00000441 7402                <1>     je .rapidTimeout
    45                              <1> 
    46 00000443 EBC7                <1>     jmp .sec
    47                              <1> 
