    38                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 00000ACE 60                  <1>     pusha
    10 00000ACF 803E[F716]00        <1>     cmp byte [SfxOn],0
    11 00000AD4 741D                <1>     je .music
    12 00000AD6 8B1E[FA16]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00000ADA 39D8                <1>     cmp ax,bx
    14 00000ADC 7205                <1>     jb .sfxhold
    15 00000ADE E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 00000AE1 EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00000AE3 29C3                <1>     sub bx,ax
    19 00000AE5 891E[FA16]          <1>     mov [SfxLeft],bx
    20 00000AE9 83FB01              <1>     cmp bx,1
    21 00000AEC 774D                <1>     ja .done
    22 00000AEE E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 00000AF1 EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00000AF3 803E[F216]00        <1>     cmp byte [MusicOn],0
    27 00000AF8 7441                <1>     je .done
    28 00000AFA 8B1E[F316]          <1>     mov bx,[NoteLeft]
    29 00000AFE 39D8                <1>     cmp ax,bx
    30 00000B00 7310                <1>     jae .next                   ; current note finished
    31 00000B02 29C3                <1>     sub bx,ax
    32 00000B04 891E[F316]          <1>     mov [NoteLeft],bx
    33 00000B08 83FB01              <1>     cmp bx,1
    34 00000B0B 772E                <1>     ja .done
    35 00000B0D E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 00000B10 EB29                <1>     jmp .done
    37                              <1> .next:
    38 00000B12 8B36[F516]          <1>     mov si,[MusicPtr]
    39 00000B16 8B1C                <1>     mov bx,[si]
    40 00000B18 83FBFF              <1>     cmp bx,0FFFFh
    41 00000B1B 7505                <1>     jne .play
    42 00000B1D BE[8E14]            <1>     mov si,SongTable            ; end of tune -> loop
    43 00000B20 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00000B22 8B4402              <1>     mov ax,[si+2]
    46 00000B25 A3[F316]            <1>     mov [NoteLeft],ax
    47 00000B28 83C604              <1>     add si,4
    48 00000B2B 8936[F516]          <1>     mov [MusicPtr],si
    49 00000B2F 09DB                <1>     or bx,bx
    50 00000B31 7405                <1>     jz .rest
    51 00000B33 E87100              <1>     call SpeakerOn
    52 00000B36 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00000B38 E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 00000B3B 61                  <1>     popa
    57 00000B3C C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 00000B3D 60                  <1>     pusha
    63 00000B3E 8B36[F816]          <1>     mov si,[SfxPtr]
    64 00000B42 8B1C                <1>     mov bx,[si]
    65 00000B44 83FBFF              <1>     cmp bx,0FFFFh
    66 00000B47 741B                <1>     je .end
    67 00000B49 8B4402              <1>     mov ax,[si+2]
    68 00000B4C A3[FA16]            <1>     mov [SfxLeft],ax
    69 00000B4F 83C604              <1>     add si,4
    70 00000B52 8936[F816]          <1>     mov [SfxPtr],si
    71 00000B56 09DB                <1>     or bx,bx
    72 00000B58 7405                <1>     jz .rest
    73 00000B5A E84A00              <1>     call SpeakerOn
    74 00000B5D 61                  <1>     popa
    75 00000B5E C3                  <1>     ret
    76                              <1> .rest:
    77 00000B5F E86200              <1>     call SpeakerOff
    78 00000B62 61                  <1>     popa
    79 00000B63 C3                  <1>     ret
    80                              <1> .end:
    81 00000B64 C606[F716]00        <1>     mov byte [SfxOn],0
    82 00000B69 C706[F316]0000      <1>     mov word [NoteLeft],0
    83 00000B6F BE[8E14]            <1>     mov si,SongTable
    84 00000B72 8936[F516]          <1>     mov [MusicPtr],si
    85 00000B76 61                  <1>     popa
    86 00000B77 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 00000B78 53                  <1>     push bx
    91 00000B79 56                  <1>     push si
    92 00000B7A E84700              <1>     call SpeakerOff
    93 00000B7D 8936[F816]          <1>     mov [SfxPtr],si
    94 00000B81 C606[F716]01        <1>     mov byte [SfxOn],1
    95 00000B86 E8B4FF              <1>     call SfxAdvance
    96 00000B89 5E                  <1>     pop si
    97 00000B8A 5B                  <1>     pop bx
    98 00000B8B C3                  <1>     ret
    99                              <1> 
   100                              <1> ToggleMusic:
   101 00000B8C 8036[F216]01        <1>     xor byte [MusicOn],1
   102 00000B91 C706[F316]0000      <1>     mov word [NoteLeft],0
   103 00000B97 803E[F216]00        <1>     cmp byte [MusicOn],0
   104 00000B9C 7508                <1>     jne .r
   105 00000B9E C606[F716]00        <1>     mov byte [SfxOn],0
   106 00000BA3 E81E00              <1>     call SpeakerOff
   107                              <1> .r:
   108 00000BA6 C3                  <1>     ret
    39                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 00000BA7 BA1200              <1>     mov dx,0012h
    10 00000BAA B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 00000BAD F7F3                <1>     div bx                      ; AX = PIT divisor
    12 00000BAF 89C3                <1>     mov bx,ax
    13 00000BB1 B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 00000BB3 E643                <1>     out 43h,al
    15 00000BB5 88D8                <1>     mov al,bl
    16 00000BB7 E642                <1>     out 42h,al
    17 00000BB9 88F8                <1>     mov al,bh
    18 00000BBB E642                <1>     out 42h,al
    19 00000BBD E461                <1>     in al,61h
    20 00000BBF 0C03                <1>     or al,3                     ; gate + speaker on
    21 00000BC1 E661                <1>     out 61h,al
    22 00000BC3 C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00000BC4 E461                <1>     in al,61h
    26 00000BC6 24FC                <1>     and al,0FCh
    27 00000BC8 E661                <1>     out 61h,al
    28 00000BCA C3                  <1>     ret
    40                                  %include "src/input.asm"        ; mouse click handling
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Mouse click handling.  MouseX/MouseY = pixel, PrevMouse = buttons
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> HandleClick:
     5 00000BCB 60                  <1>     pusha
     6                              <1> 
     7                              <1>     ; --- face button (new game) ---
     8 00000BCC A1[1B17]            <1>     mov ax,[MouseX]
     9 00000BCF 3D9500              <1>     cmp ax,149
    10 00000BD2 7C21                <1>     jl .board
    11 00000BD4 3DAB00              <1>     cmp ax,171
    12 00000BD7 7D1C                <1>     jge .board
    13 00000BD9 A1[1D17]            <1>     mov ax,[MouseY]
    14 00000BDC 83F80C              <1>     cmp ax,12
    15 00000BDF 7C14                <1>     jl .board
    16 00000BE1 83F822              <1>     cmp ax,34
    17 00000BE4 7D0F                <1>     jge .board
    18 00000BE6 F606[1F17]01        <1>     test byte [PrevMouse],1
    19 00000BEB 0F84F600            <1>     jz .out
    20 00000BEF E8B9F4              <1>     call DoRestart
    21 00000BF2 E9F000              <1>     jmp .out
    22                              <1> 
    23                              <1>     ; --- board ---
