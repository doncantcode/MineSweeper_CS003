    38                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 000016CE 60                  <1>     pusha
    10 000016CF 803E[B223]00        <1>     cmp byte [SfxOn],0
    11 000016D4 741D                <1>     je .music
    12 000016D6 8B1E[B523]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 000016DA 39D8                <1>     cmp ax,bx
    14 000016DC 7205                <1>     jb .sfxhold
    15 000016DE E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 000016E1 EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 000016E3 29C3                <1>     sub bx,ax
    19 000016E5 891E[B523]          <1>     mov [SfxLeft],bx
    20 000016E9 83FB01              <1>     cmp bx,1
    21 000016EC 774D                <1>     ja .done
    22 000016EE E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 000016F1 EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 000016F3 803E[AD23]00        <1>     cmp byte [MusicOn],0
    27 000016F8 7441                <1>     je .done
    28 000016FA 8B1E[AE23]          <1>     mov bx,[NoteLeft]
    29 000016FE 39D8                <1>     cmp ax,bx
    30 00001700 7310                <1>     jae .next                   ; current note finished
    31 00001702 29C3                <1>     sub bx,ax
    32 00001704 891E[AE23]          <1>     mov [NoteLeft],bx
    33 00001708 83FB01              <1>     cmp bx,1
    34 0000170B 772E                <1>     ja .done
    35 0000170D E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 00001710 EB29                <1>     jmp .done
    37                              <1> .next:
    38 00001712 8B36[B023]          <1>     mov si,[MusicPtr]
    39 00001716 8B1C                <1>     mov bx,[si]
    40 00001718 83FBFF              <1>     cmp bx,0FFFFh
    41 0000171B 7505                <1>     jne .play
    42 0000171D BE[4921]            <1>     mov si,SongTable            ; end of tune -> loop
    43 00001720 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00001722 8B4402              <1>     mov ax,[si+2]
    46 00001725 A3[AE23]            <1>     mov [NoteLeft],ax
    47 00001728 83C604              <1>     add si,4
    48 0000172B 8936[B023]          <1>     mov [MusicPtr],si
    49 0000172F 09DB                <1>     or bx,bx
    50 00001731 7405                <1>     jz .rest
    51 00001733 E87100              <1>     call SpeakerOn
    52 00001736 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00001738 E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 0000173B 61                  <1>     popa
    57 0000173C C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 0000173D 60                  <1>     pusha
    63 0000173E 8B36[B323]          <1>     mov si,[SfxPtr]
    64 00001742 8B1C                <1>     mov bx,[si]
    65 00001744 83FBFF              <1>     cmp bx,0FFFFh
    66 00001747 741B                <1>     je .end
    67 00001749 8B4402              <1>     mov ax,[si+2]
    68 0000174C A3[B523]            <1>     mov [SfxLeft],ax
    69 0000174F 83C604              <1>     add si,4
    70 00001752 8936[B323]          <1>     mov [SfxPtr],si
    71 00001756 09DB                <1>     or bx,bx
    72 00001758 7405                <1>     jz .rest
    73 0000175A E84A00              <1>     call SpeakerOn
    74 0000175D 61                  <1>     popa
    75 0000175E C3                  <1>     ret
    76                              <1> .rest:
    77 0000175F E86200              <1>     call SpeakerOff
    78 00001762 61                  <1>     popa
    79 00001763 C3                  <1>     ret
    80                              <1> .end:
    81 00001764 C606[B223]00        <1>     mov byte [SfxOn],0
    82 00001769 C706[AE23]0000      <1>     mov word [NoteLeft],0
    83 0000176F BE[4921]            <1>     mov si,SongTable
    84 00001772 8936[B023]          <1>     mov [MusicPtr],si
    85 00001776 61                  <1>     popa
    86 00001777 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 00001778 53                  <1>     push bx
    91 00001779 56                  <1>     push si
