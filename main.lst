   378                              <1> ; -------------------------------------------------------------------
   379                              <1> ; ScanArea: mage remote scan.  Marks (flags) every mine in the 3x3
   380                              <1> ; around DH:DL (row:col) purely in memory - never runs detonation
   381                              <1> ; logic.  Off-board neighbours are skipped, already-flagged mines
   382                              <1> ; stay flagged.
   383                              <1> ; -------------------------------------------------------------------
   384                              <1> ScanArea:
   385 00001AD4 60                  <1>     pusha
   386 00001AD5 88F0                <1>     mov al,dh
