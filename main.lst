    41                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 00003789 60                  <1>     pusha
    10 0000378A 803E[F561]00        <1>     cmp byte [SfxOn],0
    11 0000378F 741D                <1>     je .music
    12 00003791 8B1E[F861]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00003795 39D8                <1>     cmp ax,bx
    14 00003797 7205                <1>     jb .sfxhold
    15 00003799 E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 0000379C EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 0000379E 29C3                <1>     sub bx,ax
    19 000037A0 891E[F861]          <1>     mov [SfxLeft],bx
    20 000037A4 83FB01              <1>     cmp bx,1
    21 000037A7 774D                <1>     ja .done
    22 000037A9 E87501              <1>     call SpeakerOff             ; last tick of an effect note
    23 000037AC EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 000037AE 803E[F061]00        <1>     cmp byte [MusicOn],0
    27 000037B3 7441                <1>     je .done
    28 000037B5 8B1E[F161]          <1>     mov bx,[NoteLeft]
    29 000037B9 39D8                <1>     cmp ax,bx
    30 000037BB 7310                <1>     jae .next                   ; current note finished
    31 000037BD 29C3                <1>     sub bx,ax
    32 000037BF 891E[F161]          <1>     mov [NoteLeft],bx
    33 000037C3 83FB01              <1>     cmp bx,1
    34 000037C6 772E                <1>     ja .done
    35 000037C8 E85601              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 000037CB EB29                <1>     jmp .done
    37                              <1> .next:
    38 000037CD 8B36[F361]          <1>     mov si,[MusicPtr]
    39 000037D1 8B1C                <1>     mov bx,[si]
    40 000037D3 83FBFF              <1>     cmp bx,0FFFFh
    41 000037D6 7505                <1>     jne .play
    42 000037D8 BE[CD5A]            <1>     mov si,SongTable            ; end of tune -> loop
    43 000037DB 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 000037DD 8B4402              <1>     mov ax,[si+2]
    46 000037E0 A3[F161]            <1>     mov [NoteLeft],ax
    47 000037E3 83C604              <1>     add si,4
    48 000037E6 8936[F361]          <1>     mov [MusicPtr],si
    49 000037EA 09DB                <1>     or bx,bx
    50 000037EC 7405                <1>     jz .rest
    51 000037EE E81301              <1>     call SpeakerOn
    52 000037F1 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 000037F3 E82B01              <1>     call SpeakerOff
    55                              <1> .done:
    56 000037F6 61                  <1>     popa
    57 000037F7 C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 000037F8 60                  <1>     pusha
    63 000037F9 8B36[F661]          <1>     mov si,[SfxPtr]
    64 000037FD 8B1C                <1>     mov bx,[si]
    65 000037FF 83FBFF              <1>     cmp bx,0FFFFh
    66 00003802 741B                <1>     je .end
    67 00003804 8B4402              <1>     mov ax,[si+2]
    68 00003807 A3[F861]            <1>     mov [SfxLeft],ax
    69 0000380A 83C604              <1>     add si,4
    70 0000380D 8936[F661]          <1>     mov [SfxPtr],si
    71 00003811 09DB                <1>     or bx,bx
    72 00003813 7405                <1>     jz .rest
    73 00003815 E8EC00              <1>     call SpeakerOn
    74 00003818 61                  <1>     popa
    75 00003819 C3                  <1>     ret
