   788 000033F9 C706[2862][3C54]    <1>     mov word [EventPtr], EvRadar
   789 000033FF C606[6662]08        <1>     mov byte [KitMsgN], 8       ; "ROW SWEPT!"
   790 00003404 C606[6762]24        <1>     mov byte [KitMsgT], 36
