   264                              <1> ; -------------------------------------------------------------------
   265                              <1> ; ScanArea: mage remote scan.  Marks (flags) every mine in the 3x3
   266                              <1> ; around DH:DL (row:col) purely in memory - never runs detonation
   267                              <1> ; logic.  Off-board neighbours are skipped, already-flagged mines
   268                              <1> ; stay flagged.
   269                              <1> ; -------------------------------------------------------------------
   270                              <1> ScanArea:
   271 00000D9F 60                  <1>     pusha
   272 00000DA0 88F0                <1>     mov al,dh
   273 00000DA2 30E4                <1>     xor ah,ah
   274 00000DA4 89C5                <1>     mov bp,ax                   ; centre row
   275 00000DA6 88D0                <1>     mov al,dl
   276 00000DA8 30E4                <1>     xor ah,ah
   277 00000DAA 89C7                <1>     mov di,ax                   ; centre col
   278 00000DAC BEFFFF              <1>     mov si,-1                   ; dy
   279                              <1> .dyloop:
   280 00000DAF BAFFFF              <1>     mov dx,-1                   ; dx
   281                              <1> .dxloop:
   282 00000DB2 89E8                <1>     mov ax,bp
   283 00000DB4 01F0                <1>     add ax,si                   ; r = row + dy
   284 00000DB6 89FB                <1>     mov bx,di
   285 00000DB8 01D3                <1>     add bx,dx                   ; c = col + dx
   286 00000DBA 83F800              <1>     cmp ax,0
   287 00000DBD 7C29                <1>     jl .next
   288 00000DBF 83F809              <1>     cmp ax,GRID_ROWS
   289 00000DC2 7D24                <1>     jge .next
   290 00000DC4 83FB00              <1>     cmp bx,0
   291 00000DC7 7C1F                <1>     jl .next
   292 00000DC9 83FB09              <1>     cmp bx,GRID_COLS
   293 00000DCC 7D1A                <1>     jge .next
   294 00000DCE 89C1                <1>     mov cx,ax
   295 00000DD0 01C9                <1>     add cx,cx
   296 00000DD2 01C9                <1>     add cx,cx
   297 00000DD4 01C9                <1>     add cx,cx
   298 00000DD6 01C1                <1>     add cx,ax                   ; cx = 9r
   299 00000DD8 01D9                <1>     add cx,bx                   ; cx = 9r + c
   300 00000DDA 89CB                <1>     mov bx,cx
   301 00000DDC F687[AA1B]01        <1>     test byte [Board+bx],1      ; a mine?
   302 00000DE1 7405                <1>     jz .next
   303 00000DE3 808F[AA1B]04        <1>     or byte [Board+bx],4        ; mark it with the flag bit
   304                              <1> .next:
   305 00000DE8 42                  <1>     inc dx
   306 00000DE9 83FA01              <1>     cmp dx,1
   307 00000DEC 7EC4                <1>     jle .dxloop
   308 00000DEE 46                  <1>     inc si
   309 00000DEF 83FE01              <1>     cmp si,1
   310 00000DF2 7EBB                <1>     jle .dyloop
   311 00000DF4 61                  <1>     popa
   312 00000DF5 C3                  <1>     ret
    37                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 00000DF6 60                  <1>     pusha
     6 00000DF7 B400                <1>     mov ah,00h
     7 00000DF9 CD1A                <1>     int 1Ah
     8 00000DFB 89D0                <1>     mov ax,dx
     9 00000DFD 2B06[A41B]          <1>     sub ax,[LastTick]
    10 00000E01 0F848900            <1>     jz .done
    11 00000E05 8916[A41B]          <1>     mov [LastTick],dx
    12 00000E09 803E[011C]00        <1>     cmp byte [KitMsgT],0        ; transient kit message timing
    13 00000E0E 7409                <1>     je .noKitTick
    14 00000E10 FE0E[011C]          <1>     dec byte [KitMsgT]
    15 00000E14 7503                <1>     jnz .noKitTick
    16 00000E16 E81806              <1>     call Redraw                 ; expired: restore the normal status
    17                              <1> .noKitTick:
    18 00000E19 50                  <1>     push ax
    19 00000E1A E87300              <1>     call MusicStep              ; AX = ticks elapsed
    20 00000E1D 58                  <1>     pop ax
    21 00000E1E 803E[9F1B]00        <1>     cmp byte [TimerOn],0
    22 00000E23 7469                <1>     je .done
    23 00000E25 BB0500              <1>     mov bx,5
    24 00000E28 F7E3                <1>     mul bx
    25 00000E2A 0106[A21B]          <1>     add [TickAcc],ax
    26 00000E2E 30DB                <1>     xor bl,bl
    27                              <1> .sec:
    28 00000E30 833E[A21B]5B        <1>     cmp word [TickAcc],91
    29 00000E35 7250                <1>     jb .chk
    30 00000E37 832E[A21B]5B        <1>     sub word [TickAcc],91
    31                              <1>     ; Rapid mode counts down instead of up
    32 00000E3C 803E[FB1B]02        <1>     cmp byte [CurrentMode],2
    33 00000E41 7410                <1>     je .rapid
    34                              <1> 
    35                              <1>     ; Normal timer for Vanilla / other modes
    36 00000E43 813E[A01B]E703      <1>     cmp word [Seconds],999
    37 00000E49 73E5                <1>     jae .sec
    38 00000E4B FF06[A01B]          <1>     inc word [Seconds]
    39 00000E4F B301                <1>     mov bl,1
    40 00000E51 EBDD                <1>     jmp .sec
    41                              <1> 
    42                              <1> .rapid:
    43 00000E53 833E[A01B]00        <1>     cmp word [Seconds],0
    44 00000E58 740F                <1>     je .rapidTimeout
    45                              <1> 
    46 00000E5A FF0E[A01B]          <1>     dec word [Seconds]
    47 00000E5E B301                <1>     mov bl,1
    48                              <1> 
    49 00000E60 833E[A01B]00        <1>     cmp word [Seconds],0
    50 00000E65 7402                <1>     je .rapidTimeout
    51                              <1> 
    52 00000E67 EBC7                <1>     jmp .sec
    53                              <1> 
    54                              <1> .rapidTimeout:
    55 00000E69 C606[9D1B]01        <1>     mov byte [GameOver],1
    56 00000E6E C606[9F1B]00        <1>     mov byte [TimerOn],0
    57 00000E73 C706[A61B]FFFF      <1>     mov word [HitCell],0FFFFh
    58                              <1> 
    59 00000E79 E8CCFE              <1>     call RevealMines
    60 00000E7C E8B205              <1>     call Redraw
    61                              <1> 
    62 00000E7F BE[EB1A]            <1>     mov si,SfxBoom
    63 00000E82 E8B500              <1>     call StartSfx
    64                              <1> 
    65 00000E85 EB07                <1>     jmp .done
    66                              <1> 
    67                              <1> .chk:
