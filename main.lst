    63 00000B63 83C002              <1>     add ax,2
    64 00000B66 8B1E[8714]          <1>     mov bx,[BvY]
    65 00000B6A 83C302              <1>     add bx,2
    66 00000B6D 8B0E[8914]          <1>     mov cx,[BvW]
    67 00000B71 83E904              <1>     sub cx,4
    68 00000B74 8B16[8B14]          <1>     mov dx,[BvH]
