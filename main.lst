    67 0000046B C3                  <1>     ret
    34                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 0000046C 60                  <1>     pusha
    10 0000046D 803E[DB0F]00        <1>     cmp byte [SfxOn],0
    11 00000472 741D                <1>     je .music
    12 00000474 8B1E[DE0F]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00000478 39D8                <1>     cmp ax,bx
    14 0000047A 7205                <1>     jb .sfxhold
    15 0000047C E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 0000047F EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00000481 29C3                <1>     sub bx,ax
    19 00000483 891E[DE0F]          <1>     mov [SfxLeft],bx
    20 00000487 83FB01              <1>     cmp bx,1
    21 0000048A 774D                <1>     ja .done
    22 0000048C E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 0000048F EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00000491 803E[D60F]00        <1>     cmp byte [MusicOn],0
    27 00000496 7441                <1>     je .done
    28 00000498 8B1E[D70F]          <1>     mov bx,[NoteLeft]
    29 0000049C 39D8                <1>     cmp ax,bx
    30 0000049E 7310                <1>     jae .next                   ; current note finished
    31 000004A0 29C3                <1>     sub bx,ax
    32 000004A2 891E[D70F]          <1>     mov [NoteLeft],bx
    33 000004A6 83FB01              <1>     cmp bx,1
    34 000004A9 772E                <1>     ja .done
    35 000004AB E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 000004AE EB29                <1>     jmp .done
    37                              <1> .next:
    38 000004B0 8B36[D90F]          <1>     mov si,[MusicPtr]
    39 000004B4 8B1C                <1>     mov bx,[si]
    40 000004B6 83FBFF              <1>     cmp bx,0FFFFh
    41 000004B9 7505                <1>     jne .play
    42 000004BB BE[720D]            <1>     mov si,SongTable            ; end of tune -> loop
    43 000004BE 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 000004C0 8B4402              <1>     mov ax,[si+2]
    46 000004C3 A3[D70F]            <1>     mov [NoteLeft],ax
    47 000004C6 83C604              <1>     add si,4
    48 000004C9 8936[D90F]          <1>     mov [MusicPtr],si
    49 000004CD 09DB                <1>     or bx,bx
    50 000004CF 7405                <1>     jz .rest
    51 000004D1 E87100              <1>     call SpeakerOn
    52 000004D4 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 000004D6 E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 000004D9 61                  <1>     popa
    57 000004DA C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 000004DB 60                  <1>     pusha
    63 000004DC 8B36[DC0F]          <1>     mov si,[SfxPtr]
    64 000004E0 8B1C                <1>     mov bx,[si]
    65 000004E2 83FBFF              <1>     cmp bx,0FFFFh
    66 000004E5 741B                <1>     je .end
    67 000004E7 8B4402              <1>     mov ax,[si+2]
    68 000004EA A3[DE0F]            <1>     mov [SfxLeft],ax
    69 000004ED 83C604              <1>     add si,4
    70 000004F0 8936[DC0F]          <1>     mov [SfxPtr],si
    71 000004F4 09DB                <1>     or bx,bx
    72 000004F6 7405                <1>     jz .rest
    73 000004F8 E84A00              <1>     call SpeakerOn
    74 000004FB 61                  <1>     popa
    75 000004FC C3                  <1>     ret
    76                              <1> .rest:
    77 000004FD E86200              <1>     call SpeakerOff
    78 00000500 61                  <1>     popa
    79 00000501 C3                  <1>     ret
    80                              <1> .end:
    81 00000502 C606[DB0F]00        <1>     mov byte [SfxOn],0
    82 00000507 C706[D70F]0000      <1>     mov word [NoteLeft],0
    83 0000050D BE[720D]            <1>     mov si,SongTable
    84 00000510 8936[D90F]          <1>     mov [MusicPtr],si
    85 00000514 61                  <1>     popa
    86 00000515 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 00000516 53                  <1>     push bx
    91 00000517 56                  <1>     push si
    92 00000518 E84700              <1>     call SpeakerOff
    93 0000051B 8936[DC0F]          <1>     mov [SfxPtr],si
    94 0000051F C606[DB0F]01        <1>     mov byte [SfxOn],1
    95 00000524 E8B4FF              <1>     call SfxAdvance
    96 00000527 5E                  <1>     pop si
    97 00000528 5B                  <1>     pop bx
    98 00000529 C3                  <1>     ret
    99                              <1> 
   100                              <1> ToggleMusic:
   101 0000052A 8036[D60F]01        <1>     xor byte [MusicOn],1
   102 0000052F C706[D70F]0000      <1>     mov word [NoteLeft],0
   103 00000535 803E[D60F]00        <1>     cmp byte [MusicOn],0
   104 0000053A 7508                <1>     jne .r
   105 0000053C C606[DB0F]00        <1>     mov byte [SfxOn],0
   106 00000541 E81E00              <1>     call SpeakerOff
   107                              <1> .r:
   108 00000544 C3                  <1>     ret
    35                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 00000545 BA1200              <1>     mov dx,0012h
    10 00000548 B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 0000054B F7F3                <1>     div bx                      ; AX = PIT divisor
    12 0000054D 89C3                <1>     mov bx,ax
    13 0000054F B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 00000551 E643                <1>     out 43h,al
    15 00000553 88D8                <1>     mov al,bl
    16 00000555 E642                <1>     out 42h,al
    17 00000557 88F8                <1>     mov al,bh
    18 00000559 E642                <1>     out 42h,al
    19 0000055B E461                <1>     in al,61h
    20 0000055D 0C03                <1>     or al,3                     ; gate + speaker on
    21 0000055F E661                <1>     out 61h,al
    22 00000561 C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00000562 E461                <1>     in al,61h
    26 00000564 24FC                <1>     and al,0FCh
    27 00000566 E661                <1>     out 61h,al
    28 00000568 C3                  <1>     ret
    36                                  %include "src/input.asm"        ; mouse click handling
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Mouse click handling.  MouseX/MouseY = pixel, PrevMouse = buttons
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> HandleClick:
     5 00000569 60                  <1>     pusha
     6                              <1> 
     7                              <1>     ; --- face button (new game) ---
     8 0000056A A1[FF0F]            <1>     mov ax,[MouseX]
     9 0000056D 3D9500              <1>     cmp ax,149
    10 00000570 7C21                <1>     jl .board
    11 00000572 3DAB00              <1>     cmp ax,171
    12 00000575 7D1C                <1>     jge .board
    13 00000577 A1[0110]            <1>     mov ax,[MouseY]
    14 0000057A 83F80C              <1>     cmp ax,12
    15 0000057D 7C14                <1>     jl .board
    16 0000057F 83F822              <1>     cmp ax,34
    17 00000582 7D0F                <1>     jge .board
    18 00000584 F606[0310]01        <1>     test byte [PrevMouse],1
    19 00000589 0F84B700            <1>     jz .out
    20 0000058D E8FFFA              <1>     call DoRestart
    21 00000590 E9B100              <1>     jmp .out
    22                              <1> 
    23                              <1>     ; --- board ---
    24                              <1> .board:
    25 00000593 803E[0410]00        <1>     cmp byte [GameOver],0
    26 00000598 0F85A800            <1>     jne .out
    27                              <1> 
    28 0000059C A1[FF0F]            <1>     mov ax,[MouseX]
    29 0000059F 83E858              <1>     sub ax,START_X
    30 000005A2 0F8C9E00            <1>     jl .out
    31 000005A6 3D9000              <1>     cmp ax,GRID_COLS*16
    32 000005A9 0F8D9700            <1>     jge .out
    33 000005AD C1E804              <1>     shr ax,4
    34 000005B0 88C2                <1>     mov dl,al                   ; column
    35 000005B2 A1[0110]            <1>     mov ax,[MouseY]
    36 000005B5 83E82D              <1>     sub ax,START_Y
    37 000005B8 0F8C8800            <1>     jl .out
    38 000005BC 3D9000              <1>     cmp ax,GRID_ROWS*16
    39 000005BF 0F8D8100            <1>     jge .out
    40 000005C3 C1E804              <1>     shr ax,4
    41 000005C6 88C6                <1>     mov dh,al                   ; row
    42                              <1> 
    43 000005C8 88F7                <1>     mov bh,dh
    44 000005CA 88D3                <1>     mov bl,dl
    45 000005CC E8CBFC              <1>     call CellIndex              ; SI = cell index
    46                              <1> 
    47 000005CF F606[0310]01        <1>     test byte [PrevMouse],1
    48 000005D4 7509                <1>     jnz .left
    49 000005D6 F606[0310]02        <1>     test byte [PrevMouse],2
    50 000005DB 7558                <1>     jnz .right
    51 000005DD EB65                <1>     jmp .out
    52                              <1> 
