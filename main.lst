    74 0000352E C3                  <1>     ret
    41                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 0000352F 60                  <1>     pusha
    10 00003530 803E[715F]00        <1>     cmp byte [SfxOn],0
    11 00003535 741D                <1>     je .music
    12 00003537 8B1E[745F]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 0000353B 39D8                <1>     cmp ax,bx
    14 0000353D 7205                <1>     jb .sfxhold
    15 0000353F E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 00003542 EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00003544 29C3                <1>     sub bx,ax
    19 00003546 891E[745F]          <1>     mov [SfxLeft],bx
    20 0000354A 83FB01              <1>     cmp bx,1
    21 0000354D 774D                <1>     ja .done
    22 0000354F E87501              <1>     call SpeakerOff             ; last tick of an effect note
    23 00003552 EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00003554 803E[6C5F]00        <1>     cmp byte [MusicOn],0
    27 00003559 7441                <1>     je .done
    28 0000355B 8B1E[6D5F]          <1>     mov bx,[NoteLeft]
    29 0000355F 39D8                <1>     cmp ax,bx
    30 00003561 7310                <1>     jae .next                   ; current note finished
    31 00003563 29C3                <1>     sub bx,ax
    32 00003565 891E[6D5F]          <1>     mov [NoteLeft],bx
    33 00003569 83FB01              <1>     cmp bx,1
    34 0000356C 772E                <1>     ja .done
    35 0000356E E85601              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 00003571 EB29                <1>     jmp .done
    37                              <1> .next:
    38 00003573 8B36[6F5F]          <1>     mov si,[MusicPtr]
    39 00003577 8B1C                <1>     mov bx,[si]
    40 00003579 83FBFF              <1>     cmp bx,0FFFFh
    41 0000357C 7505                <1>     jne .play
    42 0000357E BE[4958]            <1>     mov si,SongTable            ; end of tune -> loop
    43 00003581 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00003583 8B4402              <1>     mov ax,[si+2]
    46 00003586 A3[6D5F]            <1>     mov [NoteLeft],ax
    47 00003589 83C604              <1>     add si,4
    48 0000358C 8936[6F5F]          <1>     mov [MusicPtr],si
    49 00003590 09DB                <1>     or bx,bx
    50 00003592 7405                <1>     jz .rest
    51 00003594 E81301              <1>     call SpeakerOn
    52 00003597 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00003599 E82B01              <1>     call SpeakerOff
    55                              <1> .done:
    56 0000359C 61                  <1>     popa
    57 0000359D C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 0000359E 60                  <1>     pusha
    63 0000359F 8B36[725F]          <1>     mov si,[SfxPtr]
    64 000035A3 8B1C                <1>     mov bx,[si]
    65 000035A5 83FBFF              <1>     cmp bx,0FFFFh
    66 000035A8 741B                <1>     je .end
    67 000035AA 8B4402              <1>     mov ax,[si+2]
    68 000035AD A3[745F]            <1>     mov [SfxLeft],ax
    69 000035B0 83C604              <1>     add si,4
    70 000035B3 8936[725F]          <1>     mov [SfxPtr],si
    71 000035B7 09DB                <1>     or bx,bx
    72 000035B9 7405                <1>     jz .rest
    73 000035BB E8EC00              <1>     call SpeakerOn
    74 000035BE 61                  <1>     popa
    75 000035BF C3                  <1>     ret
    76                              <1> .rest:
    77 000035C0 E80401              <1>     call SpeakerOff
    78 000035C3 61                  <1>     popa
    79 000035C4 C3                  <1>     ret
    80                              <1> .end:
    81 000035C5 C606[715F]00        <1>     mov byte [SfxOn],0
    82 000035CA C706[6D5F]0000      <1>     mov word [NoteLeft],0
    83 000035D0 BE[4958]            <1>     mov si,SongTable
    84 000035D3 8936[6F5F]          <1>     mov [MusicPtr],si
    85 000035D7 61                  <1>     popa
    86 000035D8 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 000035D9 53                  <1>     push bx
    91 000035DA 56                  <1>     push si
    92 000035DB E8E900              <1>     call SpeakerOff
    93 000035DE 8936[725F]          <1>     mov [SfxPtr],si
    94 000035E2 C606[715F]01        <1>     mov byte [SfxOn],1
    95 000035E7 E8B4FF              <1>     call SfxAdvance
    96 000035EA 5E                  <1>     pop si
    97 000035EB 5B                  <1>     pop bx
    98 000035EC C3                  <1>     ret
