   275 000015E4 88D0                <1>     mov al,dl
   276 000015E6 30E4                <1>     xor ah,ah
   277 000015E8 89C7                <1>     mov di,ax                   ; centre col
   278 000015EA BEFFFF              <1>     mov si,-1                   ; dy
   279                              <1> .dyloop:
   280 000015ED BAFFFF              <1>     mov dx,-1                   ; dx
   281                              <1> .dxloop:
   282 000015F0 89E8                <1>     mov ax,bp
   283 000015F2 01F0                <1>     add ax,si                   ; r = row + dy
   284 000015F4 89FB                <1>     mov bx,di
   285 000015F6 01D3                <1>     add bx,dx                   ; c = col + dx
   286 000015F8 83F800              <1>     cmp ax,0
   287 000015FB 7C29                <1>     jl .next
   288 000015FD 83F809              <1>     cmp ax,GRID_ROWS
   289 00001600 7D24                <1>     jge .next
   290 00001602 83FB00              <1>     cmp bx,0
   291 00001605 7C1F                <1>     jl .next
   292 00001607 83FB09              <1>     cmp bx,GRID_COLS
   293 0000160A 7D1A                <1>     jge .next
   294 0000160C 89C1                <1>     mov cx,ax
   295 0000160E 01C9                <1>     add cx,cx
   296 00001610 01C9                <1>     add cx,cx
   297 00001612 01C9                <1>     add cx,cx
   298 00001614 01C1                <1>     add cx,ax                   ; cx = 9r
   299 00001616 01D9                <1>     add cx,bx                   ; cx = 9r + c
   300 00001618 89CB                <1>     mov bx,cx
   301 0000161A F687[E823]01        <1>     test byte [Board+bx],1      ; a mine?
   302 0000161F 7405                <1>     jz .next
   303 00001621 808F[E823]04        <1>     or byte [Board+bx],4        ; mark it with the flag bit
   304                              <1> .next:
