    10 00000AEC C1E708              <1>     shl di,8
    11 00000AEF C1E306              <1>     shl bx,6
    12 00000AF2 01DF                <1>     add di,bx
    13 00000AF4 01C7                <1>     add di,ax                   ; DI = y*320 + x
    14 00000AF6 B800A0              <1>     mov ax,0A000h
    15 00000AF9 8EC0                <1>     mov es,ax
    16 00000AFB A0[8114]            <1>     mov al,[FillCol]
