    48 00002BC6 730A                <1>     jnc .closed
    49 00002BC8 C606[C764]01        <1>     mov byte [ProgressError],1
    50 00002BCD C606[CB64]00        <1>     mov byte [LoadValid],0
    51                              <1> .closed:
    52 00002BD2 803E[CB64]00        <1>     cmp byte [LoadValid],0
    53 00002BD7 0F84B700            <1>     je .done
    54                              <1> 
    55 00002BDB 803E[CC64]4D        <1>     cmp byte [SaveBuffer],'M'
    56 00002BE0 0F85A900            <1>     jne .invalid
    57 00002BE4 803E[CD64]53        <1>     cmp byte [SaveBuffer+1],'S'
