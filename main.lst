   171 0000019D B24B                <1>     mov dl,75
   172 0000019F E865FF              <1>     call PrintA
   173 000001A2 61                  <1>     popa
   174 000001A3 C3                  <1>     ret
   175                              <1> 
   176                              <1> ; PrintBanner: the 4 art rows starting at row DH, column 2
   177                              <1> PrintBanner:
