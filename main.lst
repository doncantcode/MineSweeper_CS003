    95 00002C5B A0[D864]            <1>     mov al,[SaveBuffer+12]      ; unlocked Endless level, 1..MAX_LEVEL+1
    96 00002C5E 08C0                <1>     or al,al
    97 00002C60 7409                <1>     jz .noUnlockByte
    98 00002C62 3C0B                <1>     cmp al,MAX_LEVEL+1
    99 00002C64 7602                <1>     jbe .unlockOk
   100 00002C66 B00B                <1>     mov al,MAX_LEVEL+1
   101                              <1> .unlockOk:
   102 00002C68 A2[A864]            <1>     mov [UnlockedLevel],al
   103                              <1> .noUnlockByte:
   104 00002C6B A0[D764]            <1>     mov al,[SaveBuffer+11]
   105 00002C6E 08C0                <1>     or al,al
   106 00002C70 7405                <1>     jz .defaults
   107 00002C72 A2[9E64]            <1>     mov [CurrentLevel],al
   108 00002C75 EB1B                <1>     jmp .done
   109                              <1> .defaults:
   110 00002C77 C606[C064]00        <1>     mov byte [PotionOracle],0
   111 00002C7C C606[C164]00        <1>     mov byte [PotionRadar],0
   112 00002C81 C606[C264]00        <1>     mov byte [PotionDetector],0
   113 00002C86 C606[9E64]01        <1>     mov byte [CurrentLevel],1
   114 00002C8B EB05                <1>     jmp .done
   115                              <1> .invalid:
