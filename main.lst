    24 00001B5D F7E3                <1>     mul bx
    25 00001B5F 0106[692A]          <1>     add [TickAcc],ax
    26 00001B63 30DB                <1>     xor bl,bl
    27                              <1> .sec:
    28 00001B65 833E[692A]5B        <1>     cmp word [TickAcc],91
    29 00001B6A 7250                <1>     jb .chk
    30 00001B6C 832E[692A]5B        <1>     sub word [TickAcc],91
    31                              <1>     ; Rapid mode counts down instead of up
    32 00001B71 803E[C32A]02        <1>     cmp byte [CurrentMode],2
    33 00001B76 7410                <1>     je .rapid
    34                              <1> 
    35                              <1>     ; Normal timer for Vanilla / other modes
    36 00001B78 813E[672A]E703      <1>     cmp word [Seconds],999
    37 00001B7E 73E5                <1>     jae .sec
    38 00001B80 FF06[672A]          <1>     inc word [Seconds]
    39 00001B84 B301                <1>     mov bl,1
    40 00001B86 EBDD                <1>     jmp .sec
    41                              <1> 
