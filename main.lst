    79 00001C5A C3                  <1>     ret
    80                              <1> .end:
    81 00001C5B C606[3B2A]00        <1>     mov byte [SfxOn],0
    82 00001C60 C706[372A]0000      <1>     mov word [NoteLeft],0
    83 00001C66 BE[D227]            <1>     mov si,SongTable
    84 00001C69 8936[392A]          <1>     mov [MusicPtr],si
    85 00001C6D 61                  <1>     popa
