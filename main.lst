     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    27                                  
    28                                  ; --- code ----------------------------------------------------------
    29                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    30                                  ; submenu) -> VGA mode 13h -> game loop.  ESC in game returns to the
    31                                  ; menu; leaving via menu option [3] is the only DOS exit.
    32                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 FC                  <1>     cld
     6 00000001 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
     7 00000004 CD10                <1>     int 10h
     8 00000006 E84201              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
     9 00000009 B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    10 0000000C CD10                <1>     int 10h
    11 0000000E E86B06              <1>     call SetPalette
    12                              <1> 
    13 00000011 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    14 00000013 CD33                <1>     int 33h
    15 00000015 B80700              <1>     mov ax,7                    ; X range 0..639
    16 00000018 31C9                <1>     xor cx,cx
    17 0000001A BA7F02              <1>     mov dx,639
    18 0000001D CD33                <1>     int 33h
    19 0000001F B80800              <1>     mov ax,8                    ; Y range 0..199
    20 00000022 31C9                <1>     xor cx,cx
    21 00000024 BAC700              <1>     mov dx,199
    22 00000027 CD33                <1>     int 33h
    23                              <1> 
    24 00000029 E89206              <1>     call NewGame
    25 0000002C E8140C              <1>     call DrawStatic
    26 0000002F E8EF0D              <1>     call Redraw
    27                              <1>     SHOWM
    10 00000032 B80100              <2>  mov ax,1
    11 00000035 CD33                <2>  int 33h
    28                              <1> 
    29                              <1> GameLoop:
    30 00000037 E84B08              <1>     call UpdateTimer
    31                              <1> 
    32 0000003A B401                <1>     mov ah,01h                  ; key waiting?
    33 0000003C CD16                <1>     int 16h
    34 0000003E 752B                <1>     jnz KeyPressed
    35                              <1> 
    36 00000040 B80300              <1>     mov ax,0003h                ; poll mouse
    37 00000043 CD33                <1>     int 33h
    38 00000045 80E303              <1>     and bl,3
    39 00000048 741A                <1>     jz .released
    40 0000004A 803E[A414]00        <1>     cmp byte [PrevMouse],0
    41 0000004F 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    42 00000051 881E[A414]          <1>     mov [PrevMouse],bl
    43 00000055 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    44 00000057 890E[A014]          <1>     mov [MouseX],cx
    45 0000005B 8916[A214]          <1>     mov [MouseY],dx
    46 0000005F E8A809              <1>     call HandleClick
    47 00000062 EBD3                <1>     jmp GameLoop
    48                              <1> .released:
    49 00000064 C606[A414]00        <1>     mov byte [PrevMouse],0
    50 00000069 EBCC                <1>     jmp GameLoop
    51                              <1> 
    52                              <1> KeyPressed:
    53 0000006B B400                <1>     mov ah,00h
    54 0000006D CD16                <1>     int 16h
    55 0000006F 3C1B                <1>     cmp al,27                   ; ESC
    56 00000071 7414                <1>     je ExitGame
    57 00000073 0C20                <1>     or al,20h                   ; to lower case
    58 00000075 3C6D                <1>     cmp al,'m'
    59 00000077 7409                <1>     je .mute
    60 00000079 3C72                <1>     cmp al,'r'
    61 0000007B 75BA                <1>     jne GameLoop
    62 0000007D E81200              <1>     call DoRestart
    63 00000080 EBB5                <1>     jmp GameLoop
    64                              <1> .mute:
    65 00000082 E84609              <1>     call ToggleMusic
    66 00000085 EBB0                <1>     jmp GameLoop
    67                              <1> 
    68                              <1> ExitGame:
    69 00000087 E87909              <1>     call SpeakerOff
    70 0000008A B80300              <1>     mov ax,0003h
    71 0000008D CD10                <1>     int 10h
    72 0000008F E96EFF              <1>     jmp start                   ; back to the main menu
    73                              <1> 
    74                              <1> DoRestart:
    75 00000092 E82906              <1>     call NewGame
    76 00000095 E8890D              <1>     call Redraw
    77 00000098 C3                  <1>     ret
    33                                  %include "src/menu.asm"         ; text-mode intro, main menu, mode submenu
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25): startup intro, main menu and the
     3                              <1> ; gamemode submenu.  Keyboard driven through int 21h ah=07h (silent
     4                              <1> ; read), so no Enter presses are needed.  Replaces the mode pick
     5                              <1> ; previously done by the graphics menu; [CurrentMode] values are
     6                              <1> ; unchanged (0 vanilla, 1 endless, 2 rapid).
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> 
     9                              <1> ; --- text helpers ---------------------------------------------------
    10                              <1> 
    11                              <1> ; ClearScr: fresh 80x25 screen, cursor home
    12                              <1> ClearScr:
    13 00000099 60                  <1>     pusha
    14 0000009A B80300              <1>     mov ax,0003h
    15 0000009D CD10                <1>     int 10h
    16 0000009F 61                  <1>     popa
    17 000000A0 C3                  <1>     ret
    18                              <1> 
    19                              <1> ; WaitKey: AL = keypress, no echo
    20                              <1> WaitKey:
    21 000000A1 B407                <1>     mov ah,07h
    22 000000A3 CD21                <1>     int 21h
    23 000000A5 C3                  <1>     ret
    24                              <1> 
    25                              <1> ; PrintStr: DS:SI -> $-terminated string via DOS
    26                              <1> PrintStr:
    27 000000A6 60                  <1>     pusha
    28 000000A7 89F2                <1>     mov dx,si
    29 000000A9 B409                <1>     mov ah,09h
    30 000000AB CD21                <1>     int 21h
    31 000000AD 61                  <1>     popa
    32 000000AE C3                  <1>     ret
    33                              <1> 
    34                              <1> ; PrintAttr: DS:SI -> 0-terminated string, BL = colour attribute
    35                              <1> PrintAttr:
    36 000000AF 60                  <1>     pusha
    37                              <1> .ch:
    38 000000B0 AC                  <1>     lodsb
    39 000000B1 08C0                <1>     or al,al
    40 000000B3 7422                <1>     jz .done
    41 000000B5 B409                <1>     mov ah,09h                    ; write char + attribute at cursor
    42 000000B7 B700                <1>     mov bh,0
    43 000000B9 B90100              <1>     mov cx,1
    44 000000BC CD10                <1>     int 10h
    45 000000BE 50                  <1>     push ax
    46 000000BF B403                <1>     mov ah,03h                    ; read cursor, then step one column
    47 000000C1 B700                <1>     mov bh,0
    48 000000C3 CD10                <1>     int 10h
    49 000000C5 FEC2                <1>     inc dl
    50 000000C7 80FA50              <1>     cmp dl,80
    51 000000CA 7204                <1>     jb .set
    52 000000CC 30D2                <1>     xor dl,dl
    53 000000CE FEC6                <1>     inc dh
    54                              <1> .set:
    55 000000D0 B402                <1>     mov ah,02h
    56 000000D2 CD10                <1>     int 10h
    57 000000D4 58                  <1>     pop ax
    58 000000D5 EBD9                <1>     jmp .ch
    59                              <1> .done:
    60 000000D7 61                  <1>     popa
    61 000000D8 C3                  <1>     ret
    62                              <1> 
    63                              <1> ; Crlf: teletype a line feed + carriage return
    64                              <1> Crlf:
    65 000000D9 60                  <1>     pusha
    66 000000DA B40E                <1>     mov ah,0Eh
    67 000000DC B00A                <1>     mov al,10
    68 000000DE CD10                <1>     int 10h
    69 000000E0 B00D                <1>     mov al,13
    70 000000E2 CD10                <1>     int 10h
    71 000000E4 61                  <1>     popa
    72 000000E5 C3                  <1>     ret
    73                              <1> 
    74                              <1> ; Delay350: ~0.35 s pause (int 15h wait, CX:DX usec)
    75                              <1> Delay350:
    76 000000E6 60                  <1>     pusha
    77 000000E7 B90500              <1>     mov cx,5
    78 000000EA BA3057              <1>     mov dx,5730h
    79 000000ED B486                <1>     mov ah,86h
    80 000000EF CD15                <1>     int 15h
    81 000000F1 61                  <1>     popa
    82 000000F2 C3                  <1>     ret
    83                              <1> 
    84                              <1> ; --- intro ----------------------------------------------------------
    85                              <1> 
    86                              <1> ShowIntro:
    87 000000F3 60                  <1>     pusha
    88 000000F4 B30E                <1>     mov bl,0Eh                    ; banner in bright yellow
    89 000000F6 BE[4002]            <1>     mov si,art_title1
    90 000000F9 E8B3FF              <1>     call PrintAttr
    91 000000FC E8DAFF              <1>     call Crlf
    92 000000FF BE[8B02]            <1>     mov si,art_title2
    93 00000102 E8AAFF              <1>     call PrintAttr
    94 00000105 E8D1FF              <1>     call Crlf
    95 00000108 BE[D702]            <1>     mov si,art_title3
    96 0000010B E8A1FF              <1>     call PrintAttr
    97 0000010E E8C8FF              <1>     call Crlf
    98 00000111 BE[2303]            <1>     mov si,art_title4
    99 00000114 E898FF              <1>     call PrintAttr
   100 00000117 E8BFFF              <1>     call Crlf
   101 0000011A E8BCFF              <1>     call Crlf
   102 0000011D B30B                <1>     mov bl,0Bh                    ; tactical status in cyan
   103 0000011F BE[6F03]            <1>     mov si,msg_scan
   104 00000122 E88AFF              <1>     call PrintAttr
   105 00000125 E8B1FF              <1>     call Crlf
   106 00000128 E8BBFF              <1>     call Delay350
   107 0000012B B30A                <1>     mov bl,0Ah                    ; mine report in green
   108 0000012D BE[8603]            <1>     mov si,msg_mines
   109 00000130 E87CFF              <1>     call PrintAttr
   110 00000133 E8A3FF              <1>     call Crlf
   111 00000136 E8ADFF              <1>     call Delay350
   112 00000139 B307                <1>     mov bl,07h
   113 0000013B BE[9803]            <1>     mov si,msg_anykey
   114 0000013E E86EFF              <1>     call PrintAttr
   115 00000141 E85DFF              <1>     call WaitKey
   116 00000144 C606[0415]01        <1>     mov byte [IntroShown],1
   117 00000149 61                  <1>     popa
   118 0000014A C3                  <1>     ret
   119                              <1> 
   120                              <1> ; --- main menu ------------------------------------------------------
   121                              <1> 
   122                              <1> MainMenu:
   123 0000014B 803E[0415]00        <1>     cmp byte [IntroShown],0       ; intro only on first boot
   124 00000150 7503                <1>     jne .loop
   125 00000152 E89EFF              <1>     call ShowIntro
   126                              <1> .loop:
   127 00000155 E841FF              <1>     call ClearScr
   128 00000158 B30E                <1>     mov bl,0Eh
   129 0000015A BE[B203]            <1>     mov si,txt_menuTitle
   130 0000015D E84FFF              <1>     call PrintAttr
   131 00000160 E876FF              <1>     call Crlf
   132 00000163 E873FF              <1>     call Crlf
   133 00000166 B30F                <1>     mov bl,0Fh
   134 00000168 BE[CA03]            <1>     mov si,opt_play
   135 0000016B E841FF              <1>     call PrintAttr
   136 0000016E E868FF              <1>     call Crlf
   137 00000171 BE[D403]            <1>     mov si,opt_credits
   138 00000174 E838FF              <1>     call PrintAttr
   139 00000177 E85FFF              <1>     call Crlf
   140 0000017A BE[E103]            <1>     mov si,opt_exit
   141 0000017D E82FFF              <1>     call PrintAttr
   142 00000180 E856FF              <1>     call Crlf
   143 00000183 E853FF              <1>     call Crlf
   144 00000186 B307                <1>     mov bl,07h
   145 00000188 BE[9504]            <1>     mov si,msg_pick
   146 0000018B E821FF              <1>     call PrintAttr
   147 0000018E E810FF              <1>     call WaitKey
   148 00000191 3C31                <1>     cmp al,'1'
   149 00000193 740A                <1>     je .play
   150 00000195 3C32                <1>     cmp al,'2'
   151 00000197 740E                <1>     je .credits
   152 00000199 3C33                <1>     cmp al,'3'
   153 0000019B 7412                <1>     je .exit
   154 0000019D EBB6                <1>     jmp .loop                     ; anything else: redraw
   155                              <1> .play:
   156 0000019F E81000              <1>     call ModeMenu                 ; AL=0 -> Back, no mode picked
   157 000001A2 08C0                <1>     or al,al
   158 000001A4 74AF                <1>     jz .loop
   159 000001A6 C3                  <1>     ret                           ; [CurrentMode] set: boot the game
   160                              <1> .credits:
   161 000001A7 E8EFFE              <1>     call ClearScr
   162 000001AA E84D03              <1>     call show_credits
   163 000001AD EBA6                <1>     jmp .loop
   164                              <1> .exit:
   165 000001AF E87000              <1>     call ExitToDos
   166                              <1> 
   167                              <1> ; --- gamemode submenu -----------------------------------------------
   168                              <1> 
   169                              <1> ; ModeMenu: returns AL=1 with [CurrentMode] set, or AL=0 for Back
   170                              <1> ModeMenu:
   171                              <1> .loop:
   172 000001B2 E8E4FE              <1>     call ClearScr
   173 000001B5 B30E                <1>     mov bl,0Eh
   174 000001B7 BE[F203]            <1>     mov si,txt_modeTitle
   175 000001BA E8F2FE              <1>     call PrintAttr
   176 000001BD E819FF              <1>     call Crlf
   177 000001C0 E816FF              <1>     call Crlf
   178 000001C3 B30F                <1>     mov bl,0Fh
   179 000001C5 BE[0204]            <1>     mov si,opt_vanilla
   180 000001C8 E8E4FE              <1>     call PrintAttr
   181 000001CB E80BFF              <1>     call Crlf
   182 000001CE BE[3004]            <1>     mov si,opt_endless
   183 000001D1 E8DBFE              <1>     call PrintAttr
   184 000001D4 E802FF              <1>     call Crlf
   185 000001D7 BE[5C04]            <1>     mov si,opt_rapid
   186 000001DA E8D2FE              <1>     call PrintAttr
   187 000001DD E8F9FE              <1>     call Crlf
   188 000001E0 BE[7E04]            <1>     mov si,opt_back
   189 000001E3 E8C9FE              <1>     call PrintAttr
   190 000001E6 E8F0FE              <1>     call Crlf
   191 000001E9 E8EDFE              <1>     call Crlf
   192 000001EC B307                <1>     mov bl,07h
   193 000001EE BE[9504]            <1>     mov si,msg_pick
   194 000001F1 E8BBFE              <1>     call PrintAttr
   195 000001F4 E8AAFE              <1>     call WaitKey
   196 000001F7 3C31                <1>     cmp al,'1'
   197 000001F9 740E                <1>     je .vanilla
   198 000001FB 3C32                <1>     cmp al,'2'
   199 000001FD 7411                <1>     je .endless
   200 000001FF 3C33                <1>     cmp al,'3'
   201 00000201 7414                <1>     je .rapid
   202 00000203 3C34                <1>     cmp al,'4'
   203 00000205 7418                <1>     je .back
   204 00000207 EBA9                <1>     jmp .loop
   205                              <1> .vanilla:
   206 00000209 C606[0315]00        <1>     mov byte [CurrentMode],0
   207 0000020E EB0C                <1>     jmp .picked
   208                              <1> .endless:
   209 00000210 C606[0315]01        <1>     mov byte [CurrentMode],1
   210 00000215 EB05                <1>     jmp .picked
   211                              <1> .rapid:
   212 00000217 C606[0315]02        <1>     mov byte [CurrentMode],2
   213                              <1> .picked:
   214 0000021C B001                <1>     mov al,1
   215 0000021E C3                  <1>     ret
   216                              <1> .back:
   217 0000021F 30C0                <1>     xor al,al
   218 00000221 C3                  <1>     ret
   219                              <1> 
   220                              <1> ; --- exit -----------------------------------------------------------
   221                              <1> 
   222                              <1> ExitToDos:
   223 00000222 E874FE              <1>     call ClearScr
   224 00000225 B30A                <1>     mov bl,0Ah
   225 00000227 BE[A904]            <1>     mov si,msg_exit1
   226 0000022A E882FE              <1>     call PrintAttr
   227 0000022D E8A9FE              <1>     call Crlf
   228 00000230 B307                <1>     mov bl,07h
   229 00000232 BE[D404]            <1>     mov si,msg_exit2
   230 00000235 E877FE              <1>     call PrintAttr
   231 00000238 E89EFE              <1>     call Crlf
   232 0000023B B8004C              <1>     mov ax,4C00h                  ; back to DOS
   233 0000023E CD21                <1>     int 21h
