   213 00000237 61                  <1>     popa
   214 00000238 C3                  <1>     ret
   215                              <1> 
   216                              <1> ; PrintAttr: write 0-terminated string at the cursor, BL = colour attr
   217                              <1> ; (legacy BIOS version, kept for other modules)
   218                              <1> PrintAttr:
   219 00000239 60                  <1>     pusha
   220                              <1> .ch:
   221 0000023A AC                  <1>     lodsb
   222 0000023B 08C0                <1>     or al,al
   223 0000023D 7422                <1>     jz .done
   224 0000023F B409                <1>     mov ah,09h
   225 00000241 B700                <1>     mov bh,0
   226 00000243 B90100              <1>     mov cx,1
   227 00000246 CD10                <1>     int 10h
   228 00000248 50                  <1>     push ax
   229 00000249 B403                <1>     mov ah,03h
   230 0000024B B700                <1>     mov bh,0
   231 0000024D CD10                <1>     int 10h
   232 0000024F FEC2                <1>     inc dl
   233 00000251 80FA50              <1>     cmp dl,80
   234 00000254 7204                <1>     jb .set
   235 00000256 30D2                <1>     xor dl,dl
   236 00000258 FEC6                <1>     inc dh
   237                              <1> .set:
   238 0000025A B402                <1>     mov ah,02h
   239 0000025C CD10                <1>     int 10h
   240 0000025E 58                  <1>     pop ax
   241 0000025F EBD9                <1>     jmp .ch
   242                              <1> .done:
   243 00000261 61                  <1>     popa
   244 00000262 C3                  <1>     ret
