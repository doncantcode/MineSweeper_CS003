     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    27                                  
    28                                  ; --- code ----------------------------------------------------------
    29                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    30                                  ; submenu) -> VGA mode 13h -> game loop.  ESC in game returns to the
    31                                  ; menu; leaving via menu option [3] is the only DOS exit.
    32                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 FC                  <1>     cld
     6 00000001 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
     7 00000004 CD10                <1>     int 10h
     8 00000006 E8B702              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
     9 00000009 B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    10 0000000C CD10                <1>     int 10h
    11 0000000E E8DA0A              <1>     call SetPalette
    12                              <1> 
    13 00000011 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    14 00000013 CD33                <1>     int 33h
    15 00000015 B80700              <1>     mov ax,7                    ; X range 0..639
    16 00000018 31C9                <1>     xor cx,cx
    17 0000001A BA7F02              <1>     mov dx,639
    18 0000001D CD33                <1>     int 33h
    19 0000001F B80800              <1>     mov ax,8                    ; Y range 0..199
    20 00000022 31C9                <1>     xor cx,cx
    21 00000024 BAC700              <1>     mov dx,199
    22 00000027 CD33                <1>     int 33h
    23                              <1> 
    24 00000029 E8010B              <1>     call NewGame
    25 0000002C E83111              <1>     call DrawStatic
    26 0000002F E87B13              <1>     call Redraw
    27                              <1>     SHOWM
    10 00000032 B80100              <2>  mov ax,1
    11 00000035 CD33                <2>  int 33h
    28                              <1> 
    29                              <1> GameLoop:
    30 00000037 E8290D              <1>     call UpdateTimer
    31                              <1> 
    32 0000003A B401                <1>     mov ah,01h                  ; key waiting?
    33 0000003C CD16                <1>     int 16h
    34 0000003E 752B                <1>     jnz KeyPressed
    35                              <1> 
    36 00000040 B80300              <1>     mov ax,0003h                ; poll mouse
    37 00000043 CD33                <1>     int 33h
    38 00000045 80E303              <1>     and bl,3
    39 00000048 741A                <1>     jz .released
    40 0000004A 803E[3C1A]00        <1>     cmp byte [PrevMouse],0
    41 0000004F 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    42 00000051 881E[3C1A]          <1>     mov [PrevMouse],bl
    43 00000055 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    44 00000057 890E[381A]          <1>     mov [MouseX],cx
    45 0000005B 8916[3A1A]          <1>     mov [MouseY],dx
    46 0000005F E8860E              <1>     call HandleClick
    47 00000062 EBD3                <1>     jmp GameLoop
    48                              <1> .released:
    49 00000064 C606[3C1A]00        <1>     mov byte [PrevMouse],0
    50 00000069 EBCC                <1>     jmp GameLoop
    51                              <1> 
    52                              <1> KeyPressed:
    53 0000006B B400                <1>     mov ah,00h
    54 0000006D CD16                <1>     int 16h
    55 0000006F 3C1B                <1>     cmp al,27                   ; ESC
    56 00000071 742D                <1>     je ExitGame
    57 00000073 0C20                <1>     or al,20h                   ; to lower case
    58 00000075 3C6D                <1>     cmp al,'m'
    59 00000077 7422                <1>     je .mute
    60 00000079 3C72                <1>     cmp al,'r'
    61 0000007B 7505                <1>     jne .chkScan
    62 0000007D E82B00              <1>     call DoRestart
    63 00000080 EBB5                <1>     jmp GameLoop
    64                              <1> .chkScan:
    65 00000082 3C73                <1>     cmp al,'s'                  ; mage: arm / disarm the 3x3 scanner
    66 00000084 75B1                <1>     jne GameLoop
    67 00000086 803E[9C1A]02        <1>     cmp byte [SelectedClass],2
    68 0000008B 75AA                <1>     jne GameLoop
    69 0000008D 803E[9E1A]00        <1>     cmp byte [MageScans],0
    70 00000092 74A3                <1>     je GameLoop                 ; no charges left
    71 00000094 8036[9F1A]01        <1>     xor byte [ScanArmed],1
    72 00000099 EB9C                <1>     jmp GameLoop
    73                              <1> .mute:
    74 0000009B E80B0E              <1>     call ToggleMusic
    75 0000009E EB97                <1>     jmp GameLoop
    76                              <1> 
    77                              <1> ExitGame:
    78 000000A0 E83E0E              <1>     call SpeakerOff
    79 000000A3 B80300              <1>     mov ax,0003h
    80 000000A6 CD10                <1>     int 10h
    81 000000A8 E955FF              <1>     jmp start                   ; back to the main menu
    82                              <1> 
    83                              <1> DoRestart:
    84 000000AB E87F0A              <1>     call NewGame
    85 000000AE E8FC12              <1>     call Redraw
    86 000000B1 C3                  <1>     ret
    33                                  %include "src/menu.asm"         ; text-mode intro, main menu, mode submenu
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25): startup intro, main menu, gamemode and
     3                              <1> ; class submenus.  Blue chrome with black stage bands and cyan
     4                              <1> ; pinstripes, boxed centred layout, silent input via int 21h ah=07h
     5                              <1> ; (no Enter needed).  [CurrentMode] values are unchanged
     6                              <1> ; (0 vanilla, 1 endless, 2 rapid).
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> 
     9                              <1> ; --- text helpers ---------------------------------------------------
    10                              <1> 
    11                              <1> ; ClearScr: fresh 80x25, cleared to blue/white chrome
    12                              <1> ClearScr:
    13 000000B2 60                  <1>     pusha
    14 000000B3 B80300              <1>     mov ax,0003h
    15 000000B6 CD10                <1>     int 10h
    16 000000B8 B80006              <1>     mov ax,0600h                ; scroll whole window = clear with attr
    17 000000BB B71F                <1>     mov bh,1Fh                  ; blue background, white text
    18 000000BD B90000              <1>     mov cx,0000h
    19 000000C0 BA4F18              <1>     mov dx,184Fh
    20 000000C3 CD10                <1>     int 10h
    21 000000C5 B402                <1>     mov ah,02h                  ; cursor home
    22 000000C7 B700                <1>     mov bh,0
    23 000000C9 31D2                <1>     xor dx,dx
    24 000000CB CD10                <1>     int 10h
    25 000000CD 61                  <1>     popa
    26 000000CE C3                  <1>     ret
    27                              <1> 
    28                              <1> ; Band: fill rows CH..DH with attribute BH (colour stage behind content)
    29                              <1> Band:
    30 000000CF 60                  <1>     pusha
    31 000000D0 B80006              <1>     mov ax,0600h
    32 000000D3 B100                <1>     mov cl,0
    33 000000D5 B24F                <1>     mov dl,79
    34 000000D7 CD10                <1>     int 10h
    35 000000D9 61                  <1>     popa
    36 000000DA C3                  <1>     ret
    37                              <1> 
    38                              <1> ; WaitKey: AL = keypress, no echo
    39                              <1> WaitKey:
    40 000000DB B407                <1>     mov ah,07h
    41 000000DD CD21                <1>     int 21h
    42 000000DF C3                  <1>     ret
    43                              <1> 
    44                              <1> ; PrintStr: DS:SI -> $-terminated string via DOS (legacy helper)
    45                              <1> PrintStr:
    46 000000E0 60                  <1>     pusha
    47 000000E1 89F2                <1>     mov dx,si
    48 000000E3 B409                <1>     mov ah,09h
    49 000000E5 CD21                <1>     int 21h
    50 000000E7 61                  <1>     popa
    51 000000E8 C3                  <1>     ret
    52                              <1> 
    53                              <1> ; PrintAttr: write 0-terminated string at the cursor, BL = colour attr
    54                              <1> PrintAttr:
    55 000000E9 60                  <1>     pusha
    56                              <1> .ch:
    57 000000EA AC                  <1>     lodsb
    58 000000EB 08C0                <1>     or al,al
    59 000000ED 7422                <1>     jz .done
    60 000000EF B409                <1>     mov ah,09h                  ; write char + attribute at cursor
    61 000000F1 B700                <1>     mov bh,0
    62 000000F3 B90100              <1>     mov cx,1
    63 000000F6 CD10                <1>     int 10h
    64 000000F8 50                  <1>     push ax
    65 000000F9 B403                <1>     mov ah,03h                  ; read cursor, then step one column
    66 000000FB B700                <1>     mov bh,0
    67 000000FD CD10                <1>     int 10h
    68 000000FF FEC2                <1>     inc dl
    69 00000101 80FA50              <1>     cmp dl,80
    70 00000104 7204                <1>     jb .set
    71 00000106 30D2                <1>     xor dl,dl
    72 00000108 FEC6                <1>     inc dh
    73                              <1> .set:
    74 0000010A B402                <1>     mov ah,02h
    75 0000010C CD10                <1>     int 10h
    76 0000010E 58                  <1>     pop ax
    77 0000010F EBD9                <1>     jmp .ch
    78                              <1> .done:
    79 00000111 61                  <1>     popa
    80 00000112 C3                  <1>     ret
    81                              <1> 
    82                              <1> ; PrintA: PrintAttr with explicit placement.  DH=row DL=col BL=attr
    83                              <1> PrintA:
    84 00000113 60                  <1>     pusha
    85 00000114 B402                <1>     mov ah,02h
    86 00000116 B700                <1>     mov bh,0
    87 00000118 CD10                <1>     int 10h
    88 0000011A E8CCFF              <1>     call PrintAttr
    89 0000011D 61                  <1>     popa
    90 0000011E C3                  <1>     ret
    91                              <1> 
    92                              <1> ; StrLen: SI -> 0-terminated string, CX = length
    93                              <1> StrLen:
    94 0000011F 56                  <1>     push si
    95 00000120 31C9                <1>     xor cx,cx
    96                              <1> .l:
    97 00000122 803C00              <1>     cmp byte [si],0
    98 00000125 7404                <1>     je .done
    99 00000127 46                  <1>     inc si
   100 00000128 41                  <1>     inc cx
   101 00000129 EBF7                <1>     jmp .l
   102                              <1> .done:
   103 0000012B 5E                  <1>     pop si
   104 0000012C C3                  <1>     ret
   105                              <1> 
   106                              <1> ; PrintCRow: centred on row DH, BL = attr, SI -> 0-terminated string
   107                              <1> PrintCRow:
   108 0000012D 60                  <1>     pusha
   109 0000012E E8EEFF              <1>     call StrLen
   110 00000131 B85000              <1>     mov ax,80
   111 00000134 29C8                <1>     sub ax,cx
   112 00000136 D1E8                <1>     shr ax,1
   113 00000138 88C2                <1>     mov dl,al
   114 0000013A B402                <1>     mov ah,02h
   115 0000013C B700                <1>     mov bh,0
   116 0000013E CD10                <1>     int 10h
   117 00000140 E8A6FF              <1>     call PrintAttr
   118 00000143 61                  <1>     popa
   119 00000144 C3                  <1>     ret
   120                              <1> 
   121                              <1> ; TypeStr: centred typewriter line on row DH (for the intro status)
   122                              <1> TypeStr:
   123 00000145 60                  <1>     pusha
   124 00000146 E8D6FF              <1>     call StrLen
   125 00000149 B85000              <1>     mov ax,80
