   205 0000022F C3                  <1>     ret
   206                              <1> 
   207                              <1> ; PrintStr: DS:SI -> $-terminated string via DOS (legacy helper)
   208                              <1> PrintStr:
   209 00000230 60                  <1>     pusha
   210 00000231 89F2                <1>     mov dx,si
   211 00000233 B409                <1>     mov ah,09h
