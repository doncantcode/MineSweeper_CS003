   128 00000150 88C2                <1>     mov dl,al
   129 00000152 B402                <1>     mov ah,02h
   130 00000154 B700                <1>     mov bh,0
   131 00000156 CD10                <1>     int 10h
   132                              <1> .ch:
   133 00000158 AC                  <1>     lodsb
   134 00000159 08C0                <1>     or al,al
   135 0000015B 7425                <1>     jz .done
   136 0000015D B409                <1>     mov ah,09h
   137 0000015F B700                <1>     mov bh,0
   138 00000161 B90100              <1>     mov cx,1
   139 00000164 CD10                <1>     int 10h
   140 00000166 50                  <1>     push ax
   141 00000167 B403                <1>     mov ah,03h                  ; advance the cursor one column
   142 00000169 B700                <1>     mov bh,0
   143 0000016B CD10                <1>     int 10h
   144 0000016D FEC2                <1>     inc dl
   145 0000016F B402                <1>     mov ah,02h
   146 00000171 CD10                <1>     int 10h
