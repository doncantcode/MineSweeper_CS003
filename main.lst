   215 00000CB4 C3                  <1>     ret
   216                              <1> 
   217                              <1> RevealMines:                    ; show all un-flagged mines
   218 00000CB5 60                  <1>     pusha
   219 00000CB6 31F6                <1>     xor si,si
   220                              <1> .l:
   221 00000CB8 8A84[4A1A]          <1>     mov al,[Board+si]
   222 00000CBC A801                <1>     test al,1
   223 00000CBE 7409                <1>     jz .n
   224 00000CC0 A804                <1>     test al,4
   225 00000CC2 7505                <1>     jnz .n
   226 00000CC4 808C[4A1A]02        <1>     or byte [Board+si],2
   227                              <1> .n:
   228 00000CC9 46                  <1>     inc si
   229 00000CCA 83FE51              <1>     cmp si,CELLS
   230 00000CCD 72E9                <1>     jb .l
   231 00000CCF 61                  <1>     popa
   232 00000CD0 C3                  <1>     ret
   233                              <1> 
   234                              <1> CheckWin:
   235 00000CD1 60                  <1>     pusha
   236 00000CD2 31F6                <1>     xor si,si
   237                              <1> .l:
   238 00000CD4 8A84[4A1A]          <1>     mov al,[Board+si]
   239 00000CD8 A801                <1>     test al,1
   240 00000CDA 7504                <1>     jnz .n
   241 00000CDC A802                <1>     test al,2
   242 00000CDE 742A                <1>     jz .out                     ; a safe tile is still closed
   243                              <1> .n:
   244 00000CE0 46                  <1>     inc si
   245 00000CE1 83FE51              <1>     cmp si,CELLS
   246 00000CE4 72EE                <1>     jb .l
   247 00000CE6 C606[3D1A]02        <1>     mov byte [GameOver],2       ; won
   248 00000CEB C606[3F1A]00        <1>     mov byte [TimerOn],0
   249 00000CF0 31F6                <1>     xor si,si
   250                              <1> .f:
   251 00000CF2 F684[4A1A]01        <1>     test byte [Board+si],1      ; flag every mine
   252 00000CF7 7405                <1>     jz .fn
   253 00000CF9 808C[4A1A]04        <1>     or byte [Board+si],4
   254                              <1> .fn:
   255 00000CFE 46                  <1>     inc si
   256 00000CFF 83FE51              <1>     cmp si,CELLS
   257 00000D02 72EE                <1>     jb .f
   258 00000D04 BE[DF19]            <1>     mov si,SfxWin               ; board cleared: victory fanfare
   259 00000D07 E88B01              <1>     call StartSfx
   260                              <1> .out:
   261 00000D0A 61                  <1>     popa
   262 00000D0B C3                  <1>     ret
   263                              <1> 
   264                              <1> ; -------------------------------------------------------------------
   265                              <1> ; ScanArea: mage remote scan.  Marks (flags) every mine in the 3x3
   266                              <1> ; around DH:DL (row:col) purely in memory - never runs detonation
   267                              <1> ; logic.  Off-board neighbours are skipped, already-flagged mines
   268                              <1> ; stay flagged.
   269                              <1> ; -------------------------------------------------------------------
   270                              <1> ScanArea:
   271 00000D0C 60                  <1>     pusha
   272 00000D0D 88F0                <1>     mov al,dh
   273 00000D0F 30E4                <1>     xor ah,ah
   274 00000D11 89C5                <1>     mov bp,ax                   ; centre row
   275 00000D13 88D0                <1>     mov al,dl
   276 00000D15 30E4                <1>     xor ah,ah
   277 00000D17 89C7                <1>     mov di,ax                   ; centre col
   278 00000D19 BEFFFF              <1>     mov si,-1                   ; dy
   279                              <1> .dyloop:
   280 00000D1C BAFFFF              <1>     mov dx,-1                   ; dx
   281                              <1> .dxloop:
   282 00000D1F 89E8                <1>     mov ax,bp
   283 00000D21 01F0                <1>     add ax,si                   ; r = row + dy
   284 00000D23 89FB                <1>     mov bx,di
   285 00000D25 01D3                <1>     add bx,dx                   ; c = col + dx
   286 00000D27 83F800              <1>     cmp ax,0
   287 00000D2A 7C29                <1>     jl .next
   288 00000D2C 83F809              <1>     cmp ax,GRID_ROWS
   289 00000D2F 7D24                <1>     jge .next
   290 00000D31 83FB00              <1>     cmp bx,0
   291 00000D34 7C1F                <1>     jl .next
   292 00000D36 83FB09              <1>     cmp bx,GRID_COLS
   293 00000D39 7D1A                <1>     jge .next
   294 00000D3B 89C1                <1>     mov cx,ax
   295 00000D3D 01C9                <1>     add cx,cx
   296 00000D3F 01C9                <1>     add cx,cx
   297 00000D41 01C9                <1>     add cx,cx
   298 00000D43 01C1                <1>     add cx,ax                   ; cx = 9r
   299 00000D45 01D9                <1>     add cx,bx                   ; cx = 9r + c
   300 00000D47 89CB                <1>     mov bx,cx
   301 00000D49 F687[4A1A]01        <1>     test byte [Board+bx],1      ; a mine?
   302 00000D4E 7405                <1>     jz .next
   303 00000D50 808F[4A1A]04        <1>     or byte [Board+bx],4        ; mark it with the flag bit
   304                              <1> .next:
   305 00000D55 42                  <1>     inc dx
   306 00000D56 83FA01              <1>     cmp dx,1
   307 00000D59 7EC4                <1>     jle .dxloop
   308 00000D5B 46                  <1>     inc si
   309 00000D5C 83FE01              <1>     cmp si,1
   310 00000D5F 7EBB                <1>     jle .dyloop
   311 00000D61 61                  <1>     popa
   312 00000D62 C3                  <1>     ret
    37                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 00000D63 60                  <1>     pusha
     6 00000D64 B400                <1>     mov ah,00h
     7 00000D66 CD1A                <1>     int 1Ah
     8 00000D68 89D0                <1>     mov ax,dx
     9 00000D6A 2B06[441A]          <1>     sub ax,[LastTick]
    10 00000D6E 7479                <1>     jz .done
    11 00000D70 8916[441A]          <1>     mov [LastTick],dx
    12 00000D74 50                  <1>     push ax
    13 00000D75 E87300              <1>     call MusicStep              ; AX = ticks elapsed
    14 00000D78 58                  <1>     pop ax
    15 00000D79 803E[3F1A]00        <1>     cmp byte [TimerOn],0
    16 00000D7E 7469                <1>     je .done
    17 00000D80 BB0500              <1>     mov bx,5
    18 00000D83 F7E3                <1>     mul bx
    19 00000D85 0106[421A]          <1>     add [TickAcc],ax
    20 00000D89 30DB                <1>     xor bl,bl
    21                              <1> .sec:
    22 00000D8B 833E[421A]5B        <1>     cmp word [TickAcc],91
    23 00000D90 7250                <1>     jb .chk
    24 00000D92 832E[421A]5B        <1>     sub word [TickAcc],91
    25                              <1>     ; Rapid mode counts down instead of up
    26 00000D97 803E[9B1A]02        <1>     cmp byte [CurrentMode],2
    27 00000D9C 7410                <1>     je .rapid
    28                              <1> 
    29                              <1>     ; Normal timer for Vanilla / other modes
    30 00000D9E 813E[401A]E703      <1>     cmp word [Seconds],999
    31 00000DA4 73E5                <1>     jae .sec
    32 00000DA6 FF06[401A]          <1>     inc word [Seconds]
    33 00000DAA B301                <1>     mov bl,1
    34 00000DAC EBDD                <1>     jmp .sec
    35                              <1> 
    36                              <1> .rapid:
    37 00000DAE 833E[401A]00        <1>     cmp word [Seconds],0
    38 00000DB3 740F                <1>     je .rapidTimeout
    39                              <1> 
    40 00000DB5 FF0E[401A]          <1>     dec word [Seconds]
    41 00000DB9 B301                <1>     mov bl,1
    42                              <1> 
    43 00000DBB 833E[401A]00        <1>     cmp word [Seconds],0
    44 00000DC0 7402                <1>     je .rapidTimeout
    45                              <1> 
    46 00000DC2 EBC7                <1>     jmp .sec
    47                              <1> 
    48                              <1> .rapidTimeout:
    49 00000DC4 C606[3D1A]01        <1>     mov byte [GameOver],1
    50 00000DC9 C606[3F1A]00        <1>     mov byte [TimerOn],0
    51 00000DCE C706[461A]FFFF      <1>     mov word [HitCell],0FFFFh
    52                              <1> 
    53 00000DD4 E8DEFE              <1>     call RevealMines
    54 00000DD7 E8D305              <1>     call Redraw
    55                              <1> 
    56 00000DDA BE[8B19]            <1>     mov si,SfxBoom
    57 00000DDD E8B500              <1>     call StartSfx
    58                              <1> 
    59 00000DE0 EB07                <1>     jmp .done
    60                              <1> 
    61                              <1> .chk:
    62 00000DE2 08DB                <1>     or bl,bl
    63 00000DE4 7403                <1>     jz .done
    64 00000DE6 E8DA05              <1>     call DrawTimer
    65                              <1> .done:
    66 00000DE9 61                  <1>     popa
    67 00000DEA C3                  <1>     ret
    38                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 00000DEB 60                  <1>     pusha
    10 00000DEC 803E[141A]00        <1>     cmp byte [SfxOn],0
    11 00000DF1 741D                <1>     je .music
    12 00000DF3 8B1E[171A]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00000DF7 39D8                <1>     cmp ax,bx
    14 00000DF9 7205                <1>     jb .sfxhold
    15 00000DFB E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 00000DFE EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00000E00 29C3                <1>     sub bx,ax
    19 00000E02 891E[171A]          <1>     mov [SfxLeft],bx
    20 00000E06 83FB01              <1>     cmp bx,1
    21 00000E09 774D                <1>     ja .done
    22 00000E0B E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 00000E0E EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00000E10 803E[0F1A]00        <1>     cmp byte [MusicOn],0
    27 00000E15 7441                <1>     je .done
    28 00000E17 8B1E[101A]          <1>     mov bx,[NoteLeft]
    29 00000E1B 39D8                <1>     cmp ax,bx
    30 00000E1D 7310                <1>     jae .next                   ; current note finished
    31 00000E1F 29C3                <1>     sub bx,ax
    32 00000E21 891E[101A]          <1>     mov [NoteLeft],bx
    33 00000E25 83FB01              <1>     cmp bx,1
    34 00000E28 772E                <1>     ja .done
    35 00000E2A E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 00000E2D EB29                <1>     jmp .done
    37                              <1> .next:
    38 00000E2F 8B36[121A]          <1>     mov si,[MusicPtr]
    39 00000E33 8B1C                <1>     mov bx,[si]
    40 00000E35 83FBFF              <1>     cmp bx,0FFFFh
    41 00000E38 7505                <1>     jne .play
    42 00000E3A BE[AB17]            <1>     mov si,SongTable            ; end of tune -> loop
    43 00000E3D 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00000E3F 8B4402              <1>     mov ax,[si+2]
    46 00000E42 A3[101A]            <1>     mov [NoteLeft],ax
    47 00000E45 83C604              <1>     add si,4
    48 00000E48 8936[121A]          <1>     mov [MusicPtr],si
    49 00000E4C 09DB                <1>     or bx,bx
    50 00000E4E 7405                <1>     jz .rest
    51 00000E50 E87100              <1>     call SpeakerOn
    52 00000E53 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00000E55 E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 00000E58 61                  <1>     popa
    57 00000E59 C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 00000E5A 60                  <1>     pusha
    63 00000E5B 8B36[151A]          <1>     mov si,[SfxPtr]
    64 00000E5F 8B1C                <1>     mov bx,[si]
    65 00000E61 83FBFF              <1>     cmp bx,0FFFFh
    66 00000E64 741B                <1>     je .end
    67 00000E66 8B4402              <1>     mov ax,[si+2]
    68 00000E69 A3[171A]            <1>     mov [SfxLeft],ax
    69 00000E6C 83C604              <1>     add si,4
    70 00000E6F 8936[151A]          <1>     mov [SfxPtr],si
    71 00000E73 09DB                <1>     or bx,bx
    72 00000E75 7405                <1>     jz .rest
    73 00000E77 E84A00              <1>     call SpeakerOn
    74 00000E7A 61                  <1>     popa
    75 00000E7B C3                  <1>     ret
    76                              <1> .rest:
    77 00000E7C E86200              <1>     call SpeakerOff
    78 00000E7F 61                  <1>     popa
    79 00000E80 C3                  <1>     ret
    80                              <1> .end:
    81 00000E81 C606[141A]00        <1>     mov byte [SfxOn],0
    82 00000E86 C706[101A]0000      <1>     mov word [NoteLeft],0
    83 00000E8C BE[AB17]            <1>     mov si,SongTable
    84 00000E8F 8936[121A]          <1>     mov [MusicPtr],si
    85 00000E93 61                  <1>     popa
    86 00000E94 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 00000E95 53                  <1>     push bx
    91 00000E96 56                  <1>     push si
    92 00000E97 E84700              <1>     call SpeakerOff
    93 00000E9A 8936[151A]          <1>     mov [SfxPtr],si
    94 00000E9E C606[141A]01        <1>     mov byte [SfxOn],1
    95 00000EA3 E8B4FF              <1>     call SfxAdvance
    96 00000EA6 5E                  <1>     pop si
    97 00000EA7 5B                  <1>     pop bx
    98 00000EA8 C3                  <1>     ret
    99                              <1> 
   100                              <1> ToggleMusic:
   101 00000EA9 8036[0F1A]01        <1>     xor byte [MusicOn],1
   102 00000EAE C706[101A]0000      <1>     mov word [NoteLeft],0
   103 00000EB4 803E[0F1A]00        <1>     cmp byte [MusicOn],0
   104 00000EB9 7508                <1>     jne .r
   105 00000EBB C606[141A]00        <1>     mov byte [SfxOn],0
   106 00000EC0 E81E00              <1>     call SpeakerOff
   107                              <1> .r:
   108 00000EC3 C3                  <1>     ret
    39                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 00000EC4 BA1200              <1>     mov dx,0012h
    10 00000EC7 B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 00000ECA F7F3                <1>     div bx                      ; AX = PIT divisor
    12 00000ECC 89C3                <1>     mov bx,ax
    13 00000ECE B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 00000ED0 E643                <1>     out 43h,al
    15 00000ED2 88D8                <1>     mov al,bl
    16 00000ED4 E642                <1>     out 42h,al
    17 00000ED6 88F8                <1>     mov al,bh
    18 00000ED8 E642                <1>     out 42h,al
    19 00000EDA E461                <1>     in al,61h
    20 00000EDC 0C03                <1>     or al,3                     ; gate + speaker on
    21 00000EDE E661                <1>     out 61h,al
    22 00000EE0 C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00000EE1 E461                <1>     in al,61h
    26 00000EE3 24FC                <1>     and al,0FCh
    27 00000EE5 E661                <1>     out 61h,al
    28 00000EE7 C3                  <1>     ret
    40                                  %include "src/input.asm"        ; mouse click handling
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Mouse click handling.  MouseX/MouseY = pixel, PrevMouse = buttons
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> HandleClick:
     5 00000EE8 60                  <1>     pusha
     6                              <1> 
     7                              <1>     ; --- face button (new game) ---
     8 00000EE9 A1[381A]            <1>     mov ax,[MouseX]
     9 00000EEC 3D9500              <1>     cmp ax,149
    10 00000EEF 7C21                <1>     jl .board
    11 00000EF1 3DAB00              <1>     cmp ax,171
    12 00000EF4 7D1C                <1>     jge .board
    13 00000EF6 A1[3A1A]            <1>     mov ax,[MouseY]
    14 00000EF9 83F80C              <1>     cmp ax,12
    15 00000EFC 7C14                <1>     jl .board
    16 00000EFE 83F822              <1>     cmp ax,34
    17 00000F01 7D0F                <1>     jge .board
    18 00000F03 F606[3C1A]01        <1>     test byte [PrevMouse],1
    19 00000F08 0F84F600            <1>     jz .out
    20 00000F0C E89CF1              <1>     call DoRestart
    21 00000F0F E9F000              <1>     jmp .out
    22                              <1> 
    23                              <1>     ; --- board ---
    24                              <1> .board:
    25 00000F12 803E[3D1A]00        <1>     cmp byte [GameOver],0
    26 00000F17 0F85E700            <1>     jne .out
    27                              <1> 
    28 00000F1B A1[381A]            <1>     mov ax,[MouseX]
    29 00000F1E 83E858              <1>     sub ax,START_X
    30 00000F21 0F8CDD00            <1>     jl .out
    31 00000F25 3D9000              <1>     cmp ax,GRID_COLS*16
    32 00000F28 0F8DD600            <1>     jge .out
    33 00000F2C C1E804              <1>     shr ax,4
    34 00000F2F 88C2                <1>     mov dl,al                   ; column
    35 00000F31 A1[3A1A]            <1>     mov ax,[MouseY]
    36 00000F34 83E82D              <1>     sub ax,START_Y
    37 00000F37 0F8CC700            <1>     jl .out
    38 00000F3B 3D9000              <1>     cmp ax,GRID_ROWS*16
    39 00000F3E 0F8DC000            <1>     jge .out
    40 00000F42 C1E804              <1>     shr ax,4
    41 00000F45 88C6                <1>     mov dh,al                   ; row
    42                              <1> 
    43 00000F47 88F7                <1>     mov bh,dh
    44 00000F49 88D3                <1>     mov bl,dl
    45 00000F4B E874FC              <1>     call CellIndex              ; SI = cell index
    46                              <1> 
    47 00000F4E F606[3C1A]01        <1>     test byte [PrevMouse],1
    48 00000F53 750C                <1>     jnz .left
    49 00000F55 F606[3C1A]02        <1>     test byte [PrevMouse],2
    50 00000F5A 0F859500            <1>     jnz .right
    51 00000F5E E9A100              <1>     jmp .out
    52                              <1> 
    53                              <1> .left:
    54 00000F61 803E[9F1A]00        <1>     cmp byte [ScanArmed],0      ; mage scanner armed?
    55 00000F66 7419                <1>     je .plainLeft
    56 00000F68 C606[9F1A]00        <1>     mov byte [ScanArmed],0
    57 00000F6D 803E[9E1A]00        <1>     cmp byte [MageScans],0
    58 00000F72 740D                <1>     je .plainLeft               ; no charges: click opens normally
    59 00000F74 FE0E[9E1A]          <1>     dec byte [MageScans]
    60 00000F78 E891FD              <1>     call ScanArea               ; DH:DL still hold the target cell
    61 00000F7B E82F04              <1>     call Redraw
    62 00000F7E E98100              <1>     jmp .out
    63                              <1> .plainLeft:
    64 00000F81 F684[4A1A]06        <1>     test byte [Board+si],6      ; flagged or already open
    65 00000F86 757A                <1>     jnz .out
    66 00000F88 803E[3E1A]00        <1>     cmp byte [Started],0
    67 00000F8D 751A                <1>     jne .go
    68 00000F8F C606[3E1A]01        <1>     mov byte [Started],1        ; first click: start timer, be safe
    69 00000F94 C606[3F1A]01        <1>     mov byte [TimerOn],1
    70 00000F99 C706[421A]0000      <1>     mov word [TickAcc],0
    71 00000F9F F684[4A1A]01        <1>     test byte [Board+si],1
    72 00000FA4 7403                <1>     jz .go
    73 00000FA6 E89DFC              <1>     call RelocateMine
    74                              <1> .go:
    75 00000FA9 F684[4A1A]01        <1>     test byte [Board+si],1
    76 00000FAE 750B                <1>     jnz .boom
    77 00000FB0 E8AFFC              <1>     call RevealCell
    78 00000FB3 E81BFD              <1>     call CheckWin
    79 00000FB6 E8F403              <1>     call Redraw
    80 00000FB9 EB47                <1>     jmp .out
    81                              <1> .boom:
    82 00000FBB 803E[9C1A]01        <1>     cmp byte [SelectedClass],1  ; tank with a shield left?
    83 00000FC0 7515                <1>     jne .realBoom
    84 00000FC2 803E[9D1A]00        <1>     cmp byte [TankShield],0
    85 00000FC7 740E                <1>     je .realBoom
    86 00000FC9 FE0E[9D1A]          <1>     dec byte [TankShield]       ; absorb the blast...
    87 00000FCD 808C[4A1A]04        <1>     or byte [Board+si],4        ; ...and pin the mine: flag stays down
