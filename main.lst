   761 000033BF 7328                <1>     jae .sweepDone
   762 000033C1 F684[A75F]01        <1>     test byte [Board+si], 1     ; mine?
   763 000033C6 740C                <1>     jz .safeCell
   764                              <1>     ; Mine -> set to TILE_FLAGGED
