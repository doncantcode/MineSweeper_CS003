   752 000033AC 8A16[0062]          <1>     mov dl, [CurCols]
   753 000033B0 F6E2                <1>     mul dl                      ; AX = row * width
   754 000033B2 89C6                <1>     mov si, ax
   755 000033B4 89C1                <1>     mov cx, ax
   756 000033B6 020E[0062]          <1>     add cl, [CurCols]
   757 000033BA 80D500              <1>     adc ch, 0                   ; CX = (row + 1) * width
   758                              <1> 
   759                              <1> .sweepLp:
