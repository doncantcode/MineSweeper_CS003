    54 00000458 E82505              <1>     call Redraw
    55                              <1> 
    56 0000045B BE[520F]            <1>     mov si,SfxBoom
    57 0000045E E8B500              <1>     call StartSfx
    58                              <1> 
    59 00000461 EB07                <1>     jmp .done
    60                              <1> 
