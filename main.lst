   797                              <1> ; -------------------------------------------------------------------
   798                              <1> ; Potion 3: Mine Detector / Auto-Flag (Cost: 10 Shrapnel)
   799                              <1> ; Finds and automatically flags the first unflagged mine on the board.
   800                              <1> ; Logic: Performs array scan for first instance of TILE_COVERED_MINE,
   801                              <1> ; converts state to TILE_FLAGGED, decrements remaining mine counter UI.
   802                              <1> ; -------------------------------------------------------------------
   803                              <1> UsePotionDetector:
   804 00003411 60                  <1>     pusha
   805 00003412 803E[9A5F]00        <1>     cmp byte [GameOver], 0
   806 00003417 7574                <1>     jne .done
   807 00003419 803E[3E62]00        <1>     cmp byte [PotionDetector], 0
   808 0000341E 7515                <1>     jne .haveDetector
   809 00003420 C606[6662]0A        <1>     mov byte [KitMsgN], 10      ; "NO POTIONS!"
   810 00003425 C606[6762]24        <1>     mov byte [KitMsgT], 36
   811 0000342A C706[2862][8254]    <1>     mov word [EventPtr], EvNoPotion
   812 00003430 E8A90C              <1>     call Redraw
   813 00003433 EB58                <1>     jmp .done
   814                              <1> .haveDetector:
   815 00003435 803E[1B62]00        <1>     cmp byte [MinesPlaced], 0
   816 0000343A 751D                <1>     jne .minesOk
   817 0000343C A0[0162]            <1>     mov al, [CurRows]
   818 0000343F D0E8                <1>     shr al, 1
   819 00003441 A2[1C62]            <1>     mov [FirstRow], al
   820 00003444 A0[0062]            <1>     mov al, [CurCols]
   821 00003447 D0E8                <1>     shr al, 1
   822 00003449 A2[1D62]            <1>     mov [FirstCol], al
   823 0000344C E8DFFA              <1>     call PlaceMinesLazy
   824 0000344F C606[9B5F]01        <1>     mov byte [Started], 1
   825 00003454 C606[9C5F]01        <1>     mov byte [TimerOn], 1
   826                              <1> .minesOk:
   827 00003459 31F6                <1>     xor si, si
   828                              <1> .scanMine:
   829 0000345B 8A84[A75F]          <1>     mov al, [Board+si]
   830 0000345F 2407                <1>     and al, 07h
   831 00003461 3C01                <1>     cmp al, 1                   ; covered mine?
   832 00003463 7409                <1>     je .foundMine
   833 00003465 46                  <1>     inc si
   834 00003466 3B36[0462]          <1>     cmp si, [CurCells]
   835 0000346A 72EF                <1>     jb .scanMine
   836 0000346C EB1F                <1>     jmp .done
   837                              <1> 
   838                              <1> .foundMine:
   839 0000346E FE0E[3E62]          <1>     dec byte [PotionDetector]
   840 00003472 808C[A75F]04        <1>     or byte [Board+si], 4       ; set to TILE_FLAGGED
   841 00003477 C706[2862][5E54]    <1>     mov word [EventPtr], EvDetector
   842 0000347D C606[6662]09        <1>     mov byte [KitMsgN], 9       ; "MINE FLAGGED!"
   843 00003482 C606[6762]24        <1>     mov byte [KitMsgT], 36
   844 00003487 E8EDFC              <1>     call CheckWin
   845 0000348A E84F0C              <1>     call Redraw
   846                              <1> .done:
   847 0000348D 61                  <1>     popa
   848 0000348E C3                  <1>     ret
    40                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 0000348F 60                  <1>     pusha
     6 00003490 B400                <1>     mov ah,00h
     7 00003492 CD1A                <1>     int 1Ah
     8 00003494 89D0                <1>     mov ax,dx
     9 00003496 2B06[A15F]          <1>     sub ax,[LastTick]
    10 0000349A 0F848F00            <1>     jz .done
    11 0000349E 8916[A15F]          <1>     mov [LastTick],dx
    12 000034A2 803E[6762]00        <1>     cmp byte [KitMsgT],0        ; transient kit message timing
    13 000034A7 7409                <1>     je .noKitTick
    14 000034A9 FE0E[6762]          <1>     dec byte [KitMsgT]
    15 000034AD 7503                <1>     jnz .noKitTick
    16 000034AF E82A0C              <1>     call Redraw                 ; expired: restore the normal status
    17                              <1> .noKitTick:
    18 000034B2 50                  <1>     push ax
    19 000034B3 E87900              <1>     call MusicStep              ; AX = ticks elapsed
    20 000034B6 58                  <1>     pop ax
    21 000034B7 803E[9C5F]00        <1>     cmp byte [TimerOn],0
    22 000034BC 746F                <1>     je .done
    23 000034BE BB0500              <1>     mov bx,5
    24 000034C1 F7E3                <1>     mul bx
    25 000034C3 0106[9F5F]          <1>     add [TickAcc],ax
    26 000034C7 30DB                <1>     xor bl,bl
    27                              <1> .sec:
    28 000034C9 833E[9F5F]5B        <1>     cmp word [TickAcc],91
    29 000034CE 7256                <1>     jb .chk
    30 000034D0 832E[9F5F]5B        <1>     sub word [TickAcc],91
    31                              <1>     ; Rapid mode counts down instead of up
    32 000034D5 803E[1962]02        <1>     cmp byte [CurrentMode],2
    33 000034DA 7410                <1>     je .rapid
    34                              <1> 
    35                              <1>     ; Normal timer for Vanilla / other modes
    36 000034DC 813E[9D5F]E703      <1>     cmp word [Seconds],999
    37 000034E2 73E5                <1>     jae .sec
    38 000034E4 FF06[9D5F]          <1>     inc word [Seconds]
    39 000034E8 B301                <1>     mov bl,1
    40 000034EA EBDD                <1>     jmp .sec
    41                              <1> 
    42                              <1> .rapid:
    43 000034EC 833E[9D5F]00        <1>     cmp word [Seconds],0
    44 000034F1 740F                <1>     je .rapidTimeout
    45                              <1> 
    46 000034F3 FF0E[9D5F]          <1>     dec word [Seconds]
    47 000034F7 B301                <1>     mov bl,1
    48                              <1> 
    49 000034F9 833E[9D5F]00        <1>     cmp word [Seconds],0
    50 000034FE 7402                <1>     je .rapidTimeout
    51                              <1> 
    52 00003500 EBC7                <1>     jmp .sec
    53                              <1> 
    54                              <1> .rapidTimeout:
    55 00003502 C606[9A5F]01        <1>     mov byte [GameOver],1
    56 00003507 C606[9C5F]00        <1>     mov byte [TimerOn],0
    57 0000350C C706[A35F]FFFF      <1>     mov word [HitCell],0FFFFh
    58 00003512 C706[2862][A154]    <1>     mov word [EventPtr],EvTimeUp
    59                              <1> 
    60 00003518 E83FFC              <1>     call RevealMines
    61 0000351B E8BE0B              <1>     call Redraw
    62                              <1> 
    63 0000351E BE[E85E]            <1>     mov si,SfxBoom
    64 00003521 E8B500              <1>     call StartSfx
    65                              <1> 
    66 00003524 EB07                <1>     jmp .done
    67                              <1> 
    68                              <1> .chk:
    69 00003526 08DB                <1>     or bl,bl
    70 00003528 7403                <1>     jz .done
    71 0000352A E82C0C              <1>     call DrawTimer
    72                              <1> .done:
