   251 00000280 B307                <1>     mov bl,07h
   252 00000282 BE[E705]            <1>     mov si,msg_pick
   253 00000285 E840FE              <1>     call PrintAttr
   254 00000288 E82FFE              <1>     call WaitKey
   255 0000028B 3C31                <1>     cmp al,'1'
   256 0000028D 740E                <1>     je .tank
   257 0000028F 3C32                <1>     cmp al,'2'
   258 00000291 7411                <1>     je .mage
   259 00000293 3C33                <1>     cmp al,'3'
   260 00000295 741A                <1>     je .locked
   261 00000297 3C34                <1>     cmp al,'4'
