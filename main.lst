    67 00001C40 8B4402              <1>     mov ax,[si+2]
    68 00001C43 A3[3E2A]            <1>     mov [SfxLeft],ax
    69 00001C46 83C604              <1>     add si,4
    70 00001C49 8936[3C2A]          <1>     mov [SfxPtr],si
    71 00001C4D 09DB                <1>     or bx,bx
