   264                              <1> ; -------------------------------------------------------------------
   265                              <1> ; ScanArea: mage remote scan.  Marks (flags) every mine in the 3x3
   266                              <1> ; around DH:DL (row:col) purely in memory - never runs detonation
   267                              <1> ; logic.  Off-board neighbours are skipped, already-flagged mines
   268                              <1> ; stay flagged.
   269                              <1> ; -------------------------------------------------------------------
   270                              <1> ScanArea:
   271 000009EF 60                  <1>     pusha
   272 000009F0 88F0                <1>     mov al,dh
   273 000009F2 30E4                <1>     xor ah,ah
   274 000009F4 89C5                <1>     mov bp,ax                   ; centre row
   275 000009F6 88D0                <1>     mov al,dl
   276 000009F8 30E4                <1>     xor ah,ah
   277 000009FA 89C7                <1>     mov di,ax                   ; centre col
   278 000009FC BEFFFF              <1>     mov si,-1                   ; dy
   279                              <1> .dyloop:
   280 000009FF BAFFFF              <1>     mov dx,-1                   ; dx
   281                              <1> .dxloop:
   282 00000A02 89E8                <1>     mov ax,bp
   283 00000A04 01F0                <1>     add ax,si                   ; r = row + dy
   284 00000A06 89FB                <1>     mov bx,di
   285 00000A08 01D3                <1>     add bx,dx                   ; c = col + dx
   286 00000A0A 83F800              <1>     cmp ax,0
   287 00000A0D 7C29                <1>     jl .next
   288 00000A0F 83F809              <1>     cmp ax,GRID_ROWS
   289 00000A12 7D24                <1>     jge .next
   290 00000A14 83FB00              <1>     cmp bx,0
   291 00000A17 7C1F                <1>     jl .next
   292 00000A19 83FB09              <1>     cmp bx,GRID_COLS
   293 00000A1C 7D1A                <1>     jge .next
   294 00000A1E 89C1                <1>     mov cx,ax
   295 00000A20 01C9                <1>     add cx,cx
   296 00000A22 01C9                <1>     add cx,cx
   297 00000A24 01C9                <1>     add cx,cx
   298 00000A26 01C1                <1>     add cx,ax                   ; cx = 9r
   299 00000A28 01D9                <1>     add cx,bx                   ; cx = 9r + c
   300 00000A2A 89CB                <1>     mov bx,cx
   301 00000A2C F687[2D17]01        <1>     test byte [Board+bx],1      ; a mine?
   302 00000A31 7405                <1>     jz .next
   303 00000A33 808F[2D17]04        <1>     or byte [Board+bx],4        ; mark it with the flag bit
   304                              <1> .next:
