     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    27                                  
    28                                  ; --- code ----------------------------------------------------------
    29                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    30                                  ; submenu) -> VGA mode 13h -> game loop.  ESC in game returns to the
    31                                  ; menu; leaving via menu option [3] is the only DOS exit.
    32                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 FC                  <1>     cld
     6 00000001 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
     7 00000004 CD10                <1>     int 10h
     8 00000006 E8DC02              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
     9 00000009 B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    10 0000000C CD10                <1>     int 10h
    11 0000000E E86D0B              <1>     call SetPalette
    12                              <1> 
    13 00000011 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    14 00000013 CD33                <1>     int 33h
    15 00000015 B80700              <1>     mov ax,7                    ; X range 0..639
    16 00000018 31C9                <1>     xor cx,cx
    17 0000001A BA7F02              <1>     mov dx,639
    18 0000001D CD33                <1>     int 33h
    19 0000001F B80800              <1>     mov ax,8                    ; Y range 0..199
    20 00000022 31C9                <1>     xor cx,cx
    21 00000024 BAC700              <1>     mov dx,199
    22 00000027 CD33                <1>     int 33h
    23                              <1> 
    24 00000029 E8940B              <1>     call NewGame
    25 0000002C E8EC11              <1>     call DrawStatic
    26 0000002F E8FF13              <1>     call Redraw
    27                              <1>     SHOWM
    10 00000032 B80100              <2>  mov ax,1
    11 00000035 CD33                <2>  int 33h
    28                              <1> 
    29                              <1> GameLoop:
    30 00000037 E8BC0D              <1>     call UpdateTimer
    31                              <1> 
    32 0000003A B401                <1>     mov ah,01h                  ; key waiting?
    33 0000003C CD16                <1>     int 16h
    34 0000003E 752B                <1>     jnz KeyPressed
    35                              <1> 
    36 00000040 B80300              <1>     mov ax,0003h                ; poll mouse
    37 00000043 CD33                <1>     int 33h
    38 00000045 80E303              <1>     and bl,3
    39 00000048 741A                <1>     jz .released
    40 0000004A 803E[9C1B]00        <1>     cmp byte [PrevMouse],0
    41 0000004F 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    42 00000051 881E[9C1B]          <1>     mov [PrevMouse],bl
    43 00000055 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    44 00000057 890E[981B]          <1>     mov [MouseX],cx
    45 0000005B 8916[9A1B]          <1>     mov [MouseY],dx
    46 0000005F E82B0F              <1>     call HandleClick
    47 00000062 EBD3                <1>     jmp GameLoop
    48                              <1> .released:
    49 00000064 C606[9C1B]00        <1>     mov byte [PrevMouse],0
    50 00000069 EBCC                <1>     jmp GameLoop
    51                              <1> 
    52                              <1> KeyPressed:
    53 0000006B B400                <1>     mov ah,00h
    54 0000006D CD16                <1>     int 16h
    55 0000006F 3C1B                <1>     cmp al,27                   ; ESC
    56 00000071 743F                <1>     je ExitGame
    57 00000073 0C20                <1>     or al,20h                   ; to lower case
    58 00000075 3C6D                <1>     cmp al,'m'
    59 00000077 7434                <1>     je .mute
    60 00000079 3C72                <1>     cmp al,'r'
    61 0000007B 7505                <1>     jne .chkScan
    62 0000007D E83D00              <1>     call DoRestart
    63 00000080 EBB5                <1>     jmp GameLoop
    64                              <1> .chkScan:
    65 00000082 3C73                <1>     cmp al,'s'                  ; mage: arm / disarm the 3x3 scanner
    66 00000084 75B1                <1>     jne GameLoop
    67 00000086 803E[FC1B]02        <1>     cmp byte [SelectedClass],2
    68 0000008B 75AA                <1>     jne GameLoop
    69 0000008D 803E[FE1B]00        <1>     cmp byte [MageScans],0
    70 00000092 750F                <1>     jne .scanOk
    71 00000094 C606[001C]03        <1>     mov byte [KitMsgN],3        ; no charges: say so briefly
    72 00000099 C606[011C]24        <1>     mov byte [KitMsgT],36
    73 0000009E E89013              <1>     call Redraw
    74 000000A1 EB94                <1>     jmp GameLoop
    75                              <1> .scanOk:
    76 000000A3 8036[FF1B]01        <1>     xor byte [ScanArmed],1
    77 000000A8 E88613              <1>     call Redraw                 ; status flips to ARMED! / SCAN RDY
    78 000000AB EB8A                <1>     jmp GameLoop
    79                              <1> .mute:
    80 000000AD E89E0E              <1>     call ToggleMusic
    81 000000B0 EB85                <1>     jmp GameLoop
    82                              <1> 
    83                              <1> ExitGame:
    84 000000B2 E8D10E              <1>     call SpeakerOff
    85 000000B5 B80300              <1>     mov ax,0003h
    86 000000B8 CD10                <1>     int 10h
    87 000000BA E943FF              <1>     jmp start                   ; back to the main menu
    88                              <1> 
    89                              <1> DoRestart:
    90 000000BD E8000B              <1>     call NewGame
    91 000000C0 E86E13              <1>     call Redraw
    92 000000C3 C3                  <1>     ret
    33                                  %include "src/menu.asm"         ; text-mode intro, main menu, mode submenu
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25): startup intro, main menu, gamemode and
     3                              <1> ; class submenus.  Blue chrome with black stage bands and cyan
     4                              <1> ; pinstripes, boxed centred layout, silent input via int 21h ah=07h
     5                              <1> ; (no Enter needed).  [CurrentMode] values are unchanged
     6                              <1> ; (0 vanilla, 1 endless, 2 rapid).
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> 
     9                              <1> ; --- text helpers ---------------------------------------------------
    10                              <1> 
    11                              <1> ; ClearScr: fresh 80x25, cleared to blue/white chrome
    12                              <1> ClearScr:
    13 000000C4 60                  <1>     pusha
    14 000000C5 B80300              <1>     mov ax,0003h
    15 000000C8 CD10                <1>     int 10h
    16 000000CA B80006              <1>     mov ax,0600h                ; scroll whole window = clear with attr
    17 000000CD B71F                <1>     mov bh,1Fh                  ; blue background, white text
    18 000000CF B90000              <1>     mov cx,0000h
    19 000000D2 BA4F18              <1>     mov dx,184Fh
    20 000000D5 CD10                <1>     int 10h
    21 000000D7 B402                <1>     mov ah,02h                  ; cursor home
    22 000000D9 B700                <1>     mov bh,0
    23 000000DB 31D2                <1>     xor dx,dx
    24 000000DD CD10                <1>     int 10h
    25 000000DF 61                  <1>     popa
    26 000000E0 C3                  <1>     ret
    27                              <1> 
    28                              <1> ; Band: fill rows CH..DH with attribute BH (colour stage behind content)
    29                              <1> Band:
    30 000000E1 60                  <1>     pusha
    31 000000E2 B80006              <1>     mov ax,0600h
    32 000000E5 B100                <1>     mov cl,0
    33 000000E7 B24F                <1>     mov dl,79
    34 000000E9 CD10                <1>     int 10h
    35 000000EB 61                  <1>     popa
    36 000000EC C3                  <1>     ret
    37                              <1> 
    38                              <1> ; PaintBG: dim minefield texture (dots and asterisks) on rows CH..DH
    39                              <1> PaintBG:
    40 000000ED 60                  <1>     pusha
    41 000000EE B319                <1>     mov bl,19h                  ; bright-blue speckle on blue
    42 000000F0 BE[8007]            <1>     mov si,bg_pat
    43 000000F3 88F4                <1>     mov ah,dh                   ; last row
    44                              <1> .row:
    45 000000F5 88EE                <1>     mov dh,ch
    46 000000F7 30D2                <1>     xor dl,dl
    47 000000F9 E84000              <1>     call PrintA
    48 000000FC FEC5                <1>     inc ch
    49 000000FE 38E5                <1>     cmp ch,ah
    50 00000100 76F3                <1>     jbe .row
    51 00000102 61                  <1>     popa
    52 00000103 C3                  <1>     ret
    53                              <1> 
    54                              <1> ; WaitKey: AL = keypress, no echo
    55                              <1> WaitKey:
    56 00000104 B407                <1>     mov ah,07h
    57 00000106 CD21                <1>     int 21h
    58 00000108 C3                  <1>     ret
    59                              <1> 
    60                              <1> ; PrintStr: DS:SI -> $-terminated string via DOS (legacy helper)
    61                              <1> PrintStr:
    62 00000109 60                  <1>     pusha
    63 0000010A 89F2                <1>     mov dx,si
    64 0000010C B409                <1>     mov ah,09h
    65 0000010E CD21                <1>     int 21h
    66 00000110 61                  <1>     popa
    67 00000111 C3                  <1>     ret
    68                              <1> 
    69                              <1> ; PrintAttr: write 0-terminated string at the cursor, BL = colour attr
    70                              <1> PrintAttr:
    71 00000112 60                  <1>     pusha
    72                              <1> .ch:
    73 00000113 AC                  <1>     lodsb
    74 00000114 08C0                <1>     or al,al
    75 00000116 7422                <1>     jz .done
    76 00000118 B409                <1>     mov ah,09h                  ; write char + attribute at cursor
    77 0000011A B700                <1>     mov bh,0
    78 0000011C B90100              <1>     mov cx,1
    79 0000011F CD10                <1>     int 10h
    80 00000121 50                  <1>     push ax
    81 00000122 B403                <1>     mov ah,03h                  ; read cursor, then step one column
    82 00000124 B700                <1>     mov bh,0
    83 00000126 CD10                <1>     int 10h
    84 00000128 FEC2                <1>     inc dl
    85 0000012A 80FA50              <1>     cmp dl,80
    86 0000012D 7204                <1>     jb .set
    87 0000012F 30D2                <1>     xor dl,dl
    88 00000131 FEC6                <1>     inc dh
    89                              <1> .set:
    90 00000133 B402                <1>     mov ah,02h
    91 00000135 CD10                <1>     int 10h
    92 00000137 58                  <1>     pop ax
    93 00000138 EBD9                <1>     jmp .ch
    94                              <1> .done:
    95 0000013A 61                  <1>     popa
    96 0000013B C3                  <1>     ret
    97                              <1> 
    98                              <1> ; PrintA: PrintAttr with explicit placement.  DH=row DL=col BL=attr
    99                              <1> PrintA:
   100 0000013C 60                  <1>     pusha
   101 0000013D B402                <1>     mov ah,02h
   102 0000013F B700                <1>     mov bh,0
   103 00000141 CD10                <1>     int 10h
   104 00000143 E8CCFF              <1>     call PrintAttr
   105 00000146 61                  <1>     popa
   106 00000147 C3                  <1>     ret
   107                              <1> 
   108                              <1> ; StrLen: SI -> 0-terminated string, CX = length
   109                              <1> StrLen:
   110 00000148 56                  <1>     push si
   111 00000149 31C9                <1>     xor cx,cx
   112                              <1> .l:
   113 0000014B 803C00              <1>     cmp byte [si],0
   114 0000014E 7404                <1>     je .done
   115 00000150 46                  <1>     inc si
   116 00000151 41                  <1>     inc cx
   117 00000152 EBF7                <1>     jmp .l
   118                              <1> .done:
   119 00000154 5E                  <1>     pop si
   120 00000155 C3                  <1>     ret
   121                              <1> 
   122                              <1> ; PrintCRow: centred on row DH, BL = attr, SI -> 0-terminated string
   123                              <1> PrintCRow:
   124 00000156 60                  <1>     pusha
   125 00000157 E8EEFF              <1>     call StrLen
   126 0000015A B85000              <1>     mov ax,80
   127 0000015D 29C8                <1>     sub ax,cx
   128 0000015F D1E8                <1>     shr ax,1
   129 00000161 88C2                <1>     mov dl,al
   130 00000163 B402                <1>     mov ah,02h
   131 00000165 B700                <1>     mov bh,0
   132 00000167 CD10                <1>     int 10h
   133 00000169 E8A6FF              <1>     call PrintAttr
   134 0000016C 61                  <1>     popa
   135 0000016D C3                  <1>     ret
   136                              <1> 
   137                              <1> ; TypeStr: centred typewriter line on row DH (for the intro status)
   138                              <1> TypeStr:
   139 0000016E 60                  <1>     pusha
   140 0000016F E8D6FF              <1>     call StrLen
   141 00000172 B85000              <1>     mov ax,80
   142 00000175 29C8                <1>     sub ax,cx
   143 00000177 D1E8                <1>     shr ax,1
   144 00000179 88C2                <1>     mov dl,al
   145 0000017B B402                <1>     mov ah,02h
   146 0000017D B700                <1>     mov bh,0
   147 0000017F CD10                <1>     int 10h
   148                              <1> .ch:
   149 00000181 AC                  <1>     lodsb
   150 00000182 08C0                <1>     or al,al
   151 00000184 7425                <1>     jz .done
   152 00000186 B409                <1>     mov ah,09h
   153 00000188 B700                <1>     mov bh,0
   154 0000018A B90100              <1>     mov cx,1
   155 0000018D CD10                <1>     int 10h
   156 0000018F 50                  <1>     push ax
   157 00000190 B403                <1>     mov ah,03h                  ; advance the cursor one column
   158 00000192 B700                <1>     mov bh,0
   159 00000194 CD10                <1>     int 10h
   160 00000196 FEC2                <1>     inc dl
   161 00000198 B402                <1>     mov ah,02h
   162 0000019A CD10                <1>     int 10h
   163 0000019C 58                  <1>     pop ax
   164 0000019D 51                  <1>     push cx
   165 0000019E B90000              <1>     mov cx,0                    ; ~40 ms per character
   166 000001A1 BA409C              <1>     mov dx,9C40h
   167 000001A4 B486                <1>     mov ah,86h
   168 000001A6 CD15                <1>     int 15h
   169 000001A8 59                  <1>     pop cx
   170 000001A9 EBD6                <1>     jmp .ch
   171                              <1> .done:
