    42                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 00003904 BA1200              <1>     mov dx,0012h
    10 00003907 B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 0000390A F7F3                <1>     div bx                      ; AX = PIT divisor
    12 0000390C 89C3                <1>     mov bx,ax
    13 0000390E B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 00003910 E643                <1>     out 43h,al
    15 00003912 88D8                <1>     mov al,bl
    16 00003914 E642                <1>     out 42h,al
    17 00003916 88F8                <1>     mov al,bh
    18 00003918 E642                <1>     out 42h,al
    19 0000391A E461                <1>     in al,61h
    20 0000391C 0C03                <1>     or al,3                     ; gate + speaker on
    21 0000391E E661                <1>     out 61h,al
    22 00003920 C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00003921 E461                <1>     in al,61h
    26 00003923 24FC                <1>     and al,0FCh
    27 00003925 E661                <1>     out 61h,al
    28 00003927 C3                  <1>     ret
