   275 000002B4 B30C                <1>     mov bl,0Ch
   276 000002B6 BE[CA05]            <1>     mov si,msg_classLocked
   277 000002B9 E80CFE              <1>     call PrintAttr
   278 000002BC E833FE              <1>     call Crlf
   279 000002BF E83DFE              <1>     call Delay350
   280 000002C2 E83AFE              <1>     call Delay350
