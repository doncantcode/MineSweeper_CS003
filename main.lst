     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    27                                  
    28                                  ; --- code ----------------------------------------------------------
    29                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    30                                  ; submenu) -> VGA mode 13h -> game loop.  ESC in game returns to the
    31                                  ; menu; leaving via menu option [3] is the only DOS exit.
    32                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 FC                  <1>     cld
     6 00000001 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
     7 00000004 CD10                <1>     int 10h
     8 00000006 E83202              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
     9 00000009 B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    10 0000000C CD10                <1>     int 10h
    11 0000000E E8270A              <1>     call SetPalette
    12                              <1> 
    13 00000011 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    14 00000013 CD33                <1>     int 33h
    15 00000015 B80700              <1>     mov ax,7                    ; X range 0..639
    16 00000018 31C9                <1>     xor cx,cx
    17 0000001A BA7F02              <1>     mov dx,639
    18 0000001D CD33                <1>     int 33h
    19 0000001F B80800              <1>     mov ax,8                    ; Y range 0..199
    20 00000022 31C9                <1>     xor cx,cx
    21 00000024 BAC700              <1>     mov dx,199
    22 00000027 CD33                <1>     int 33h
    23                              <1> 
    24 00000029 E84E0A              <1>     call NewGame
    25 0000002C E87E10              <1>     call DrawStatic
    26 0000002F E8C812              <1>     call Redraw
    27                              <1>     SHOWM
    10 00000032 B80100              <2>  mov ax,1
    11 00000035 CD33                <2>  int 33h
    28                              <1> 
    29                              <1> GameLoop:
    30 00000037 E8760C              <1>     call UpdateTimer
    31                              <1> 
    32 0000003A B401                <1>     mov ah,01h                  ; key waiting?
    33 0000003C CD16                <1>     int 16h
    34 0000003E 752B                <1>     jnz KeyPressed
    35                              <1> 
    36 00000040 B80300              <1>     mov ax,0003h                ; poll mouse
    37 00000043 CD33                <1>     int 33h
    38 00000045 80E303              <1>     and bl,3
    39 00000048 741A                <1>     jz .released
    40 0000004A 803E[8919]00        <1>     cmp byte [PrevMouse],0
    41 0000004F 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    42 00000051 881E[8919]          <1>     mov [PrevMouse],bl
    43 00000055 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    44 00000057 890E[8519]          <1>     mov [MouseX],cx
    45 0000005B 8916[8719]          <1>     mov [MouseY],dx
    46 0000005F E8D30D              <1>     call HandleClick
    47 00000062 EBD3                <1>     jmp GameLoop
    48                              <1> .released:
    49 00000064 C606[8919]00        <1>     mov byte [PrevMouse],0
    50 00000069 EBCC                <1>     jmp GameLoop
    51                              <1> 
    52                              <1> KeyPressed:
    53 0000006B B400                <1>     mov ah,00h
    54 0000006D CD16                <1>     int 16h
    55 0000006F 3C1B                <1>     cmp al,27                   ; ESC
    56 00000071 742D                <1>     je ExitGame
    57 00000073 0C20                <1>     or al,20h                   ; to lower case
    58 00000075 3C6D                <1>     cmp al,'m'
    59 00000077 7422                <1>     je .mute
    60 00000079 3C72                <1>     cmp al,'r'
    61 0000007B 7505                <1>     jne .chkScan
    62 0000007D E82B00              <1>     call DoRestart
    63 00000080 EBB5                <1>     jmp GameLoop
    64                              <1> .chkScan:
    65 00000082 3C73                <1>     cmp al,'s'                  ; mage: arm / disarm the 3x3 scanner
    66 00000084 75B1                <1>     jne GameLoop
    67 00000086 803E[E919]02        <1>     cmp byte [SelectedClass],2
    68 0000008B 75AA                <1>     jne GameLoop
    69 0000008D 803E[EB19]00        <1>     cmp byte [MageScans],0
    70 00000092 74A3                <1>     je GameLoop                 ; no charges left
    71 00000094 8036[EC19]01        <1>     xor byte [ScanArmed],1
    72 00000099 EB9C                <1>     jmp GameLoop
    73                              <1> .mute:
    74 0000009B E8580D              <1>     call ToggleMusic
    75 0000009E EB97                <1>     jmp GameLoop
    76                              <1> 
    77                              <1> ExitGame:
    78 000000A0 E88B0D              <1>     call SpeakerOff
    79 000000A3 B80300              <1>     mov ax,0003h
    80 000000A6 CD10                <1>     int 10h
    81 000000A8 E955FF              <1>     jmp start                   ; back to the main menu
    82                              <1> 
    83                              <1> DoRestart:
    84 000000AB E8CC09              <1>     call NewGame
    85 000000AE E84912              <1>     call Redraw
    86 000000B1 C3                  <1>     ret
    33                                  %include "src/menu.asm"         ; text-mode intro, main menu, mode submenu
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25): startup intro, main menu, gamemode and
     3                              <1> ; class submenus.  Blue screen chrome, boxed layout, silent input via
     4                              <1> ; int 21h ah=07h (no Enter needed).  Replaces the mode pick previously
     5                              <1> ; done by the graphics menu; [CurrentMode] values are unchanged
     6                              <1> ; (0 vanilla, 1 endless, 2 rapid).
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> 
     9                              <1> ; --- text helpers ---------------------------------------------------
    10                              <1> 
    11                              <1> ; ClearScr: fresh 80x25, cleared to blue/white chrome
    12                              <1> ClearScr:
    13 000000B2 60                  <1>     pusha
    14 000000B3 B80300              <1>     mov ax,0003h
    15 000000B6 CD10                <1>     int 10h
    16 000000B8 B80006              <1>     mov ax,0600h                ; scroll whole window = clear with attr
    17 000000BB B71F                <1>     mov bh,1Fh                  ; blue background, white text
    18 000000BD B90000              <1>     mov cx,0000h
    19 000000C0 BA4F18              <1>     mov dx,184Fh
    20 000000C3 CD10                <1>     int 10h
    21 000000C5 B402                <1>     mov ah,02h                  ; cursor home
    22 000000C7 B700                <1>     mov bh,0
    23 000000C9 31D2                <1>     xor dx,dx
    24 000000CB CD10                <1>     int 10h
    25 000000CD 61                  <1>     popa
    26 000000CE C3                  <1>     ret
    27                              <1> 
    28                              <1> ; WaitKey: AL = keypress, no echo
    29                              <1> WaitKey:
    30 000000CF B407                <1>     mov ah,07h
    31 000000D1 CD21                <1>     int 21h
    32 000000D3 C3                  <1>     ret
    33                              <1> 
    34                              <1> ; PrintStr: DS:SI -> $-terminated string via DOS (legacy helper)
    35                              <1> PrintStr:
    36 000000D4 60                  <1>     pusha
    37 000000D5 89F2                <1>     mov dx,si
    38 000000D7 B409                <1>     mov ah,09h
    39 000000D9 CD21                <1>     int 21h
    40 000000DB 61                  <1>     popa
    41 000000DC C3                  <1>     ret
    42                              <1> 
    43                              <1> ; PrintAttr: write 0-terminated string at the cursor, BL = colour attr
    44                              <1> PrintAttr:
    45 000000DD 60                  <1>     pusha
    46                              <1> .ch:
    47 000000DE AC                  <1>     lodsb
    48 000000DF 08C0                <1>     or al,al
    49 000000E1 7422                <1>     jz .done
    50 000000E3 B409                <1>     mov ah,09h                  ; write char + attribute at cursor
    51 000000E5 B700                <1>     mov bh,0
    52 000000E7 B90100              <1>     mov cx,1
    53 000000EA CD10                <1>     int 10h
    54 000000EC 50                  <1>     push ax
    55 000000ED B403                <1>     mov ah,03h                  ; read cursor, then step one column
    56 000000EF B700                <1>     mov bh,0
    57 000000F1 CD10                <1>     int 10h
    58 000000F3 FEC2                <1>     inc dl
    59 000000F5 80FA50              <1>     cmp dl,80
    60 000000F8 7204                <1>     jb .set
    61 000000FA 30D2                <1>     xor dl,dl
    62 000000FC FEC6                <1>     inc dh
    63                              <1> .set:
    64 000000FE B402                <1>     mov ah,02h
    65 00000100 CD10                <1>     int 10h
    66 00000102 58                  <1>     pop ax
    67 00000103 EBD9                <1>     jmp .ch
    68                              <1> .done:
    69 00000105 61                  <1>     popa
    70 00000106 C3                  <1>     ret
    71                              <1> 
    72                              <1> ; PrintA: PrintAttr with explicit placement.  DH=row DL=col BL=attr
    73                              <1> PrintA:
    74 00000107 60                  <1>     pusha
    75 00000108 B402                <1>     mov ah,02h
    76 0000010A B700                <1>     mov bh,0
    77 0000010C CD10                <1>     int 10h
    78 0000010E E8CCFF              <1>     call PrintAttr
    79 00000111 61                  <1>     popa
    80 00000112 C3                  <1>     ret
    81                              <1> 
    82                              <1> ; StrLen: SI -> 0-terminated string, CX = length
    83                              <1> StrLen:
    84 00000113 56                  <1>     push si
    85 00000114 31C9                <1>     xor cx,cx
    86                              <1> .l:
    87 00000116 803C00              <1>     cmp byte [si],0
    88 00000119 7404                <1>     je .done
    89 0000011B 46                  <1>     inc si
    90 0000011C 41                  <1>     inc cx
    91 0000011D EBF7                <1>     jmp .l
    92                              <1> .done:
    93 0000011F 5E                  <1>     pop si
    94 00000120 C3                  <1>     ret
    95                              <1> 
    96                              <1> ; PrintCRow: centred on row DH, BL = attr, SI -> 0-terminated string
    97                              <1> PrintCRow:
    98 00000121 60                  <1>     pusha
    99 00000122 E8EEFF              <1>     call StrLen
   100 00000125 B85000              <1>     mov ax,80
   101 00000128 29C8                <1>     sub ax,cx
   102 0000012A D1E8                <1>     shr ax,1
   103 0000012C 88C2                <1>     mov dl,al
   104 0000012E B402                <1>     mov ah,02h
   105 00000130 B700                <1>     mov bh,0
   106 00000132 CD10                <1>     int 10h
   107 00000134 E8A6FF              <1>     call PrintAttr
   108 00000137 61                  <1>     popa
   109 00000138 C3                  <1>     ret
   110                              <1> 
   111                              <1> ; TypeStr: centred typewriter line on row DH (for the intro status)
   112                              <1> TypeStr:
   113 00000139 60                  <1>     pusha
   114 0000013A E8D6FF              <1>     call StrLen
   115 0000013D B85000              <1>     mov ax,80
   116 00000140 29C8                <1>     sub ax,cx
   117 00000142 D1E8                <1>     shr ax,1
   118 00000144 88C2                <1>     mov dl,al
   119 00000146 B402                <1>     mov ah,02h
   120 00000148 B700                <1>     mov bh,0
   121 0000014A CD10                <1>     int 10h
   122                              <1> .ch:
   123 0000014C AC                  <1>     lodsb
   124 0000014D 08C0                <1>     or al,al
   125 0000014F 7425                <1>     jz .done
   126 00000151 B409                <1>     mov ah,09h
   127 00000153 B700                <1>     mov bh,0
   128 00000155 B90100              <1>     mov cx,1
   129 00000158 CD10                <1>     int 10h
   130 0000015A 50                  <1>     push ax
   131 0000015B B403                <1>     mov ah,03h                  ; advance the cursor one column
   132 0000015D B700                <1>     mov bh,0
   133 0000015F CD10                <1>     int 10h
   134 00000161 FEC2                <1>     inc dl
   135 00000163 B402                <1>     mov ah,02h
   136 00000165 CD10                <1>     int 10h
   137 00000167 58                  <1>     pop ax
   138 00000168 51                  <1>     push cx
   139 00000169 B90000              <1>     mov cx,0                    ; ~40 ms per character
   140 0000016C BA409C              <1>     mov dx,9C40h
   141 0000016F B486                <1>     mov ah,86h
   142 00000171 CD15                <1>     int 15h
   143 00000173 59                  <1>     pop cx
   144 00000174 EBD6                <1>     jmp .ch
   145                              <1> .done:
   146 00000176 61                  <1>     popa
   147 00000177 C3                  <1>     ret
   148                              <1> 
   149                              <1> ; Delay350: ~0.35 s pause (int 15h wait, CX:DX usec)
   150                              <1> Delay350:
   151 00000178 60                  <1>     pusha
   152 00000179 B90500              <1>     mov cx,5
   153 0000017C BA3057              <1>     mov dx,5730h
   154 0000017F B486                <1>     mov ah,86h
   155 00000181 CD15                <1>     int 15h
   156 00000183 61                  <1>     popa
   157 00000184 C3                  <1>     ret
   158                              <1> 
   159                              <1> ; DrawBar: reverse-video status bar along the bottom row
   160                              <1> DrawBar:
   161 00000185 60                  <1>     pusha
   162 00000186 B370                <1>     mov bl,70h
   163 00000188 BE[2206]            <1>     mov si,bar_fill
   164 0000018B B618                <1>     mov dh,24
   165 0000018D 30D2                <1>     xor dl,dl
   166 0000018F E875FF              <1>     call PrintA
   167 00000192 BE[7306]            <1>     mov si,bar_left
   168 00000195 30D2                <1>     xor dl,dl
   169 00000197 E86DFF              <1>     call PrintA
