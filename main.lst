     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    27                                  
    28                                  ; --- code ----------------------------------------------------------
    29                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    30                                  ; submenu) -> VGA mode 13h -> game loop.  ESC in game returns to the
    31                                  ; menu; leaving via menu option [3] is the only DOS exit.
    32                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 FC                  <1>     cld
     6 00000001 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
     7 00000004 CD10                <1>     int 10h
     8 00000006 E85B01              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
     9 00000009 B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    10 0000000C CD10                <1>     int 10h
    11 0000000E E8BD07              <1>     call SetPalette
    12                              <1> 
    13 00000011 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    14 00000013 CD33                <1>     int 33h
    15 00000015 B80700              <1>     mov ax,7                    ; X range 0..639
    16 00000018 31C9                <1>     xor cx,cx
    17 0000001A BA7F02              <1>     mov dx,639
    18 0000001D CD33                <1>     int 33h
    19 0000001F B80800              <1>     mov ax,8                    ; Y range 0..199
    20 00000022 31C9                <1>     xor cx,cx
    21 00000024 BAC700              <1>     mov dx,199
    22 00000027 CD33                <1>     int 33h
    23                              <1> 
    24 00000029 E8E407              <1>     call NewGame
    25 0000002C E8140E              <1>     call DrawStatic
    26 0000002F E85E10              <1>     call Redraw
    27                              <1>     SHOWM
    10 00000032 B80100              <2>  mov ax,1
    11 00000035 CD33                <2>  int 33h
    28                              <1> 
    29                              <1> GameLoop:
    30 00000037 E80C0A              <1>     call UpdateTimer
    31                              <1> 
    32 0000003A B401                <1>     mov ah,01h                  ; key waiting?
    33 0000003C CD16                <1>     int 16h
    34 0000003E 752B                <1>     jnz KeyPressed
    35                              <1> 
    36 00000040 B80300              <1>     mov ax,0003h                ; poll mouse
    37 00000043 CD33                <1>     int 33h
    38 00000045 80E303              <1>     and bl,3
    39 00000048 741A                <1>     jz .released
    40 0000004A 803E[1F17]00        <1>     cmp byte [PrevMouse],0
    41 0000004F 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    42 00000051 881E[1F17]          <1>     mov [PrevMouse],bl
    43 00000055 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    44 00000057 890E[1B17]          <1>     mov [MouseX],cx
    45 0000005B 8916[1D17]          <1>     mov [MouseY],dx
    46 0000005F E8690B              <1>     call HandleClick
    47 00000062 EBD3                <1>     jmp GameLoop
    48                              <1> .released:
    49 00000064 C606[1F17]00        <1>     mov byte [PrevMouse],0
    50 00000069 EBCC                <1>     jmp GameLoop
    51                              <1> 
    52                              <1> KeyPressed:
    53 0000006B B400                <1>     mov ah,00h
    54 0000006D CD16                <1>     int 16h
    55 0000006F 3C1B                <1>     cmp al,27                   ; ESC
    56 00000071 742D                <1>     je ExitGame
    57 00000073 0C20                <1>     or al,20h                   ; to lower case
    58 00000075 3C6D                <1>     cmp al,'m'
    59 00000077 7422                <1>     je .mute
    60 00000079 3C72                <1>     cmp al,'r'
    61 0000007B 7505                <1>     jne .chkScan
    62 0000007D E82B00              <1>     call DoRestart
    63 00000080 EBB5                <1>     jmp GameLoop
    64                              <1> .chkScan:
    65 00000082 3C73                <1>     cmp al,'s'                  ; mage: arm / disarm the 3x3 scanner
    66 00000084 75B1                <1>     jne GameLoop
    67 00000086 803E[7F17]02        <1>     cmp byte [SelectedClass],2
    68 0000008B 75AA                <1>     jne GameLoop
    69 0000008D 803E[8117]00        <1>     cmp byte [MageScans],0
    70 00000092 74A3                <1>     je GameLoop                 ; no charges left
    71 00000094 8036[8217]01        <1>     xor byte [ScanArmed],1
    72 00000099 EB9C                <1>     jmp GameLoop
    73                              <1> .mute:
    74 0000009B E8EE0A              <1>     call ToggleMusic
    75 0000009E EB97                <1>     jmp GameLoop
    76                              <1> 
    77                              <1> ExitGame:
    78 000000A0 E8210B              <1>     call SpeakerOff
    79 000000A3 B80300              <1>     mov ax,0003h
    80 000000A6 CD10                <1>     int 10h
    81 000000A8 E955FF              <1>     jmp start                   ; back to the main menu
    82                              <1> 
    83                              <1> DoRestart:
    84 000000AB E86207              <1>     call NewGame
    85 000000AE E8DF0F              <1>     call Redraw
    86 000000B1 C3                  <1>     ret
    33                                  %include "src/menu.asm"         ; text-mode intro, main menu, mode submenu
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25): startup intro, main menu and the
     3                              <1> ; gamemode submenu.  Keyboard driven through int 21h ah=07h (silent
     4                              <1> ; read), so no Enter presses are needed.  Replaces the mode pick
     5                              <1> ; previously done by the graphics menu; [CurrentMode] values are
     6                              <1> ; unchanged (0 vanilla, 1 endless, 2 rapid).
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> 
     9                              <1> ; --- text helpers ---------------------------------------------------
    10                              <1> 
    11                              <1> ; ClearScr: fresh 80x25 screen, cursor home
    12                              <1> ClearScr:
    13 000000B2 60                  <1>     pusha
    14 000000B3 B80300              <1>     mov ax,0003h
    15 000000B6 CD10                <1>     int 10h
    16 000000B8 61                  <1>     popa
    17 000000B9 C3                  <1>     ret
    18                              <1> 
    19                              <1> ; WaitKey: AL = keypress, no echo
    20                              <1> WaitKey:
    21 000000BA B407                <1>     mov ah,07h
    22 000000BC CD21                <1>     int 21h
    23 000000BE C3                  <1>     ret
    24                              <1> 
    25                              <1> ; PrintStr: DS:SI -> $-terminated string via DOS
    26                              <1> PrintStr:
    27 000000BF 60                  <1>     pusha
    28 000000C0 89F2                <1>     mov dx,si
    29 000000C2 B409                <1>     mov ah,09h
    30 000000C4 CD21                <1>     int 21h
    31 000000C6 61                  <1>     popa
    32 000000C7 C3                  <1>     ret
    33                              <1> 
    34                              <1> ; PrintAttr: DS:SI -> 0-terminated string, BL = colour attribute
    35                              <1> PrintAttr:
    36 000000C8 60                  <1>     pusha
    37                              <1> .ch:
    38 000000C9 AC                  <1>     lodsb
    39 000000CA 08C0                <1>     or al,al
    40 000000CC 7422                <1>     jz .done
    41 000000CE B409                <1>     mov ah,09h                    ; write char + attribute at cursor
    42 000000D0 B700                <1>     mov bh,0
    43 000000D2 B90100              <1>     mov cx,1
    44 000000D5 CD10                <1>     int 10h
    45 000000D7 50                  <1>     push ax
    46 000000D8 B403                <1>     mov ah,03h                    ; read cursor, then step one column
    47 000000DA B700                <1>     mov bh,0
    48 000000DC CD10                <1>     int 10h
    49 000000DE FEC2                <1>     inc dl
    50 000000E0 80FA50              <1>     cmp dl,80
    51 000000E3 7204                <1>     jb .set
    52 000000E5 30D2                <1>     xor dl,dl
    53 000000E7 FEC6                <1>     inc dh
    54                              <1> .set:
    55 000000E9 B402                <1>     mov ah,02h
    56 000000EB CD10                <1>     int 10h
    57 000000ED 58                  <1>     pop ax
    58 000000EE EBD9                <1>     jmp .ch
    59                              <1> .done:
    60 000000F0 61                  <1>     popa
    61 000000F1 C3                  <1>     ret
    62                              <1> 
    63                              <1> ; Crlf: teletype a line feed + carriage return
    64                              <1> Crlf:
    65 000000F2 60                  <1>     pusha
    66 000000F3 B40E                <1>     mov ah,0Eh
    67 000000F5 B00A                <1>     mov al,10
    68 000000F7 CD10                <1>     int 10h
    69 000000F9 B00D                <1>     mov al,13
    70 000000FB CD10                <1>     int 10h
    71 000000FD 61                  <1>     popa
    72 000000FE C3                  <1>     ret
    73                              <1> 
    74                              <1> ; Delay350: ~0.35 s pause (int 15h wait, CX:DX usec)
    75                              <1> Delay350:
    76 000000FF 60                  <1>     pusha
    77 00000100 B90500              <1>     mov cx,5
    78 00000103 BA3057              <1>     mov dx,5730h
    79 00000106 B486                <1>     mov ah,86h
    80 00000108 CD15                <1>     int 15h
    81 0000010A 61                  <1>     popa
    82 0000010B C3                  <1>     ret
    83                              <1> 
    84                              <1> ; --- intro ----------------------------------------------------------
    85                              <1> 
    86                              <1> ShowIntro:
    87 0000010C 60                  <1>     pusha
    88 0000010D B30E                <1>     mov bl,0Eh                    ; banner in bright yellow
    89 0000010F BE[E902]            <1>     mov si,art_title1
    90 00000112 E8B3FF              <1>     call PrintAttr
    91 00000115 E8DAFF              <1>     call Crlf
    92 00000118 BE[3403]            <1>     mov si,art_title2
    93 0000011B E8AAFF              <1>     call PrintAttr
    94 0000011E E8D1FF              <1>     call Crlf
    95 00000121 BE[8003]            <1>     mov si,art_title3
    96 00000124 E8A1FF              <1>     call PrintAttr
    97 00000127 E8C8FF              <1>     call Crlf
    98 0000012A BE[CC03]            <1>     mov si,art_title4
    99 0000012D E898FF              <1>     call PrintAttr
   100 00000130 E8BFFF              <1>     call Crlf
   101 00000133 E8BCFF              <1>     call Crlf
   102 00000136 B30B                <1>     mov bl,0Bh                    ; tactical status in cyan
   103 00000138 BE[1804]            <1>     mov si,msg_scan
   104 0000013B E88AFF              <1>     call PrintAttr
   105 0000013E E8B1FF              <1>     call Crlf
   106 00000141 E8BBFF              <1>     call Delay350
   107 00000144 B30A                <1>     mov bl,0Ah                    ; mine report in green
   108 00000146 BE[2F04]            <1>     mov si,msg_mines
   109 00000149 E87CFF              <1>     call PrintAttr
   110 0000014C E8A3FF              <1>     call Crlf
   111 0000014F E8ADFF              <1>     call Delay350
   112 00000152 B307                <1>     mov bl,07h
   113 00000154 BE[4104]            <1>     mov si,msg_anykey
   114 00000157 E86EFF              <1>     call PrintAttr
   115 0000015A E85DFF              <1>     call WaitKey
   116 0000015D C606[8317]01        <1>     mov byte [IntroShown],1
   117 00000162 61                  <1>     popa
   118 00000163 C3                  <1>     ret
   119                              <1> 
   120                              <1> ; --- main menu ------------------------------------------------------
   121                              <1> 
   122                              <1> MainMenu:
   123 00000164 803E[8317]00        <1>     cmp byte [IntroShown],0       ; intro only on first boot
   124 00000169 7503                <1>     jne .loop
   125 0000016B E89EFF              <1>     call ShowIntro
   126                              <1> .loop:
   127 0000016E E841FF              <1>     call ClearScr
   128 00000171 B30E                <1>     mov bl,0Eh
   129 00000173 BE[5B04]            <1>     mov si,txt_menuTitle
   130 00000176 E84FFF              <1>     call PrintAttr
   131 00000179 E876FF              <1>     call Crlf
   132 0000017C E873FF              <1>     call Crlf
   133 0000017F B30F                <1>     mov bl,0Fh
   134 00000181 BE[7304]            <1>     mov si,opt_play
   135 00000184 E841FF              <1>     call PrintAttr
   136 00000187 E868FF              <1>     call Crlf
   137 0000018A BE[7D04]            <1>     mov si,opt_credits
   138 0000018D E838FF              <1>     call PrintAttr
   139 00000190 E85FFF              <1>     call Crlf
   140 00000193 BE[8A04]            <1>     mov si,opt_exit
   141 00000196 E82FFF              <1>     call PrintAttr
   142 00000199 E856FF              <1>     call Crlf
   143 0000019C E853FF              <1>     call Crlf
   144 0000019F B307                <1>     mov bl,07h
   145 000001A1 BE[E705]            <1>     mov si,msg_pick
   146 000001A4 E821FF              <1>     call PrintAttr
   147 000001A7 E810FF              <1>     call WaitKey
   148 000001AA 3C31                <1>     cmp al,'1'
   149 000001AC 740A                <1>     je .play
   150 000001AE 3C32                <1>     cmp al,'2'
   151 000001B0 7415                <1>     je .credits
   152 000001B2 3C33                <1>     cmp al,'3'
   153 000001B4 7419                <1>     je .exit
   154 000001B6 EBB6                <1>     jmp .loop                     ; anything else: redraw
   155                              <1> .play:
   156 000001B8 E81700              <1>     call ModeMenu                 ; AL=0 -> Back, no mode picked
   157 000001BB 08C0                <1>     or al,al
   158 000001BD 74AF                <1>     jz .loop
   159 000001BF E88000              <1>     call ClassMenu                ; AL=0 -> Back, no class picked
   160 000001C2 08C0                <1>     or al,al
   161 000001C4 74A8                <1>     jz .loop
   162 000001C6 C3                  <1>     ret                           ; mode + class set: boot the game
   163                              <1> .credits:
   164 000001C7 E8E8FE              <1>     call ClearScr
   165 000001CA E87F04              <1>     call show_credits
   166 000001CD EB9F                <1>     jmp .loop
   167                              <1> .exit:
   168 000001CF E8F900              <1>     call ExitToDos
   169                              <1> 
   170                              <1> ; --- gamemode submenu -----------------------------------------------
   171                              <1> 
   172                              <1> ; ModeMenu: returns AL=1 with [CurrentMode] set, or AL=0 for Back
   173                              <1> ModeMenu:
   174                              <1> .loop:
   175 000001D2 E8DDFE              <1>     call ClearScr
   176 000001D5 B30E                <1>     mov bl,0Eh
   177 000001D7 BE[9B04]            <1>     mov si,txt_modeTitle
   178 000001DA E8EBFE              <1>     call PrintAttr
   179 000001DD E812FF              <1>     call Crlf
   180 000001E0 E80FFF              <1>     call Crlf
   181 000001E3 B30F                <1>     mov bl,0Fh
   182 000001E5 BE[AB04]            <1>     mov si,opt_vanilla
   183 000001E8 E8DDFE              <1>     call PrintAttr
   184 000001EB E804FF              <1>     call Crlf
   185 000001EE BE[D904]            <1>     mov si,opt_endless
   186 000001F1 E8D4FE              <1>     call PrintAttr
   187 000001F4 E8FBFE              <1>     call Crlf
   188 000001F7 BE[0505]            <1>     mov si,opt_rapid
   189 000001FA E8CBFE              <1>     call PrintAttr
   190 000001FD E8F2FE              <1>     call Crlf
   191 00000200 BE[2705]            <1>     mov si,opt_back
   192 00000203 E8C2FE              <1>     call PrintAttr
   193 00000206 E8E9FE              <1>     call Crlf
   194 00000209 E8E6FE              <1>     call Crlf
   195 0000020C B307                <1>     mov bl,07h
   196 0000020E BE[E705]            <1>     mov si,msg_pick
   197 00000211 E8B4FE              <1>     call PrintAttr
   198 00000214 E8A3FE              <1>     call WaitKey
   199 00000217 3C31                <1>     cmp al,'1'
   200 00000219 740E                <1>     je .vanilla
   201 0000021B 3C32                <1>     cmp al,'2'
   202 0000021D 7411                <1>     je .endless
   203 0000021F 3C33                <1>     cmp al,'3'
   204 00000221 7414                <1>     je .rapid
   205 00000223 3C34                <1>     cmp al,'4'
   206 00000225 7418                <1>     je .back
   207 00000227 EBA9                <1>     jmp .loop
   208                              <1> .vanilla:
   209 00000229 C606[7E17]00        <1>     mov byte [CurrentMode],0
   210 0000022E EB0C                <1>     jmp .picked
   211                              <1> .endless:
   212 00000230 C606[7E17]01        <1>     mov byte [CurrentMode],1
   213 00000235 EB05                <1>     jmp .picked
   214                              <1> .rapid:
   215 00000237 C606[7E17]02        <1>     mov byte [CurrentMode],2
   216                              <1> .picked:
   217 0000023C B001                <1>     mov al,1
   218 0000023E C3                  <1>     ret
   219                              <1> .back:
   220 0000023F 30C0                <1>     xor al,al
   221 00000241 C3                  <1>     ret
   222                              <1> 
   223                              <1> ; --- class submenu --------------------------------------------------
   224                              <1> 
   225                              <1> ; ClassMenu: returns AL=1 with [SelectedClass] set, or AL=0 for Back.
   226                              <1> ; [3] Artificer is locked: shows a message and forces re-selection.
   227                              <1> ClassMenu:
   228                              <1> .loop:
   229 00000242 E86DFE              <1>     call ClearScr
   230 00000245 B30E                <1>     mov bl,0Eh
   231 00000247 BE[3E05]            <1>     mov si,txt_classTitle
   232 0000024A E87BFE              <1>     call PrintAttr
   233 0000024D E8A2FE              <1>     call Crlf
   234 00000250 E89FFE              <1>     call Crlf
   235 00000253 B30F                <1>     mov bl,0Fh
   236 00000255 BE[4B05]            <1>     mov si,opt_tank
   237 00000258 E86DFE              <1>     call PrintAttr
   238 0000025B E894FE              <1>     call Crlf
   239 0000025E BE[7305]            <1>     mov si,opt_mage
   240 00000261 E864FE              <1>     call PrintAttr
   241 00000264 E88BFE              <1>     call Crlf
   242 00000267 B308                <1>     mov bl,08h                    ; grey: locked entry
   243 00000269 BE[A305]            <1>     mov si,opt_artificer
   244 0000026C E859FE              <1>     call PrintAttr
   245 0000026F E880FE              <1>     call Crlf
