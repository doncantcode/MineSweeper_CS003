    40                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 000036E9 60                  <1>     pusha
     6 000036EA B400                <1>     mov ah,00h
     7 000036EC CD1A                <1>     int 1Ah
     8 000036EE 89D0                <1>     mov ax,dx
     9 000036F0 2B06[2562]          <1>     sub ax,[LastTick]
    10 000036F4 0F848F00            <1>     jz .done
    11 000036F8 8916[2562]          <1>     mov [LastTick],dx
    12 000036FC 803E[EB64]00        <1>     cmp byte [KitMsgT],0        ; transient kit message timing
    13 00003701 7409                <1>     je .noKitTick
    14 00003703 FE0E[EB64]          <1>     dec byte [KitMsgT]
    15 00003707 7503                <1>     jnz .noKitTick
    16 00003709 E82A0C              <1>     call Redraw                 ; expired: restore the normal status
    17                              <1> .noKitTick:
    18 0000370C 50                  <1>     push ax
    19 0000370D E87900              <1>     call MusicStep              ; AX = ticks elapsed
    20 00003710 58                  <1>     pop ax
    21 00003711 803E[2062]00        <1>     cmp byte [TimerOn],0
    22 00003716 746F                <1>     je .done
    23 00003718 BB0500              <1>     mov bx,5
    24 0000371B F7E3                <1>     mul bx
    25 0000371D 0106[2362]          <1>     add [TickAcc],ax
    26 00003721 30DB                <1>     xor bl,bl
    27                              <1> .sec:
    28 00003723 833E[2362]5B        <1>     cmp word [TickAcc],91
    29 00003728 7256                <1>     jb .chk
    30 0000372A 832E[2362]5B        <1>     sub word [TickAcc],91
    31                              <1>     ; Rapid mode counts down instead of up
    32 0000372F 803E[9D64]02        <1>     cmp byte [CurrentMode],2
    33 00003734 7410                <1>     je .rapid
    34                              <1> 
    35                              <1>     ; Normal timer for Vanilla / other modes
    36 00003736 813E[2162]E703      <1>     cmp word [Seconds],999
    37 0000373C 73E5                <1>     jae .sec
    38 0000373E FF06[2162]          <1>     inc word [Seconds]
    39 00003742 B301                <1>     mov bl,1
    40 00003744 EBDD                <1>     jmp .sec
    41                              <1> 
    42                              <1> .rapid:
    43 00003746 833E[2162]00        <1>     cmp word [Seconds],0
    44 0000374B 740F                <1>     je .rapidTimeout
    45                              <1> 
    46 0000374D FF0E[2162]          <1>     dec word [Seconds]
    47 00003751 B301                <1>     mov bl,1
    48                              <1> 
    49 00003753 833E[2162]00        <1>     cmp word [Seconds],0
    50 00003758 7402                <1>     je .rapidTimeout
    51                              <1> 
    52 0000375A EBC7                <1>     jmp .sec
    53                              <1> 
    54                              <1> .rapidTimeout:
    55 0000375C C606[1E62]01        <1>     mov byte [GameOver],1
    56 00003761 C606[2062]00        <1>     mov byte [TimerOn],0
    57 00003766 C706[2762]FFFF      <1>     mov word [HitCell],0FFFFh
