    48                              <1> 
    49 00001B95 833E[672A]00        <1>     cmp word [Seconds],0
    50 00001B9A 7402                <1>     je .rapidTimeout
    51                              <1> 
    52 00001B9C EBC7                <1>     jmp .sec
    53                              <1> 
