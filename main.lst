     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  B + click   : use a collected 3x3 bomb
    11                                  ;  M           : music on/off (PC speaker)
    12                                  ;
    13                                  ;  This file is only the include manifest.  The code lives in src/,
    14                                  ;  included below in the order the modules are laid out in the .COM
    15                                  ;  image, so keeping this list in order matters.
    16                                  ; ===================================================================
    17                                  bits 16
    18                                  org 100h
    19                                  
    20                                  GRID_COLS   equ 9
    21                                  GRID_ROWS   equ 9
    22                                  TOTAL_MINES equ 10
    23                                  CELLS       equ GRID_COLS*GRID_ROWS
    24                                  START_X     equ 88
    25                                  START_Y     equ 45
    26                                  ITEM_BIT    equ 8
    27                                  WIN_REWARD  equ 5
    28                                  TANK_PRICE  equ 10
    29                                  MAGE_PRICE  equ 15
    30                                  ART_PRICE   equ 20
    31                                  SAVE_SIZE   equ 8
    32                                  
    33                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    34                                  
    35                                  ; --- code ----------------------------------------------------------
    36                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    37                                  ; and shop) -> VGA mode 13h -> game loop. ESC in game returns to the
    38                                  ; menu; leaving via menu option [4] is the only DOS exit.
    39                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 FC                  <1>     cld
     6 00000001 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
     7 00000004 CD10                <1>     int 10h
     8 00000006 803E[C82A]00        <1>     cmp byte [ProgressLoaded],0
     9 0000000B 7508                <1>     jne .progressReady
    10 0000000D E81F14              <1>     call LoadProgress
    11 00000010 C606[C82A]01        <1>     mov byte [ProgressLoaded],1
    12                              <1> .progressReady:
    13 00000015 E88E07              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
    14 00000018 803E[DF2A]02        <1>     cmp byte [SelectedClass],2  ; grant the mage's session scan for this run
    15 0000001D 7505                <1>     jne .noMageScan
    16 0000001F C606[E12A]01        <1>     mov byte [MageScans],1
    17                              <1> .noMageScan:
    18 00000024 B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    19 00000027 CD10                <1>     int 10h
    20 00000029 E88D17              <1>     call SetPalette
    21                              <1> 
    22 0000002C 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    23 0000002E CD33                <1>     int 33h
    24 00000030 B80700              <1>     mov ax,7                    ; X range 0..639
    25 00000033 31C9                <1>     xor cx,cx
    26 00000035 BA7F02              <1>     mov dx,639
    27 00000038 CD33                <1>     int 33h
    28 0000003A B80800              <1>     mov ax,8                    ; Y range 0..199
    29 0000003D 31C9                <1>     xor cx,cx
    30 0000003F BAC700              <1>     mov dx,199
    31 00000042 CD33                <1>     int 33h
    32                              <1> 
    33 00000044 E8B417              <1>     call NewGame
    34 00000047 E84D1F              <1>     call DrawStatic
    35 0000004A E89C21              <1>     call Redraw
    36                              <1>     SHOWM
    10 0000004D B80100              <2>  mov ax,1
    11 00000050 CD33                <2>  int 33h
    37                              <1> 
    38                              <1> GameLoop:
    39 00000052 E8D61A              <1>     call UpdateTimer
    40                              <1> 
    41 00000055 B401                <1>     mov ah,01h                  ; key waiting?
    42 00000057 CD16                <1>     int 16h
    43 00000059 752B                <1>     jnz KeyPressed
    44                              <1> 
    45 0000005B B80300              <1>     mov ax,0003h                ; poll mouse
    46 0000005E CD33                <1>     int 33h
    47 00000060 80E303              <1>     and bl,3
    48 00000063 741A                <1>     jz .released
    49 00000065 803E[632A]00        <1>     cmp byte [PrevMouse],0
    50 0000006A 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    51 0000006C 881E[632A]          <1>     mov [PrevMouse],bl
    52 00000070 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    53 00000072 890E[5F2A]          <1>     mov [MouseX],cx
    54 00000076 8916[612A]          <1>     mov [MouseY],dx
    55 0000007A E8451C              <1>     call HandleClick
    56 0000007D EBD3                <1>     jmp GameLoop
    57                              <1> .released:
    58 0000007F C606[632A]00        <1>     mov byte [PrevMouse],0
    59 00000084 EBCC                <1>     jmp GameLoop
    60                              <1> 
    61                              <1> KeyPressed:
    62 00000086 B400                <1>     mov ah,00h
    63 00000088 CD16                <1>     int 16h
    64 0000008A 3C1B                <1>     cmp al,27                   ; ESC
    65 0000008C 7479                <1>     je ExitGame
    66 0000008E 0C20                <1>     or al,20h                   ; to lower case
    67 00000090 3C6D                <1>     cmp al,'m'
    68 00000092 746D                <1>     je .mute
    69 00000094 3C72                <1>     cmp al,'r'
    70 00000096 7505                <1>     jne .chkBomb
    71 00000098 E87700              <1>     call DoRestart
    72 0000009B EBB5                <1>     jmp GameLoop
    73                              <1> .chkBomb:
    74 0000009D 3C62                <1>     cmp al,'b'                  ; arm a collected bomb for the next tile click
    75 0000009F 752C                <1>     jne .chkScan
    76 000000A1 803E[642A]00        <1>     cmp byte [GameOver],0
    77 000000A6 75AA                <1>     jne GameLoop
    78 000000A8 803E[E32A]00        <1>     cmp byte [BombCount],0
    79 000000AD 750F                <1>     jne .bombReady
    80 000000AF C606[E52A]06        <1>     mov byte [KitMsgN],6
    81 000000B4 C606[E62A]24        <1>     mov byte [KitMsgT],36
    82 000000B9 E82D21              <1>     call Redraw
    83 000000BC EB94                <1>     jmp GameLoop
    84                              <1> .bombReady:
    85 000000BE 8036[E42A]01        <1>     xor byte [BombArmed],1
    86 000000C3 C606[E22A]00        <1>     mov byte [ScanArmed],0
    87 000000C8 E81E21              <1>     call Redraw
    88 000000CB EB85                <1>     jmp GameLoop
    89                              <1> .chkScan:
    90 000000CD 3C73                <1>     cmp al,'s'                  ; mage: arm / disarm the 3x3 scanner
    91 000000CF 7581                <1>     jne GameLoop
    92 000000D1 803E[DF2A]02        <1>     cmp byte [SelectedClass],2
    93 000000D6 0F8578FF            <1>     jne GameLoop
    94 000000DA 803E[E12A]00        <1>     cmp byte [MageScans],0
    95 000000DF 7510                <1>     jne .scanOk
    96 000000E1 C606[E52A]03        <1>     mov byte [KitMsgN],3        ; no charges: say so briefly
    97 000000E6 C606[E62A]24        <1>     mov byte [KitMsgT],36
    98 000000EB E8FB20              <1>     call Redraw
    99 000000EE E961FF              <1>     jmp GameLoop
   100                              <1> .scanOk:
   101 000000F1 C606[E42A]00        <1>     mov byte [BombArmed],0
   102 000000F6 8036[E22A]01        <1>     xor byte [ScanArmed],1
   103 000000FB E8EB20              <1>     call Redraw                 ; status flips to ARMED! / SCAN RDY
   104 000000FE E951FF              <1>     jmp GameLoop
   105                              <1> .mute:
   106 00000101 E87F1B              <1>     call ToggleMusic
   107 00000104 E94BFF              <1>     jmp GameLoop
   108                              <1> 
   109                              <1> ExitGame:
   110 00000107 E8B11B              <1>     call SpeakerOff
   111 0000010A B80300              <1>     mov ax,0003h
   112 0000010D CD10                <1>     int 10h
   113 0000010F E9EEFE              <1>     jmp start                   ; back to the main menu
   114                              <1> 
   115                              <1> DoRestart:
   116 00000112 E8E616              <1>     call NewGame
   117 00000115 E8D120              <1>     call Redraw
   118 00000118 C3                  <1>     ret
    40                                  %include "src/menu.asm"         ; text-mode intro, main menu, mode/shop menus
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25) - v3 menu UI
     3                              <1> ;   * big block-letter MINESWEEPER logo, ice-white to steel-blue + shadow
     4                              <1> ;   * dimmed minefield backdrop so menu details stand out
     5                              <1> ;   * steel-blue pinstripes framing the black masthead / stage
     6                              <1> ;   * one data-driven menu engine (RunMenu) used by main/mode/shop
     7                              <1> ;   * arrow keys / W,S + Enter, number hotkeys, Esc = back
     8                              <1> ;   * highlight bar, per-item description line, locked-item styling
     9                              <1> ;   * everything drawn straight into video RAM (B800h): no flicker
    10                              <1> ; [CurrentMode] values unchanged (0 vanilla, 1 endless, 2 rapid).
    11                              <1> ; Only background colours 0-7 are used, so the BIOS blink bit is
    12                              <1> ; never an issue.
    13                              <1> ; -------------------------------------------------------------------
    14                              <1> 
    15                              <1> PC          equ 15              ; panel left column (panel is 50 wide, centred)
    16                              <1> RBN         equ 12              ; entries in the rainbow palette
    17                              <1> 
    18                              <1> ; --- low-level helpers ----------------------------------------------
    19                              <1> 
    20                              <1> ; ClearScr: fresh 80x25 mode, cleared to blue/white chrome
    21                              <1> ClearScr:
    22 00000119 60                  <1>     pusha
    23 0000011A B80300              <1>     mov ax,0003h
    24 0000011D CD10                <1>     int 10h
    25 0000011F B80006              <1>     mov ax,0600h
    26 00000122 B71F                <1>     mov bh,1Fh
    27 00000124 B90000              <1>     mov cx,0000h
    28 00000127 BA4F18              <1>     mov dx,184Fh
    29 0000012A CD10                <1>     int 10h
    30 0000012C B402                <1>     mov ah,02h
    31 0000012E B700                <1>     mov bh,0
    32 00000130 31D2                <1>     xor dx,dx
    33 00000132 CD10                <1>     int 10h
    34 00000134 61                  <1>     popa
    35 00000135 C3                  <1>     ret
    36                              <1> 
    37                              <1> ; ClearFast: clear to blue/white WITHOUT a mode reset (no flicker)
    38                              <1> ClearFast:
    39 00000136 60                  <1>     pusha
    40 00000137 B80006              <1>     mov ax,0600h
    41 0000013A B71F                <1>     mov bh,1Fh
    42 0000013C 31C9                <1>     xor cx,cx
    43 0000013E BA4F18              <1>     mov dx,184Fh
    44 00000141 CD10                <1>     int 10h
    45 00000143 61                  <1>     popa
    46 00000144 C3                  <1>     ret
    47                              <1> 
    48                              <1> ; Band: fill rows CH..DH with attribute BH
    49                              <1> Band:
    50 00000145 60                  <1>     pusha
    51 00000146 B80006              <1>     mov ax,0600h
    52 00000149 B100                <1>     mov cl,0
    53 0000014B B24F                <1>     mov dl,79
    54 0000014D CD10                <1>     int 10h
    55 0000014F 61                  <1>     popa
    56 00000150 C3                  <1>     ret
    57                              <1> 
    58                              <1> ; PaintBG: minefield backdrop on rows CH..DH.  Six pattern rows repeat;
    59                              <1> ; BgCell turns pattern characters into coloured screen cells.
    60                              <1> PaintBG:
    61 00000151 60                  <1>     pusha
    62 00000152 06                  <1>     push es
    63 00000153 B800B8              <1>     mov ax,0B800h
    64 00000156 8EC0                <1>     mov es,ax
    65 00000158 FC                  <1>     cld
    66 00000159 88F3                <1>     mov bl,dh                   ; last row
    67                              <1> .row:
    68 0000015B 88E8                <1>     mov al,ch                   ; pattern = bg_rows[row mod 6]
    69 0000015D 30E4                <1>     xor ah,ah
    70 0000015F B206                <1>     mov dl,6
    71 00000161 F6F2                <1>     div dl
    72 00000163 88E0                <1>     mov al,ah
    73 00000165 30E4                <1>     xor ah,ah
    74 00000167 D1E0                <1>     shl ax,1
    75 00000169 89C6                <1>     mov si,ax
    76 0000016B 8BB4[380D]          <1>     mov si,[bg_rows+si]
    77 0000016F B050                <1>     mov al,80                   ; DI = row * 160
    78 00000171 F6E5                <1>     mul ch
    79 00000173 D1E0                <1>     shl ax,1
    80 00000175 89C7                <1>     mov di,ax
    81 00000177 B650                <1>     mov dh,80
    82                              <1> .cell:
    83 00000179 AC                  <1>     lodsb
    84 0000017A 08C0                <1>     or al,al
    85 0000017C 740A                <1>     jz .fill
    86 0000017E E81800              <1>     call BgCell
    87 00000181 AB                  <1>     stosw
    88 00000182 FECE                <1>     dec dh
    89 00000184 75F3                <1>     jnz .cell
    90 00000186 EB08                <1>     jmp .next
    91                              <1> .fill:
    92 00000188 B82011              <1>     mov ax,1120h                ; pattern ended early: plain blue
    93                              <1> .f:
    94 0000018B AB                  <1>     stosw
    95 0000018C FECE                <1>     dec dh
    96 0000018E 75FB                <1>     jnz .f
    97                              <1> .next:
    98 00000190 FEC5                <1>     inc ch
    99 00000192 38DD                <1>     cmp ch,bl
   100 00000194 76C5                <1>     jbe .row
   101 00000196 07                  <1>     pop es
   102 00000197 61                  <1>     popa
   103 00000198 C3                  <1>     ret
   104                              <1> 
   105                              <1> ; BgCell: AL = pattern char -> AL = screen char, AH = attribute
   106                              <1> ;   '.' dot   '*' mine   '^' flag   '1'..'8' classic number colours
   107                              <1> BgCell:
   108 00000199 3C2E                <1>     cmp al,'.'
   109 0000019B 7504                <1>     jne .n1
   110 0000019D B8FA10              <1>     mov ax,10FAh                ; black-on-blue dot (dim)
   111 000001A0 C3                  <1>     ret
   112                              <1> .n1:
   113 000001A1 3C2A                <1>     cmp al,'*'
   114 000001A3 7504                <1>     jne .n2
   115 000001A5 B80F18              <1>     mov ax,180Fh                ; dim grey mine
   116 000001A8 C3                  <1>     ret
   117                              <1> .n2:
   118 000001A9 3C5E                <1>     cmp al,'^'
   119 000001AB 7504                <1>     jne .n3
   120 000001AD B81E19              <1>     mov ax,191Eh                ; dim blue flag
   121 000001B0 C3                  <1>     ret
   122                              <1> .n3:
   123 000001B1 3C31                <1>     cmp al,'1'
   124 000001B3 7212                <1>     jb .sp
   125 000001B5 3C38                <1>     cmp al,'8'
   126 000001B7 770E                <1>     ja .sp
   127 000001B9 53                  <1>     push bx
   128 000001BA 88C3                <1>     mov bl,al
   129 000001BC 80EB31              <1>     sub bl,'1'
   130 000001BF 30FF                <1>     xor bh,bh
   131 000001C1 8AA7[9C09]          <1>     mov ah,[nr_bg+bx]
   132 000001C5 5B                  <1>     pop bx
   133 000001C6 C3                  <1>     ret
   134                              <1> .sp:
   135 000001C7 B82011              <1>     mov ax,1120h
   136 000001CA C3                  <1>     ret
   137                              <1> 
   138                              <1> ; Rainbow: row DH, AL = char; 80 cells cycling through rb_tab (bg black)
   139                              <1> Rainbow:
   140 000001CB 60                  <1>     pusha
   141 000001CC 06                  <1>     push es
   142 000001CD BB00B8              <1>     mov bx,0B800h
   143 000001D0 8EC3                <1>     mov es,bx
   144 000001D2 88C3                <1>     mov bl,al                   ; char
   145 000001D4 B050                <1>     mov al,80
   146 000001D6 F6E6                <1>     mul dh
   147 000001D8 D1E0                <1>     shl ax,1
   148 000001DA 89C7                <1>     mov di,ax
   149 000001DC B95000              <1>     mov cx,80
   150 000001DF 31F6                <1>     xor si,si
   151 000001E1 FC                  <1>     cld
   152                              <1> .lp:
   153 000001E2 88D8                <1>     mov al,bl
   154 000001E4 8AA4[9009]          <1>     mov ah,[rb_tab+si]
   155 000001E8 AB                  <1>     stosw
   156 000001E9 46                  <1>     inc si
   157 000001EA 83FE0C              <1>     cmp si,RBN
   158 000001ED 7202                <1>     jb .n
   159 000001EF 31F6                <1>     xor si,si
   160                              <1> .n:
   161 000001F1 E2EF                <1>     loop .lp
   162 000001F3 07                  <1>     pop es
   163 000001F4 61                  <1>     popa
   164 000001F5 C3                  <1>     ret
   165                              <1> 
   166                              <1> ; NumRow: row DH, centred "1 2 3 4 5 6 7 8" in minesweeper rainbow
   167                              <1> NumRow:
   168 000001F6 60                  <1>     pusha
   169 000001F7 B220                <1>     mov dl,32
   170 000001F9 31F6                <1>     xor si,si
   171 000001FB B90800              <1>     mov cx,8
   172                              <1> .n:
   173 000001FE 89F0                <1>     mov ax,si
   174 00000200 0431                <1>     add al,'1'
   175 00000202 A2[8E09]            <1>     mov [nbuf],al
   176 00000205 8A9C[A409]          <1>     mov bl,[nr_stage+si]
   177 00000209 56                  <1>     push si
   178 0000020A BE[8E09]            <1>     mov si,nbuf
   179 0000020D E85300              <1>     call PrintA
   180 00000210 5E                  <1>     pop si
   181 00000211 46                  <1>     inc si
   182 00000212 80C202              <1>     add dl,2
   183 00000215 E2E7                <1>     loop .n
   184 00000217 61                  <1>     popa
   185 00000218 C3                  <1>     ret
   186                              <1> 
   187                              <1> ; WaitKey: AL = keypress, no echo
   188                              <1> WaitKey:
   189 00000219 B407                <1>     mov ah,07h
   190 0000021B CD21                <1>     int 21h
   191 0000021D C3                  <1>     ret
   192                              <1> 
   193                              <1> ; GetKey: AL = key code, AH = 0 normal / 1 extended (arrows etc, AL=scan)
   194                              <1> GetKey:
   195 0000021E B407                <1>     mov ah,07h
