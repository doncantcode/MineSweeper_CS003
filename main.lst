    36                                  %include "src/progress.asm"     ; permanent currency, class ownership, save file
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Permanent progression stored in MINESW.SAV in the DOS working folder.
     3                              <1> ; Save layout: "MSH1", Shrapnels (word), owned-class bits, equipped class,
     4                              <1> ;              PotionOracle, PotionRadar, PotionDetector, CurrentLevel,
     5                              <1> ;              UnlockedLevel (13th byte; older 12-byte saves still load)
     6                              <1> ; The Tank is free, so it is always marked as owned.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> LoadProgress:
     9 00002B51 60                  <1>     pusha
    10 00002B52 C706[C464]0000      <1>     mov word [Shrapnels],0
    11 00002B58 C606[C664]00        <1>     mov byte [OwnedClasses],0
    12 00002B5D C606[E464]00        <1>     mov byte [SelectedClass],0
    13 00002B62 C606[C064]00        <1>     mov byte [PotionOracle],0
    14 00002B67 C606[C164]00        <1>     mov byte [PotionRadar],0
    15 00002B6C C606[C264]00        <1>     mov byte [PotionDetector],0
    16 00002B71 C606[9E64]01        <1>     mov byte [CurrentLevel],1
    17 00002B76 C606[A864]01        <1>     mov byte [UnlockedLevel],1
    18 00002B7B C606[C764]00        <1>     mov byte [ProgressError],0
    19 00002B80 C606[CB64]00        <1>     mov byte [LoadValid],0
    20                              <1> 
    21 00002B85 B8003D              <1>     mov ax,3D00h                ; open existing save read-only
    22 00002B88 BA[D964]            <1>     mov dx,SaveFile
    23 00002B8B CD21                <1>     int 21h
    24 00002B8D 730F                <1>     jnc .opened
    25 00002B8F 83F802              <1>     cmp ax,2                    ; file not found is a first-time player
    26 00002B92 0F84FC00            <1>     je .done
    27 00002B96 C606[C764]01        <1>     mov byte [ProgressError],1
    28 00002B9B E9F400              <1>     jmp .done
    29                              <1> 
    30                              <1> .opened:
    31 00002B9E A3[C964]            <1>     mov [SaveHandle],ax
    32 00002BA1 89C3                <1>     mov bx,ax
    33 00002BA3 B90D00              <1>     mov cx,SAVE_SIZE
    34 00002BA6 BA[CC64]            <1>     mov dx,SaveBuffer
    35 00002BA9 B43F                <1>     mov ah,3Fh
    36 00002BAB CD21                <1>     int 21h
    37 00002BAD 720A                <1>     jc .readFailed
    38 00002BAF 83F808              <1>     cmp ax,8                    ; at least 8 bytes required
    39 00002BB2 7205                <1>     jb .readFailed
    40 00002BB4 A2[CB64]            <1>     mov [LoadValid],al          ; number of bytes read
    41 00002BB7 EB05                <1>     jmp .close
    42                              <1> .readFailed:
