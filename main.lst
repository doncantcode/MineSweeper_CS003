     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
