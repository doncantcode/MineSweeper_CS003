    38                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 00000E90 60                  <1>     pusha
    10 00000E91 803E[741B]00        <1>     cmp byte [SfxOn],0
    11 00000E96 741D                <1>     je .music
    12 00000E98 8B1E[771B]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00000E9C 39D8                <1>     cmp ax,bx
    14 00000E9E 7205                <1>     jb .sfxhold
    15 00000EA0 E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 00000EA3 EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00000EA5 29C3                <1>     sub bx,ax
    19 00000EA7 891E[771B]          <1>     mov [SfxLeft],bx
    20 00000EAB 83FB01              <1>     cmp bx,1
    21 00000EAE 774D                <1>     ja .done
    22 00000EB0 E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 00000EB3 EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00000EB5 803E[6F1B]00        <1>     cmp byte [MusicOn],0
    27 00000EBA 7441                <1>     je .done
    28 00000EBC 8B1E[701B]          <1>     mov bx,[NoteLeft]
    29 00000EC0 39D8                <1>     cmp ax,bx
    30 00000EC2 7310                <1>     jae .next                   ; current note finished
    31 00000EC4 29C3                <1>     sub bx,ax
    32 00000EC6 891E[701B]          <1>     mov [NoteLeft],bx
    33 00000ECA 83FB01              <1>     cmp bx,1
    34 00000ECD 772E                <1>     ja .done
    35 00000ECF E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 00000ED2 EB29                <1>     jmp .done
    37                              <1> .next:
    38 00000ED4 8B36[721B]          <1>     mov si,[MusicPtr]
    39 00000ED8 8B1C                <1>     mov bx,[si]
    40 00000EDA 83FBFF              <1>     cmp bx,0FFFFh
    41 00000EDD 7505                <1>     jne .play
    42 00000EDF BE[0B19]            <1>     mov si,SongTable            ; end of tune -> loop
    43 00000EE2 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00000EE4 8B4402              <1>     mov ax,[si+2]
    46 00000EE7 A3[701B]            <1>     mov [NoteLeft],ax
    47 00000EEA 83C604              <1>     add si,4
    48 00000EED 8936[721B]          <1>     mov [MusicPtr],si
    49 00000EF1 09DB                <1>     or bx,bx
    50 00000EF3 7405                <1>     jz .rest
    51 00000EF5 E87100              <1>     call SpeakerOn
    52 00000EF8 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00000EFA E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 00000EFD 61                  <1>     popa
    57 00000EFE C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 00000EFF 60                  <1>     pusha
    63 00000F00 8B36[751B]          <1>     mov si,[SfxPtr]
    64 00000F04 8B1C                <1>     mov bx,[si]
    65 00000F06 83FBFF              <1>     cmp bx,0FFFFh
    66 00000F09 741B                <1>     je .end
    67 00000F0B 8B4402              <1>     mov ax,[si+2]
    68 00000F0E A3[771B]            <1>     mov [SfxLeft],ax
    69 00000F11 83C604              <1>     add si,4
    70 00000F14 8936[751B]          <1>     mov [SfxPtr],si
    71 00000F18 09DB                <1>     or bx,bx
    72 00000F1A 7405                <1>     jz .rest
    73 00000F1C E84A00              <1>     call SpeakerOn
    74 00000F1F 61                  <1>     popa
    75 00000F20 C3                  <1>     ret
    76                              <1> .rest:
    77 00000F21 E86200              <1>     call SpeakerOff
    78 00000F24 61                  <1>     popa
    79 00000F25 C3                  <1>     ret
    80                              <1> .end:
    81 00000F26 C606[741B]00        <1>     mov byte [SfxOn],0
    82 00000F2B C706[701B]0000      <1>     mov word [NoteLeft],0
    83 00000F31 BE[0B19]            <1>     mov si,SongTable
    84 00000F34 8936[721B]          <1>     mov [MusicPtr],si
    85 00000F38 61                  <1>     popa
    86 00000F39 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 00000F3A 53                  <1>     push bx
    91 00000F3B 56                  <1>     push si
    92 00000F3C E84700              <1>     call SpeakerOff
    93 00000F3F 8936[751B]          <1>     mov [SfxPtr],si
    94 00000F43 C606[741B]01        <1>     mov byte [SfxOn],1
    95 00000F48 E8B4FF              <1>     call SfxAdvance
    96 00000F4B 5E                  <1>     pop si
    97 00000F4C 5B                  <1>     pop bx
    98 00000F4D C3                  <1>     ret
    99                              <1> 
   100                              <1> ToggleMusic:
   101 00000F4E 8036[6F1B]01        <1>     xor byte [MusicOn],1
   102 00000F53 C706[701B]0000      <1>     mov word [NoteLeft],0
   103 00000F59 803E[6F1B]00        <1>     cmp byte [MusicOn],0
   104 00000F5E 7508                <1>     jne .r
   105 00000F60 C606[741B]00        <1>     mov byte [SfxOn],0
   106 00000F65 E81E00              <1>     call SpeakerOff
   107                              <1> .r:
   108 00000F68 C3                  <1>     ret
    39                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 00000F69 BA1200              <1>     mov dx,0012h
    10 00000F6C B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 00000F6F F7F3                <1>     div bx                      ; AX = PIT divisor
    12 00000F71 89C3                <1>     mov bx,ax
    13 00000F73 B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 00000F75 E643                <1>     out 43h,al
    15 00000F77 88D8                <1>     mov al,bl
    16 00000F79 E642                <1>     out 42h,al
    17 00000F7B 88F8                <1>     mov al,bh
    18 00000F7D E642                <1>     out 42h,al
    19 00000F7F E461                <1>     in al,61h
    20 00000F81 0C03                <1>     or al,3                     ; gate + speaker on
    21 00000F83 E661                <1>     out 61h,al
    22 00000F85 C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00000F86 E461                <1>     in al,61h
    26 00000F88 24FC                <1>     and al,0FCh
    27 00000F8A E661                <1>     out 61h,al
    28 00000F8C C3                  <1>     ret
    40                                  %include "src/input.asm"        ; mouse click handling
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Mouse click handling.  MouseX/MouseY = pixel, PrevMouse = buttons
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> HandleClick:
     5 00000F8D 60                  <1>     pusha
     6                              <1> 
     7                              <1>     ; --- face button (new game) ---
     8 00000F8E A1[981B]            <1>     mov ax,[MouseX]
     9 00000F91 3D9500              <1>     cmp ax,149
    10 00000F94 7C21                <1>     jl .board
    11 00000F96 3DAB00              <1>     cmp ax,171
    12 00000F99 7D1C                <1>     jge .board
    13 00000F9B A1[9A1B]            <1>     mov ax,[MouseY]
    14 00000F9E 83F80C              <1>     cmp ax,12
    15 00000FA1 7C14                <1>     jl .board
    16 00000FA3 83F822              <1>     cmp ax,34
    17 00000FA6 7D0F                <1>     jge .board
    18 00000FA8 F606[9C1B]01        <1>     test byte [PrevMouse],1
    19 00000FAD 0F840C01            <1>     jz .out
    20 00000FB1 E809F1              <1>     call DoRestart
    21 00000FB4 E90601              <1>     jmp .out
    22                              <1> 
    23                              <1>     ; --- board ---
    24                              <1> .board:
    25 00000FB7 803E[9D1B]00        <1>     cmp byte [GameOver],0
    26 00000FBC 0F85FD00            <1>     jne .out
    27                              <1> 
    28 00000FC0 A1[981B]            <1>     mov ax,[MouseX]
    29 00000FC3 83E858              <1>     sub ax,START_X
    30 00000FC6 0F8CF300            <1>     jl .out
    31 00000FCA 3D9000              <1>     cmp ax,GRID_COLS*16
    32 00000FCD 0F8DEC00            <1>     jge .out
    33 00000FD1 C1E804              <1>     shr ax,4
    34 00000FD4 88C2                <1>     mov dl,al                   ; column
    35 00000FD6 A1[9A1B]            <1>     mov ax,[MouseY]
    36 00000FD9 83E82D              <1>     sub ax,START_Y
    37 00000FDC 0F8CDD00            <1>     jl .out
    38 00000FE0 3D9000              <1>     cmp ax,GRID_ROWS*16
    39 00000FE3 0F8DD600            <1>     jge .out
    40 00000FE7 C1E804              <1>     shr ax,4
    41 00000FEA 88C6                <1>     mov dh,al                   ; row
