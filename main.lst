     1                                  ; ===================================================================
     2                                  ;  MINESWEEPER  (NASM / DOS .COM / VGA mode 13h / INT 33h mouse)
     3                                  ;
     4                                  ;  Build : nasm -f bin main.asm -o main.com     (or: build.bat)
     5                                  ;  Run   : in DOSBox ->  main.com   (click inside the window so the
     6                                  ;          mouse is captured)
     7                                  ;
     8                                  ;  Left click  : open tile          Right click : place / remove flag
     9                                  ;  Click face  : new game           R : new game        ESC : quit
    10                                  ;  M           : music on/off (PC speaker)
    11                                  ;
    12                                  ;  This file is only the include manifest.  The code lives in src/,
    13                                  ;  included below in the order the modules are laid out in the .COM
    14                                  ;  image, so keeping this list in order matters.
    15                                  ; ===================================================================
    16                                  bits 16
    17                                  org 100h
    18                                  
    19                                  GRID_COLS   equ 9
    20                                  GRID_ROWS   equ 9
    21                                  TOTAL_MINES equ 10
    22                                  CELLS       equ GRID_COLS*GRID_ROWS
    23                                  START_X     equ 88
    24                                  START_Y     equ 45
    25                                  
    26                                  %include "src/macros.inc"       ; HIDEM/SHOWM/BEVEL/TXT macros
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Macros
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> %macro HIDEM 0
     5                              <1>     mov ax,2
     6                              <1>     int 33h
     7                              <1> %endmacro
     8                              <1> 
     9                              <1> %macro SHOWM 0
    10                              <1>     mov ax,1
    11                              <1>     int 33h
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> ; BEVEL raised(1)/sunken(0), x, y, w, h, faceColour
    15                              <1> %macro BEVEL 6
    16                              <1>     mov byte [BevFace],%6
    17                              <1>   %if %1
    18                              <1>     mov byte [BevTL],15
    19                              <1>     mov byte [BevBR],8
    20                              <1>   %else
    21                              <1>     mov byte [BevTL],8
    22                              <1>     mov byte [BevBR],15
    23                              <1>   %endif
    24                              <1>     mov ax,%2
    25                              <1>     mov bx,%3
    26                              <1>     mov cx,%4
    27                              <1>     mov dx,%5
    28                              <1>     call DrawBevel
    29                              <1> %endmacro
    30                              <1> 
    31                              <1> ; TXT row, col, colour, 'string'
    32                              <1> %macro TXT 4
    33                              <1>     jmp short %%skip
    34                              <1> %%str: db %4,0
    35                              <1> %%skip:
    36                              <1>     mov dh,%1
    37                              <1>     mov dl,%2
    38                              <1>     mov bl,%3
    39                              <1>     mov si,%%str
    40                              <1>     call PrintAt
    41                              <1> %endmacro
    27                                  
    28                                  ; --- code ----------------------------------------------------------
    29                                  ; Boot flow: start (text mode) -> MainMenu (intro, credits, gamemode
    30                                  ; submenu) -> VGA mode 13h -> game loop.  ESC in game returns to the
    31                                  ; menu; leaving via menu option [3] is the only DOS exit.
    32                                  %include "src/entry.asm"        ; start, main loop, keys, restart
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Program start
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> start:
     5 00000000 FC                  <1>     cld
     6 00000001 B80300              <1>     mov ax,0003h                ; 80x25 text: intro + main menu
     7 00000004 CD10                <1>     int 10h
     8 00000006 E8D506              <1>     call MainMenu               ; sets [CurrentMode]; Exit never returns
     9 00000009 B81300              <1>     mov ax,0013h                ; VGA mode 13h for the game
    10 0000000C CD10                <1>     int 10h
    11 0000000E E8AB13              <1>     call SetPalette
    12                              <1> 
    13 00000011 31C0                <1>     xor ax,ax                   ; reset mouse driver (cursor hidden)
    14 00000013 CD33                <1>     int 33h
    15 00000015 B80700              <1>     mov ax,7                    ; X range 0..639
    16 00000018 31C9                <1>     xor cx,cx
    17 0000001A BA7F02              <1>     mov dx,639
    18 0000001D CD33                <1>     int 33h
    19 0000001F B80800              <1>     mov ax,8                    ; Y range 0..199
    20 00000022 31C9                <1>     xor cx,cx
    21 00000024 BAC700              <1>     mov dx,199
    22 00000027 CD33                <1>     int 33h
    23                              <1> 
    24 00000029 E8D213              <1>     call NewGame
    25 0000002C E82A1A              <1>     call DrawStatic
    26 0000002F E83D1C              <1>     call Redraw
    27                              <1>     SHOWM
    10 00000032 B80100              <2>  mov ax,1
    11 00000035 CD33                <2>  int 33h
    28                              <1> 
    29                              <1> GameLoop:
    30 00000037 E8FA15              <1>     call UpdateTimer
    31                              <1> 
    32 0000003A B401                <1>     mov ah,01h                  ; key waiting?
    33 0000003C CD16                <1>     int 16h
    34 0000003E 752B                <1>     jnz KeyPressed
    35                              <1> 
    36 00000040 B80300              <1>     mov ax,0003h                ; poll mouse
    37 00000043 CD33                <1>     int 33h
    38 00000045 80E303              <1>     and bl,3
    39 00000048 741A                <1>     jz .released
    40 0000004A 803E[DA23]00        <1>     cmp byte [PrevMouse],0
    41 0000004F 75E6                <1>     jne GameLoop                ; still holding: ignore until released
    42 00000051 881E[DA23]          <1>     mov [PrevMouse],bl
    43 00000055 D1E9                <1>     shr cx,1                    ; 0..639 -> 0..319
    44 00000057 890E[D623]          <1>     mov [MouseX],cx
    45 0000005B 8916[D823]          <1>     mov [MouseY],dx
    46 0000005F E86917              <1>     call HandleClick
    47 00000062 EBD3                <1>     jmp GameLoop
    48                              <1> .released:
    49 00000064 C606[DA23]00        <1>     mov byte [PrevMouse],0
    50 00000069 EBCC                <1>     jmp GameLoop
    51                              <1> 
    52                              <1> KeyPressed:
    53 0000006B B400                <1>     mov ah,00h
    54 0000006D CD16                <1>     int 16h
    55 0000006F 3C1B                <1>     cmp al,27                   ; ESC
    56 00000071 743F                <1>     je ExitGame
    57 00000073 0C20                <1>     or al,20h                   ; to lower case
    58 00000075 3C6D                <1>     cmp al,'m'
    59 00000077 7434                <1>     je .mute
    60 00000079 3C72                <1>     cmp al,'r'
    61 0000007B 7505                <1>     jne .chkScan
    62 0000007D E83D00              <1>     call DoRestart
    63 00000080 EBB5                <1>     jmp GameLoop
    64                              <1> .chkScan:
    65 00000082 3C73                <1>     cmp al,'s'                  ; mage: arm / disarm the 3x3 scanner
    66 00000084 75B1                <1>     jne GameLoop
    67 00000086 803E[3A24]02        <1>     cmp byte [SelectedClass],2
    68 0000008B 75AA                <1>     jne GameLoop
    69 0000008D 803E[3C24]00        <1>     cmp byte [MageScans],0
    70 00000092 750F                <1>     jne .scanOk
    71 00000094 C606[3E24]03        <1>     mov byte [KitMsgN],3        ; no charges: say so briefly
    72 00000099 C606[3F24]24        <1>     mov byte [KitMsgT],36
    73 0000009E E8CE1B              <1>     call Redraw
    74 000000A1 EB94                <1>     jmp GameLoop
    75                              <1> .scanOk:
    76 000000A3 8036[3D24]01        <1>     xor byte [ScanArmed],1
    77 000000A8 E8C41B              <1>     call Redraw                 ; status flips to ARMED! / SCAN RDY
    78 000000AB EB8A                <1>     jmp GameLoop
    79                              <1> .mute:
    80 000000AD E8DC16              <1>     call ToggleMusic
    81 000000B0 EB85                <1>     jmp GameLoop
    82                              <1> 
    83                              <1> ExitGame:
    84 000000B2 E80F17              <1>     call SpeakerOff
    85 000000B5 B80300              <1>     mov ax,0003h
    86 000000B8 CD10                <1>     int 10h
    87 000000BA E943FF              <1>     jmp start                   ; back to the main menu
    88                              <1> 
    89                              <1> DoRestart:
    90 000000BD E83E13              <1>     call NewGame
    91 000000C0 E8AC1B              <1>     call Redraw
    92 000000C3 C3                  <1>     ret
    33                                  %include "src/menu.asm"         ; text-mode intro, main menu, mode submenu
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25) - v3 menu UI
     3                              <1> ;   * big block-letter MINESWEEPER logo, ice-white to steel-blue + shadow
     4                              <1> ;   * dimmed minefield backdrop so menu details stand out
     5                              <1> ;   * steel-blue pinstripes framing the black masthead / stage
     6                              <1> ;   * one data-driven menu engine (RunMenu) used by main/mode/class
     7                              <1> ;   * arrow keys / W,S + Enter, number hotkeys, Esc = back
     8                              <1> ;   * highlight bar, per-item description line, locked-item styling
     9                              <1> ;   * everything drawn straight into video RAM (B800h): no flicker
    10                              <1> ; [CurrentMode] values unchanged (0 vanilla, 1 endless, 2 rapid).
    11                              <1> ; Only background colours 0-7 are used, so the BIOS blink bit is
    12                              <1> ; never an issue.
    13                              <1> ; -------------------------------------------------------------------
    14                              <1> 
    15                              <1> PC          equ 15              ; panel left column (panel is 50 wide, centred)
    16                              <1> RBN         equ 12              ; entries in the rainbow palette
    17                              <1> 
    18                              <1> ; --- low-level helpers ----------------------------------------------
    19                              <1> 
    20                              <1> ; ClearScr: fresh 80x25 mode, cleared to blue/white chrome
    21                              <1> ClearScr:
    22 000000C4 60                  <1>     pusha
    23 000000C5 B80300              <1>     mov ax,0003h
    24 000000C8 CD10                <1>     int 10h
    25 000000CA B80006              <1>     mov ax,0600h
    26 000000CD B71F                <1>     mov bh,1Fh
    27 000000CF B90000              <1>     mov cx,0000h
    28 000000D2 BA4F18              <1>     mov dx,184Fh
    29 000000D5 CD10                <1>     int 10h
    30 000000D7 B402                <1>     mov ah,02h
    31 000000D9 B700                <1>     mov bh,0
    32 000000DB 31D2                <1>     xor dx,dx
    33 000000DD CD10                <1>     int 10h
    34 000000DF 61                  <1>     popa
    35 000000E0 C3                  <1>     ret
    36                              <1> 
    37                              <1> ; ClearFast: clear to blue/white WITHOUT a mode reset (no flicker)
    38                              <1> ClearFast:
    39 000000E1 60                  <1>     pusha
    40 000000E2 B80006              <1>     mov ax,0600h
    41 000000E5 B71F                <1>     mov bh,1Fh
    42 000000E7 31C9                <1>     xor cx,cx
    43 000000E9 BA4F18              <1>     mov dx,184Fh
    44 000000EC CD10                <1>     int 10h
    45 000000EE 61                  <1>     popa
    46 000000EF C3                  <1>     ret
    47                              <1> 
    48                              <1> ; Band: fill rows CH..DH with attribute BH
    49                              <1> Band:
    50 000000F0 60                  <1>     pusha
    51 000000F1 B80006              <1>     mov ax,0600h
    52 000000F4 B100                <1>     mov cl,0
    53 000000F6 B24F                <1>     mov dl,79
    54 000000F8 CD10                <1>     int 10h
    55 000000FA 61                  <1>     popa
    56 000000FB C3                  <1>     ret
    57                              <1> 
    58                              <1> ; PaintBG: minefield backdrop on rows CH..DH.  Six pattern rows repeat;
    59                              <1> ; BgCell turns pattern characters into coloured screen cells.
    60                              <1> PaintBG:
    61 000000FC 60                  <1>     pusha
    62 000000FD 06                  <1>     push es
    63 000000FE B800B8              <1>     mov ax,0B800h
    64 00000101 8EC0                <1>     mov es,ax
    65 00000103 FC                  <1>     cld
    66 00000104 88F3                <1>     mov bl,dh                   ; last row
    67                              <1> .row:
    68 00000106 88E8                <1>     mov al,ch                   ; pattern = bg_rows[row mod 6]
    69 00000108 30E4                <1>     xor ah,ah
    70 0000010A B206                <1>     mov dl,6
    71 0000010C F6F2                <1>     div dl
    72 0000010E 88E0                <1>     mov al,ah
    73 00000110 30E4                <1>     xor ah,ah
    74 00000112 D1E0                <1>     shl ax,1
    75 00000114 89C6                <1>     mov si,ax
    76 00000116 8BB4[B00B]          <1>     mov si,[bg_rows+si]
    77 0000011A B050                <1>     mov al,80                   ; DI = row * 160
    78 0000011C F6E5                <1>     mul ch
    79 0000011E D1E0                <1>     shl ax,1
    80 00000120 89C7                <1>     mov di,ax
    81 00000122 B650                <1>     mov dh,80
    82                              <1> .cell:
    83 00000124 AC                  <1>     lodsb
    84 00000125 08C0                <1>     or al,al
    85 00000127 740A                <1>     jz .fill
    86 00000129 E81800              <1>     call BgCell
    87 0000012C AB                  <1>     stosw
    88 0000012D FECE                <1>     dec dh
    89 0000012F 75F3                <1>     jnz .cell
    90 00000131 EB08                <1>     jmp .next
    91                              <1> .fill:
    92 00000133 B82011              <1>     mov ax,1120h                ; pattern ended early: plain blue
    93                              <1> .f:
    94 00000136 AB                  <1>     stosw
    95 00000137 FECE                <1>     dec dh
    96 00000139 75FB                <1>     jnz .f
    97                              <1> .next:
    98 0000013B FEC5                <1>     inc ch
    99 0000013D 38DD                <1>     cmp ch,bl
   100 0000013F 76C5                <1>     jbe .row
   101 00000141 07                  <1>     pop es
   102 00000142 61                  <1>     popa
   103 00000143 C3                  <1>     ret
   104                              <1> 
   105                              <1> ; BgCell: AL = pattern char -> AL = screen char, AH = attribute
   106                              <1> ;   '.' dot   '*' mine   '^' flag   '1'..'8' classic number colours
   107                              <1> BgCell:
   108 00000144 3C2E                <1>     cmp al,'.'
   109 00000146 7504                <1>     jne .n1
   110 00000148 B8FA10              <1>     mov ax,10FAh                ; black-on-blue dot (dim)
   111 0000014B C3                  <1>     ret
   112                              <1> .n1:
   113 0000014C 3C2A                <1>     cmp al,'*'
   114 0000014E 7504                <1>     jne .n2
   115 00000150 B80F18              <1>     mov ax,180Fh                ; dim grey mine
   116 00000153 C3                  <1>     ret
   117                              <1> .n2:
   118 00000154 3C5E                <1>     cmp al,'^'
   119 00000156 7504                <1>     jne .n3
   120 00000158 B81E19              <1>     mov ax,191Eh                ; dim blue flag
   121 0000015B C3                  <1>     ret
   122                              <1> .n3:
   123 0000015C 3C31                <1>     cmp al,'1'
   124 0000015E 7212                <1>     jb .sp
   125 00000160 3C38                <1>     cmp al,'8'
   126 00000162 770E                <1>     ja .sp
   127 00000164 53                  <1>     push bx
   128 00000165 88C3                <1>     mov bl,al
   129 00000167 80EB31              <1>     sub bl,'1'
   130 0000016A 30FF                <1>     xor bh,bh
   131 0000016C 8AA7[1408]          <1>     mov ah,[nr_bg+bx]
   132 00000170 5B                  <1>     pop bx
   133 00000171 C3                  <1>     ret
   134                              <1> .sp:
   135 00000172 B82011              <1>     mov ax,1120h
   136 00000175 C3                  <1>     ret
   137                              <1> 
   138                              <1> ; Rainbow: row DH, AL = char; 80 cells cycling through rb_tab (bg black)
   139                              <1> Rainbow:
   140 00000176 60                  <1>     pusha
   141 00000177 06                  <1>     push es
   142 00000178 BB00B8              <1>     mov bx,0B800h
   143 0000017B 8EC3                <1>     mov es,bx
   144 0000017D 88C3                <1>     mov bl,al                   ; char
   145 0000017F B050                <1>     mov al,80
   146 00000181 F6E6                <1>     mul dh
   147 00000183 D1E0                <1>     shl ax,1
   148 00000185 89C7                <1>     mov di,ax
   149 00000187 B95000              <1>     mov cx,80
   150 0000018A 31F6                <1>     xor si,si
   151 0000018C FC                  <1>     cld
   152                              <1> .lp:
   153 0000018D 88D8                <1>     mov al,bl
   154 0000018F 8AA4[0808]          <1>     mov ah,[rb_tab+si]
   155 00000193 AB                  <1>     stosw
   156 00000194 46                  <1>     inc si
   157 00000195 83FE0C              <1>     cmp si,RBN
   158 00000198 7202                <1>     jb .n
   159 0000019A 31F6                <1>     xor si,si
   160                              <1> .n:
   161 0000019C E2EF                <1>     loop .lp
   162 0000019E 07                  <1>     pop es
   163 0000019F 61                  <1>     popa
   164 000001A0 C3                  <1>     ret
   165                              <1> 
   166                              <1> ; NumRow: row DH, centred "1 2 3 4 5 6 7 8" in minesweeper rainbow
   167                              <1> NumRow:
   168 000001A1 60                  <1>     pusha
   169 000001A2 B220                <1>     mov dl,32
   170 000001A4 31F6                <1>     xor si,si
   171 000001A6 B90800              <1>     mov cx,8
   172                              <1> .n:
   173 000001A9 89F0                <1>     mov ax,si
   174 000001AB 0431                <1>     add al,'1'
   175 000001AD A2[0608]            <1>     mov [nbuf],al
   176 000001B0 8A9C[1C08]          <1>     mov bl,[nr_stage+si]
   177 000001B4 56                  <1>     push si
   178 000001B5 BE[0608]            <1>     mov si,nbuf
   179 000001B8 E85300              <1>     call PrintA
   180 000001BB 5E                  <1>     pop si
   181 000001BC 46                  <1>     inc si
   182 000001BD 80C202              <1>     add dl,2
   183 000001C0 E2E7                <1>     loop .n
   184 000001C2 61                  <1>     popa
   185 000001C3 C3                  <1>     ret
   186                              <1> 
   187                              <1> ; WaitKey: AL = keypress, no echo
   188                              <1> WaitKey:
   189 000001C4 B407                <1>     mov ah,07h
   190 000001C6 CD21                <1>     int 21h
   191 000001C8 C3                  <1>     ret
   192                              <1> 
   193                              <1> ; GetKey: AL = key code, AH = 0 normal / 1 extended (arrows etc, AL=scan)
   194                              <1> GetKey:
   195 000001C9 B407                <1>     mov ah,07h
   196 000001CB CD21                <1>     int 21h
   197 000001CD 08C0                <1>     or al,al
   198 000001CF 7507                <1>     jnz .norm
   199 000001D1 B407                <1>     mov ah,07h
   200 000001D3 CD21                <1>     int 21h
   201 000001D5 B401                <1>     mov ah,1
   202 000001D7 C3                  <1>     ret
   203                              <1> .norm:
   204 000001D8 30E4                <1>     xor ah,ah
   205 000001DA C3                  <1>     ret
   206                              <1> 
   207                              <1> ; PrintStr: DS:SI -> $-terminated string via DOS (legacy helper)
   208                              <1> PrintStr:
   209 000001DB 60                  <1>     pusha
   210 000001DC 89F2                <1>     mov dx,si
   211 000001DE B409                <1>     mov ah,09h
   212 000001E0 CD21                <1>     int 21h
   213 000001E2 61                  <1>     popa
   214 000001E3 C3                  <1>     ret
   215                              <1> 
   216                              <1> ; PrintAttr: write 0-terminated string at the cursor, BL = colour attr
   217                              <1> ; (legacy BIOS version, kept for other modules)
   218                              <1> PrintAttr:
   219 000001E4 60                  <1>     pusha
   220                              <1> .ch:
   221 000001E5 AC                  <1>     lodsb
   222 000001E6 08C0                <1>     or al,al
   223 000001E8 7422                <1>     jz .done
   224 000001EA B409                <1>     mov ah,09h
   225 000001EC B700                <1>     mov bh,0
   226 000001EE B90100              <1>     mov cx,1
   227 000001F1 CD10                <1>     int 10h
   228 000001F3 50                  <1>     push ax
   229 000001F4 B403                <1>     mov ah,03h
   230 000001F6 B700                <1>     mov bh,0
   231 000001F8 CD10                <1>     int 10h
   232 000001FA FEC2                <1>     inc dl
   233 000001FC 80FA50              <1>     cmp dl,80
   234 000001FF 7204                <1>     jb .set
   235 00000201 30D2                <1>     xor dl,dl
   236 00000203 FEC6                <1>     inc dh
   237                              <1> .set:
   238 00000205 B402                <1>     mov ah,02h
   239 00000207 CD10                <1>     int 10h
   240 00000209 58                  <1>     pop ax
   241 0000020A EBD9                <1>     jmp .ch
   242                              <1> .done:
   243 0000020C 61                  <1>     popa
   244 0000020D C3                  <1>     ret
   245                              <1> 
   246                              <1> ; PrintA: DH=row DL=col BL=attr SI->0-terminated string
   247                              <1> ; Writes directly to video RAM, clipped at column 80. Cursor untouched.
   248                              <1> PrintA:
   249 0000020E 60                  <1>     pusha
   250 0000020F 06                  <1>     push es
   251 00000210 B800B8              <1>     mov ax,0B800h
   252 00000213 8EC0                <1>     mov es,ax
   253 00000215 88D1                <1>     mov cl,dl
   254 00000217 80F950              <1>     cmp cl,80
   255 0000021A 7321                <1>     jae .done
   256 0000021C B050                <1>     mov al,80
   257 0000021E F6E6                <1>     mul dh                      ; AX = row*80
   258 00000220 B650                <1>     mov dh,80
   259 00000222 28CE                <1>     sub dh,cl                   ; DH = cells left on this row
   260 00000224 30ED                <1>     xor ch,ch
   261 00000226 01C8                <1>     add ax,cx
   262 00000228 D1E0                <1>     shl ax,1
   263 0000022A 89C7                <1>     mov di,ax
   264 0000022C 88DC                <1>     mov ah,bl                   ; attribute
   265 0000022E FC                  <1>     cld
   266                              <1> .lp:
   267 0000022F 08F6                <1>     or dh,dh
   268 00000231 740A                <1>     jz .done
   269 00000233 AC                  <1>     lodsb
   270 00000234 08C0                <1>     or al,al
   271 00000236 7405                <1>     jz .done
   272 00000238 AB                  <1>     stosw
   273 00000239 FECE                <1>     dec dh
   274 0000023B EBF2                <1>     jmp .lp
   275                              <1> .done:
   276 0000023D 07                  <1>     pop es
   277 0000023E 61                  <1>     popa
   278 0000023F C3                  <1>     ret
   279                              <1> 
   280                              <1> ; PrintG: like PrintA, for block graphics.  ' ' is transparent,
   281                              <1> ;   '#' -> [g_full] (default DBh)   '^' -> upper half   '_' -> lower half
   282                              <1> PrintG:
