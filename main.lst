   110                              <1> ; -------------------------------------------------------------------
   111                              <1> ; Main Menu Music Player (PC speaker PIT channel 2, ports 42h/43h/61h)
   112                              <1> ; Uses track1 format: pairs of (PIT channel 2 divisor, duration in ms)
   113                              <1> ; 0 = rest, 0FFFFh = loop back to start.
   114                              <1> ; Steps in 10ms increments via INT 15h, AH=86h so the menu input loop
   115                              <1> ; remains completely responsive while playing.
   116                              <1> ; -------------------------------------------------------------------
   117                              <1> PlayMenuMusicStep:
   118 00003862 60                  <1>     pusha
   119 00003863 803E[ED64]01        <1>     cmp byte [MenuMusicOn], 1
   120 00003868 7569                <1>     jne .silence
   121                              <1> 
   122 0000386A 833E[F064]00        <1>     cmp word [MenuNoteLeft], 0
   123 0000386F 753C                <1>     jne .step_delay
   124                              <1> 
   125                              <1> .fetch_note:
   126 00003871 8B36[EE64]          <1>     mov si, [MenuMusicPtr]
   127 00003875 8B1C                <1>     mov bx, [si]
   128 00003877 83FBFF              <1>     cmp bx, 0FFFFh
   129 0000387A 7505                <1>     jne .valid_note
   130 0000387C BE[AD5C]            <1>     mov si, track3
   131 0000387F 8B1C                <1>     mov bx, [si]
   132                              <1> .valid_note:
   133 00003881 8B6C02              <1>     mov bp, [si+2]              ; duration ms
   134 00003884 83C604              <1>     add si, 4
   135 00003887 8936[EE64]          <1>     mov [MenuMusicPtr], si
   136 0000388B 892E[F064]          <1>     mov [MenuNoteLeft], bp
   137                              <1> 
   138 0000388F 85DB                <1>     test bx, bx
   139 00003891 7414                <1>     jz .rest
   140 00003893 B0B6                <1>     mov al, 0B6h
   141 00003895 E643                <1>     out 43h, al
   142 00003897 89D8                <1>     mov ax, bx
   143 00003899 E642                <1>     out 42h, al
   144 0000389B 88E0                <1>     mov al, ah
   145 0000389D E642                <1>     out 42h, al
   146 0000389F E461                <1>     in al, 61h
   147 000038A1 0C03                <1>     or al, 3
   148 000038A3 E661                <1>     out 61h, al
   149 000038A5 EB06                <1>     jmp .step_delay
   150                              <1> 
   151                              <1> .rest:
   152 000038A7 E461                <1>     in al, 61h
   153 000038A9 24FC                <1>     and al, 0FCh
   154 000038AB E661                <1>     out 61h, al
   155                              <1> 
   156                              <1> .step_delay:
   157 000038AD 803E[4E65]01        <1>     cmp byte [TestMode], 1
   158 000038B2 7409                <1>     je .no_delay
   159 000038B4 B486                <1>     mov ah, 86h
   160 000038B6 31C9                <1>     xor cx, cx
   161 000038B8 BA1027              <1>     mov dx, 10000               ; 10,000 us = 10 ms
   162 000038BB CD15                <1>     int 15h
   163                              <1> .no_delay:
   164 000038BD 833E[F064]0A        <1>     cmp word [MenuNoteLeft], 10
   165 000038C2 7607                <1>     jbe .note_end
   166 000038C4 832E[F064]0A        <1>     sub word [MenuNoteLeft], 10
   167 000038C9 EB11                <1>     jmp .done
   168                              <1> 
   169                              <1> .note_end:
   170 000038CB C706[F064]0000      <1>     mov word [MenuNoteLeft], 0
   171 000038D1 EB09                <1>     jmp .done
   172                              <1> 
   173                              <1> .silence:
   174 000038D3 E84B00              <1>     call SpeakerOff
   175 000038D6 C706[F064]0000      <1>     mov word [MenuNoteLeft], 0
   176                              <1> 
   177                              <1> .done:
   178 000038DC 61                  <1>     popa
   179 000038DD C3                  <1>     ret
   180                              <1> 
