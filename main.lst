   110                              <1> ; -------------------------------------------------------------------
   111                              <1> ; Main Menu Music Player (PC speaker PIT channel 2, ports 42h/43h/61h)
   112                              <1> ; Uses track1 format: pairs of (PIT channel 2 divisor, duration in ms)
   113                              <1> ; 0 = rest, 0FFFFh = loop back to start.
   114                              <1> ; Steps in 10ms increments via INT 15h, AH=86h so the menu input loop
   115                              <1> ; remains completely responsive while playing.
   116                              <1> ; -------------------------------------------------------------------
   117                              <1> PlayMenuMusicStep:
   118 00003608 60                  <1>     pusha
   119 00003609 803E[6962]01        <1>     cmp byte [MenuMusicOn], 1
   120 0000360E 7569                <1>     jne .silence
   121                              <1> 
   122 00003610 833E[6C62]00        <1>     cmp word [MenuNoteLeft], 0
   123 00003615 753C                <1>     jne .step_delay
   124                              <1> 
   125                              <1> .fetch_note:
   126 00003617 8B36[6A62]          <1>     mov si, [MenuMusicPtr]
   127 0000361B 8B1C                <1>     mov bx, [si]
   128 0000361D 83FBFF              <1>     cmp bx, 0FFFFh
   129 00003620 7505                <1>     jne .valid_note
   130 00003622 BE[295A]            <1>     mov si, track3
   131 00003625 8B1C                <1>     mov bx, [si]
   132                              <1> .valid_note:
   133 00003627 8B6C02              <1>     mov bp, [si+2]              ; duration ms
   134 0000362A 83C604              <1>     add si, 4
   135 0000362D 8936[6A62]          <1>     mov [MenuMusicPtr], si
   136 00003631 892E[6C62]          <1>     mov [MenuNoteLeft], bp
   137                              <1> 
   138 00003635 85DB                <1>     test bx, bx
   139 00003637 7414                <1>     jz .rest
   140 00003639 B0B6                <1>     mov al, 0B6h
   141 0000363B E643                <1>     out 43h, al
   142 0000363D 89D8                <1>     mov ax, bx
   143 0000363F E642                <1>     out 42h, al
   144 00003641 88E0                <1>     mov al, ah
   145 00003643 E642                <1>     out 42h, al
   146 00003645 E461                <1>     in al, 61h
   147 00003647 0C03                <1>     or al, 3
   148 00003649 E661                <1>     out 61h, al
   149 0000364B EB06                <1>     jmp .step_delay
   150                              <1> 
   151                              <1> .rest:
   152 0000364D E461                <1>     in al, 61h
   153 0000364F 24FC                <1>     and al, 0FCh
   154 00003651 E661                <1>     out 61h, al
   155                              <1> 
   156                              <1> .step_delay:
   157 00003653 803E[CA62]01        <1>     cmp byte [TestMode], 1
   158 00003658 7409                <1>     je .no_delay
   159 0000365A B486                <1>     mov ah, 86h
   160 0000365C 31C9                <1>     xor cx, cx
   161 0000365E BA1027              <1>     mov dx, 10000               ; 10,000 us = 10 ms
   162 00003661 CD15                <1>     int 15h
   163                              <1> .no_delay:
   164 00003663 833E[6C62]0A        <1>     cmp word [MenuNoteLeft], 10
   165 00003668 7607                <1>     jbe .note_end
   166 0000366A 832E[6C62]0A        <1>     sub word [MenuNoteLeft], 10
   167 0000366F EB11                <1>     jmp .done
   168                              <1> 
   169                              <1> .note_end:
   170 00003671 C706[6C62]0000      <1>     mov word [MenuNoteLeft], 0
   171 00003677 EB09                <1>     jmp .done
   172                              <1> 
   173                              <1> .silence:
   174 00003679 E84B00              <1>     call SpeakerOff
   175 0000367C C706[6C62]0000      <1>     mov word [MenuNoteLeft], 0
   176                              <1> 
   177                              <1> .done:
   178 00003682 61                  <1>     popa
   179 00003683 C3                  <1>     ret
   180                              <1> 
   181                              <1> ; ToggleMenuMusic: toggles menu music on/off, silences speaker if off
   182                              <1> ToggleMenuMusic:
   183 00003684 50                  <1>     push ax
   184 00003685 8036[6962]01        <1>     xor byte [MenuMusicOn], 1
   185 0000368A 803E[6962]01        <1>     cmp byte [MenuMusicOn], 1
   186 0000368F 740B                <1>     je .turned_on
   187 00003691 E83300              <1>     call SpeakerOff
   188 00003694 C706[6C62]0000      <1>     mov word [MenuNoteLeft], 0
   189 0000369A EB0C                <1>     jmp .done
