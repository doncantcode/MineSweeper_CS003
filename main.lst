    51 00000B3F A2[8114]            <1>     mov [FillCol],al
    52 00000B42 A1[8514]            <1>     mov ax,[BvX]
    53 00000B45 8B1E[8714]          <1>     mov bx,[BvY]
    54 00000B49 8B0E[8914]          <1>     mov cx,[BvW]
    55 00000B4D 83E902              <1>     sub cx,2
    56 00000B50 8B16[8B14]          <1>     mov dx,[BvH]
