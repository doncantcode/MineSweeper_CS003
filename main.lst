   878                              <1> ; --- main menu ------------------------------------------------------
   879                              <1> 
   880                              <1> MainMenu:
   881 000006DE 803E[4024]00        <1>     cmp byte [IntroShown],0
   882 000006E3 7503                <1>     jne .loop
   883 000006E5 E8E7FE              <1>     call ShowIntro
   884                              <1> .loop:
   885 000006E8 BE[B107]            <1>     mov si,menu_main
   886 000006EB 30C0                <1>     xor al,al
   887 000006ED E82EFC              <1>     call RunMenu
   888 000006F0 3CFF                <1>     cmp al,0FFh                 ; Esc on the main menu: ignore
   889 000006F2 74F4                <1>     je .loop
   890 000006F4 3C01                <1>     cmp al,1
   891 000006F6 7413                <1>     je .credits
   892 000006F8 3C02                <1>     cmp al,2
   893 000006FA 7417                <1>     je .exit
   894                              <1> .play:
   895 000006FC E81700              <1>     call ModeMenu               ; AL=0 -> Back to main menu
   896 000006FF 08C0                <1>     or al,al
   897 00000701 74E5                <1>     jz .loop
   898 00000703 E82C00              <1>     call ClassMenu              ; AL=0 -> Back to gamemode
   899 00000706 08C0                <1>     or al,al
   900 00000708 74F2                <1>     jz .play
   901 0000070A C3                  <1>     ret                         ; mode + class set: boot the game
