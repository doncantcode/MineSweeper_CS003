    47                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 00001C9E BA1200              <1>     mov dx,0012h
    10 00001CA1 B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 00001CA4 F7F3                <1>     div bx                      ; AX = PIT divisor
    12 00001CA6 89C3                <1>     mov bx,ax
    13 00001CA8 B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 00001CAA E643                <1>     out 43h,al
    15 00001CAC 88D8                <1>     mov al,bl
    16 00001CAE E642                <1>     out 42h,al
    17 00001CB0 88F8                <1>     mov al,bh
    18 00001CB2 E642                <1>     out 42h,al
    19 00001CB4 E461                <1>     in al,61h
    20 00001CB6 0C03                <1>     or al,3                     ; gate + speaker on
    21 00001CB8 E661                <1>     out 61h,al
    22 00001CBA C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00001CBB E461                <1>     in al,61h
    26 00001CBD 24FC                <1>     and al,0FCh
    27 00001CBF E661                <1>     out 61h,al
    28 00001CC1 C3                  <1>     ret
