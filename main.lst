    39 00000B1C 890E[8914]          <1>     mov [BvW],cx
    40 00000B20 8916[8B14]          <1>     mov [BvH],dx
    41                              <1> 
    42 00000B24 A0[8314]            <1>     mov al,[BevBR]              ; whole rect in bottom/right colour
    43 00000B27 A2[8114]            <1>     mov [FillCol],al
    44 00000B2A A1[8514]            <1>     mov ax,[BvX]
    45 00000B2D 8B1E[8714]          <1>     mov bx,[BvY]
    46 00000B31 8B0E[8914]          <1>     mov cx,[BvW]
    47 00000B35 8B16[8B14]          <1>     mov dx,[BvH]
    48 00000B39 E8ABFF              <1>     call FillRect
