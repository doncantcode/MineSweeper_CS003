    92 00000B9A 89C1                <1>     mov cx,ax
    93 00000B9C AC                  <1>     lodsb
    94 00000B9D 30E4                <1>     xor ah,ah
    95 00000B9F 89C2                <1>     mov dx,ax
    96 00000BA1 AC                  <1>     lodsb
    97 00000BA2 A2[8114]            <1>     mov [FillCol],al
    98 00000BA5 58                  <1>     pop ax
