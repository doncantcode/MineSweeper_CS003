   264                              <1> ; -------------------------------------------------------------------
   265                              <1> ; ScanArea: mage remote scan.  Marks (flags) every mine in the 3x3
   266                              <1> ; around DH:DL (row:col) purely in memory - never runs detonation
   267                              <1> ; logic.  Off-board neighbours are skipped, already-flagged mines
   268                              <1> ; stay flagged.
   269                              <1> ; -------------------------------------------------------------------
   270                              <1> ScanArea:
   271 00000C59 60                  <1>     pusha
   272 00000C5A 88F0                <1>     mov al,dh
   273 00000C5C 30E4                <1>     xor ah,ah
   274 00000C5E 89C5                <1>     mov bp,ax                   ; centre row
   275 00000C60 88D0                <1>     mov al,dl
   276 00000C62 30E4                <1>     xor ah,ah
   277 00000C64 89C7                <1>     mov di,ax                   ; centre col
   278 00000C66 BEFFFF              <1>     mov si,-1                   ; dy
   279                              <1> .dyloop:
   280 00000C69 BAFFFF              <1>     mov dx,-1                   ; dx
   281                              <1> .dxloop:
   282 00000C6C 89E8                <1>     mov ax,bp
   283 00000C6E 01F0                <1>     add ax,si                   ; r = row + dy
   284 00000C70 89FB                <1>     mov bx,di
   285 00000C72 01D3                <1>     add bx,dx                   ; c = col + dx
   286 00000C74 83F800              <1>     cmp ax,0
   287 00000C77 7C29                <1>     jl .next
   288 00000C79 83F809              <1>     cmp ax,GRID_ROWS
   289 00000C7C 7D24                <1>     jge .next
   290 00000C7E 83FB00              <1>     cmp bx,0
   291 00000C81 7C1F                <1>     jl .next
   292 00000C83 83FB09              <1>     cmp bx,GRID_COLS
   293 00000C86 7D1A                <1>     jge .next
   294 00000C88 89C1                <1>     mov cx,ax
   295 00000C8A 01C9                <1>     add cx,cx
   296 00000C8C 01C9                <1>     add cx,cx
   297 00000C8E 01C9                <1>     add cx,cx
   298 00000C90 01C1                <1>     add cx,ax                   ; cx = 9r
   299 00000C92 01D9                <1>     add cx,bx                   ; cx = 9r + c
   300 00000C94 89CB                <1>     mov bx,cx
   301 00000C96 F687[9719]01        <1>     test byte [Board+bx],1      ; a mine?
   302 00000C9B 7405                <1>     jz .next
   303 00000C9D 808F[9719]04        <1>     or byte [Board+bx],4        ; mark it with the flag bit
   304                              <1> .next:
   305 00000CA2 42                  <1>     inc dx
   306 00000CA3 83FA01              <1>     cmp dx,1
   307 00000CA6 7EC4                <1>     jle .dxloop
   308 00000CA8 46                  <1>     inc si
   309 00000CA9 83FE01              <1>     cmp si,1
   310 00000CAC 7EBB                <1>     jle .dyloop
   311 00000CAE 61                  <1>     popa
   312 00000CAF C3                  <1>     ret
    37                                  %include "src/timer.asm"        ; seconds counter on BIOS ticks
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Timer (BIOS ticks: 18.2/s -> 5 units per tick, 91 units per second)
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> UpdateTimer:
     5 00000CB0 60                  <1>     pusha
     6 00000CB1 B400                <1>     mov ah,00h
     7 00000CB3 CD1A                <1>     int 1Ah
     8 00000CB5 89D0                <1>     mov ax,dx
     9 00000CB7 2B06[9119]          <1>     sub ax,[LastTick]
    10 00000CBB 7479                <1>     jz .done
    11 00000CBD 8916[9119]          <1>     mov [LastTick],dx
    12 00000CC1 50                  <1>     push ax
    13 00000CC2 E87300              <1>     call MusicStep              ; AX = ticks elapsed
    14 00000CC5 58                  <1>     pop ax
    15 00000CC6 803E[8C19]00        <1>     cmp byte [TimerOn],0
    16 00000CCB 7469                <1>     je .done
    17 00000CCD BB0500              <1>     mov bx,5
    18 00000CD0 F7E3                <1>     mul bx
    19 00000CD2 0106[8F19]          <1>     add [TickAcc],ax
    20 00000CD6 30DB                <1>     xor bl,bl
    21                              <1> .sec:
    22 00000CD8 833E[8F19]5B        <1>     cmp word [TickAcc],91
    23 00000CDD 7250                <1>     jb .chk
    24 00000CDF 832E[8F19]5B        <1>     sub word [TickAcc],91
    25                              <1>     ; Rapid mode counts down instead of up
    26 00000CE4 803E[E819]02        <1>     cmp byte [CurrentMode],2
    27 00000CE9 7410                <1>     je .rapid
    28                              <1> 
    29                              <1>     ; Normal timer for Vanilla / other modes
    30 00000CEB 813E[8D19]E703      <1>     cmp word [Seconds],999
    31 00000CF1 73E5                <1>     jae .sec
    32 00000CF3 FF06[8D19]          <1>     inc word [Seconds]
    33 00000CF7 B301                <1>     mov bl,1
    34 00000CF9 EBDD                <1>     jmp .sec
    35                              <1> 
    36                              <1> .rapid:
    37 00000CFB 833E[8D19]00        <1>     cmp word [Seconds],0
    38 00000D00 740F                <1>     je .rapidTimeout
    39                              <1> 
    40 00000D02 FF0E[8D19]          <1>     dec word [Seconds]
    41 00000D06 B301                <1>     mov bl,1
    42                              <1> 
    43 00000D08 833E[8D19]00        <1>     cmp word [Seconds],0
    44 00000D0D 7402                <1>     je .rapidTimeout
    45                              <1> 
    46 00000D0F EBC7                <1>     jmp .sec
    47                              <1> 
    48                              <1> .rapidTimeout:
    49 00000D11 C606[8A19]01        <1>     mov byte [GameOver],1
    50 00000D16 C606[8C19]00        <1>     mov byte [TimerOn],0
    51 00000D1B C706[9319]FFFF      <1>     mov word [HitCell],0FFFFh
    52                              <1> 
    53 00000D21 E8DEFE              <1>     call RevealMines
    54 00000D24 E8D305              <1>     call Redraw
    55                              <1> 
    56 00000D27 BE[D818]            <1>     mov si,SfxBoom
    57 00000D2A E8B500              <1>     call StartSfx
    58                              <1> 
    59 00000D2D EB07                <1>     jmp .done
    60                              <1> 
    61                              <1> .chk:
    62 00000D2F 08DB                <1>     or bl,bl
    63 00000D31 7403                <1>     jz .done
    64 00000D33 E8DA05              <1>     call DrawTimer
    65                              <1> .done:
    66 00000D36 61                  <1>     popa
    67 00000D37 C3                  <1>     ret
    38                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 00000D38 60                  <1>     pusha
    10 00000D39 803E[6119]00        <1>     cmp byte [SfxOn],0
    11 00000D3E 741D                <1>     je .music
    12 00000D40 8B1E[6419]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00000D44 39D8                <1>     cmp ax,bx
    14 00000D46 7205                <1>     jb .sfxhold
    15 00000D48 E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 00000D4B EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00000D4D 29C3                <1>     sub bx,ax
    19 00000D4F 891E[6419]          <1>     mov [SfxLeft],bx
    20 00000D53 83FB01              <1>     cmp bx,1
    21 00000D56 774D                <1>     ja .done
    22 00000D58 E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 00000D5B EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00000D5D 803E[5C19]00        <1>     cmp byte [MusicOn],0
    27 00000D62 7441                <1>     je .done
    28 00000D64 8B1E[5D19]          <1>     mov bx,[NoteLeft]
    29 00000D68 39D8                <1>     cmp ax,bx
    30 00000D6A 7310                <1>     jae .next                   ; current note finished
    31 00000D6C 29C3                <1>     sub bx,ax
    32 00000D6E 891E[5D19]          <1>     mov [NoteLeft],bx
    33 00000D72 83FB01              <1>     cmp bx,1
    34 00000D75 772E                <1>     ja .done
    35 00000D77 E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 00000D7A EB29                <1>     jmp .done
    37                              <1> .next:
    38 00000D7C 8B36[5F19]          <1>     mov si,[MusicPtr]
    39 00000D80 8B1C                <1>     mov bx,[si]
    40 00000D82 83FBFF              <1>     cmp bx,0FFFFh
    41 00000D85 7505                <1>     jne .play
    42 00000D87 BE[F816]            <1>     mov si,SongTable            ; end of tune -> loop
    43 00000D8A 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00000D8C 8B4402              <1>     mov ax,[si+2]
    46 00000D8F A3[5D19]            <1>     mov [NoteLeft],ax
    47 00000D92 83C604              <1>     add si,4
    48 00000D95 8936[5F19]          <1>     mov [MusicPtr],si
    49 00000D99 09DB                <1>     or bx,bx
    50 00000D9B 7405                <1>     jz .rest
    51 00000D9D E87100              <1>     call SpeakerOn
    52 00000DA0 EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00000DA2 E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 00000DA5 61                  <1>     popa
    57 00000DA6 C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 00000DA7 60                  <1>     pusha
    63 00000DA8 8B36[6219]          <1>     mov si,[SfxPtr]
    64 00000DAC 8B1C                <1>     mov bx,[si]
    65 00000DAE 83FBFF              <1>     cmp bx,0FFFFh
    66 00000DB1 741B                <1>     je .end
    67 00000DB3 8B4402              <1>     mov ax,[si+2]
    68 00000DB6 A3[6419]            <1>     mov [SfxLeft],ax
    69 00000DB9 83C604              <1>     add si,4
    70 00000DBC 8936[6219]          <1>     mov [SfxPtr],si
    71 00000DC0 09DB                <1>     or bx,bx
    72 00000DC2 7405                <1>     jz .rest
    73 00000DC4 E84A00              <1>     call SpeakerOn
    74 00000DC7 61                  <1>     popa
    75 00000DC8 C3                  <1>     ret
    76                              <1> .rest:
    77 00000DC9 E86200              <1>     call SpeakerOff
    78 00000DCC 61                  <1>     popa
    79 00000DCD C3                  <1>     ret
    80                              <1> .end:
    81 00000DCE C606[6119]00        <1>     mov byte [SfxOn],0
    82 00000DD3 C706[5D19]0000      <1>     mov word [NoteLeft],0
    83 00000DD9 BE[F816]            <1>     mov si,SongTable
    84 00000DDC 8936[5F19]          <1>     mov [MusicPtr],si
    85 00000DE0 61                  <1>     popa
    86 00000DE1 C3                  <1>     ret
    87                              <1> 
    88                              <1> ; Start effect whose table address is in SI (music is silenced first)
    89                              <1> StartSfx:
    90 00000DE2 53                  <1>     push bx
    91 00000DE3 56                  <1>     push si
    92 00000DE4 E84700              <1>     call SpeakerOff
    93 00000DE7 8936[6219]          <1>     mov [SfxPtr],si
    94 00000DEB C606[6119]01        <1>     mov byte [SfxOn],1
    95 00000DF0 E8B4FF              <1>     call SfxAdvance
    96 00000DF3 5E                  <1>     pop si
    97 00000DF4 5B                  <1>     pop bx
    98 00000DF5 C3                  <1>     ret
    99                              <1> 
   100                              <1> ToggleMusic:
   101 00000DF6 8036[5C19]01        <1>     xor byte [MusicOn],1
   102 00000DFB C706[5D19]0000      <1>     mov word [NoteLeft],0
   103 00000E01 803E[5C19]00        <1>     cmp byte [MusicOn],0
   104 00000E06 7508                <1>     jne .r
   105 00000E08 C606[6119]00        <1>     mov byte [SfxOn],0
   106 00000E0D E81E00              <1>     call SpeakerOff
   107                              <1> .r:
   108 00000E10 C3                  <1>     ret
    39                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 00000E11 BA1200              <1>     mov dx,0012h
    10 00000E14 B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 00000E17 F7F3                <1>     div bx                      ; AX = PIT divisor
    12 00000E19 89C3                <1>     mov bx,ax
    13 00000E1B B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 00000E1D E643                <1>     out 43h,al
    15 00000E1F 88D8                <1>     mov al,bl
    16 00000E21 E642                <1>     out 42h,al
    17 00000E23 88F8                <1>     mov al,bh
    18 00000E25 E642                <1>     out 42h,al
    19 00000E27 E461                <1>     in al,61h
    20 00000E29 0C03                <1>     or al,3                     ; gate + speaker on
    21 00000E2B E661                <1>     out 61h,al
    22 00000E2D C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 00000E2E E461                <1>     in al,61h
    26 00000E30 24FC                <1>     and al,0FCh
    27 00000E32 E661                <1>     out 61h,al
    28 00000E34 C3                  <1>     ret
    40                                  %include "src/input.asm"        ; mouse click handling
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Mouse click handling.  MouseX/MouseY = pixel, PrevMouse = buttons
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> HandleClick:
     5 00000E35 60                  <1>     pusha
     6                              <1> 
     7                              <1>     ; --- face button (new game) ---
     8 00000E36 A1[8519]            <1>     mov ax,[MouseX]
     9 00000E39 3D9500              <1>     cmp ax,149
    10 00000E3C 7C21                <1>     jl .board
    11 00000E3E 3DAB00              <1>     cmp ax,171
    12 00000E41 7D1C                <1>     jge .board
    13 00000E43 A1[8719]            <1>     mov ax,[MouseY]
    14 00000E46 83F80C              <1>     cmp ax,12
    15 00000E49 7C14                <1>     jl .board
    16 00000E4B 83F822              <1>     cmp ax,34
    17 00000E4E 7D0F                <1>     jge .board
    18 00000E50 F606[8919]01        <1>     test byte [PrevMouse],1
    19 00000E55 0F84F600            <1>     jz .out
    20 00000E59 E84FF2              <1>     call DoRestart
    21 00000E5C E9F000              <1>     jmp .out
    22                              <1> 
    23                              <1>     ; --- board ---
    24                              <1> .board:
    25 00000E5F 803E[8A19]00        <1>     cmp byte [GameOver],0
    26 00000E64 0F85E700            <1>     jne .out
    27                              <1> 
    28 00000E68 A1[8519]            <1>     mov ax,[MouseX]
    29 00000E6B 83E858              <1>     sub ax,START_X
    30 00000E6E 0F8CDD00            <1>     jl .out
    31 00000E72 3D9000              <1>     cmp ax,GRID_COLS*16
    32 00000E75 0F8DD600            <1>     jge .out
    33 00000E79 C1E804              <1>     shr ax,4
    34 00000E7C 88C2                <1>     mov dl,al                   ; column
    35 00000E7E A1[8719]            <1>     mov ax,[MouseY]
    36 00000E81 83E82D              <1>     sub ax,START_Y
    37 00000E84 0F8CC700            <1>     jl .out
    38 00000E88 3D9000              <1>     cmp ax,GRID_ROWS*16
    39 00000E8B 0F8DC000            <1>     jge .out
    40 00000E8F C1E804              <1>     shr ax,4
    41 00000E92 88C6                <1>     mov dh,al                   ; row
    42                              <1> 
    43 00000E94 88F7                <1>     mov bh,dh
    44 00000E96 88D3                <1>     mov bl,dl
    45 00000E98 E874FC              <1>     call CellIndex              ; SI = cell index
    46                              <1> 
    47 00000E9B F606[8919]01        <1>     test byte [PrevMouse],1
    48 00000EA0 750C                <1>     jnz .left
    49 00000EA2 F606[8919]02        <1>     test byte [PrevMouse],2
    50 00000EA7 0F859500            <1>     jnz .right
    51 00000EAB E9A100              <1>     jmp .out
    52                              <1> 
    53                              <1> .left:
    54 00000EAE 803E[EC19]00        <1>     cmp byte [ScanArmed],0      ; mage scanner armed?
    55 00000EB3 7419                <1>     je .plainLeft
    56 00000EB5 C606[EC19]00        <1>     mov byte [ScanArmed],0
    57 00000EBA 803E[EB19]00        <1>     cmp byte [MageScans],0
    58 00000EBF 740D                <1>     je .plainLeft               ; no charges: click opens normally
    59 00000EC1 FE0E[EB19]          <1>     dec byte [MageScans]
    60 00000EC5 E891FD              <1>     call ScanArea               ; DH:DL still hold the target cell
    61 00000EC8 E82F04              <1>     call Redraw
    62 00000ECB E98100              <1>     jmp .out
    63                              <1> .plainLeft:
    64 00000ECE F684[9719]06        <1>     test byte [Board+si],6      ; flagged or already open
    65 00000ED3 757A                <1>     jnz .out
    66 00000ED5 803E[8B19]00        <1>     cmp byte [Started],0
    67 00000EDA 751A                <1>     jne .go
    68 00000EDC C606[8B19]01        <1>     mov byte [Started],1        ; first click: start timer, be safe
    69 00000EE1 C606[8C19]01        <1>     mov byte [TimerOn],1
    70 00000EE6 C706[8F19]0000      <1>     mov word [TickAcc],0
    71 00000EEC F684[9719]01        <1>     test byte [Board+si],1
    72 00000EF1 7403                <1>     jz .go
    73 00000EF3 E89DFC              <1>     call RelocateMine
    74                              <1> .go:
    75 00000EF6 F684[9719]01        <1>     test byte [Board+si],1
    76 00000EFB 750B                <1>     jnz .boom
    77 00000EFD E8AFFC              <1>     call RevealCell
    78 00000F00 E81BFD              <1>     call CheckWin
    79 00000F03 E8F403              <1>     call Redraw
    80 00000F06 EB47                <1>     jmp .out
    81                              <1> .boom:
    82 00000F08 803E[E919]01        <1>     cmp byte [SelectedClass],1  ; tank with a shield left?
    83 00000F0D 7515                <1>     jne .realBoom
    84 00000F0F 803E[EA19]00        <1>     cmp byte [TankShield],0
    85 00000F14 740E                <1>     je .realBoom
    86 00000F16 FE0E[EA19]          <1>     dec byte [TankShield]       ; absorb the blast...
    87 00000F1A 808C[9719]04        <1>     or byte [Board+si],4        ; ...and pin the mine: flag stays down
    88 00000F1F E8D803              <1>     call Redraw
    89 00000F22 EB2B                <1>     jmp .out
    90                              <1> .realBoom:
    91 00000F24 C606[8A19]01        <1>     mov byte [GameOver],1
    92 00000F29 C606[8C19]00        <1>     mov byte [TimerOn],0
    93 00000F2E 8936[9319]          <1>     mov [HitCell],si
    94 00000F32 E8CDFC              <1>     call RevealMines
    95 00000F35 E8C203              <1>     call Redraw
    96 00000F38 BE[D818]            <1>     mov si,SfxBoom
    97 00000F3B E8A4FE              <1>     call StartSfx
    98 00000F3E EB0F                <1>     jmp .out
    99                              <1> 
   100                              <1> .right:
   101 00000F40 F684[9719]02        <1>     test byte [Board+si],2      ; can't flag an open tile
   102 00000F45 7508                <1>     jnz .out
   103 00000F47 80B4[9719]04        <1>     xor byte [Board+si],4       ; toggle flag
   104 00000F4C E8AB03              <1>     call Redraw
   105                              <1> 
   106                              <1> .out:
   107 00000F4F 61                  <1>     popa
   108 00000F50 C3                  <1>     ret
    41                                  %include "src/video.asm"        ; FillRect/bevel/sprite/glyph primitives
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Drawing primitives
     3                              <1> ; -------------------------------------------------------------------
     4                              <1> ; FillRect: AX=x BX=y CX=w DX=h, colour in [FillCol]
     5                              <1> FillRect:
     6 00000F51 60                  <1>     pusha
     7 00000F52 06                  <1>     push es
     8 00000F53 FC                  <1>     cld
     9 00000F54 89DF                <1>     mov di,bx
    10 00000F56 C1E708              <1>     shl di,8
    11 00000F59 C1E306              <1>     shl bx,6
    12 00000F5C 01DF                <1>     add di,bx
    13 00000F5E 01C7                <1>     add di,ax                   ; DI = y*320 + x
    14 00000F60 B800A0              <1>     mov ax,0A000h
    15 00000F63 8EC0                <1>     mov es,ax
    16 00000F65 A0[6619]            <1>     mov al,[FillCol]
    17 00000F68 89D5                <1>     mov bp,dx
    18 00000F6A 09ED                <1>     or bp,bp
    19 00000F6C 740D                <1>     jz .end
    20                              <1> .row:
    21 00000F6E 57                  <1>     push di
    22 00000F6F 51                  <1>     push cx
    23 00000F70 F3AA                <1>     rep stosb
    24 00000F72 59                  <1>     pop cx
    25 00000F73 5F                  <1>     pop di
    26 00000F74 81C74001            <1>     add di,320
    27 00000F78 4D                  <1>     dec bp
    28 00000F79 75F3                <1>     jnz .row
    29                              <1> .end:
    30 00000F7B 07                  <1>     pop es
    31 00000F7C 61                  <1>     popa
    32 00000F7D C3                  <1>     ret
    33                              <1> 
    34                              <1> ; DrawBevel: AX=x BX=y CX=w DX=h ; [BevTL] [BevBR] [BevFace]
    35                              <1> DrawBevel:
    36 00000F7E 60                  <1>     pusha
    37 00000F7F A3[6A19]            <1>     mov [BvX],ax
    38 00000F82 891E[6C19]          <1>     mov [BvY],bx
    39 00000F86 890E[6E19]          <1>     mov [BvW],cx
    40 00000F8A 8916[7019]          <1>     mov [BvH],dx
    41                              <1> 
    42 00000F8E A0[6819]            <1>     mov al,[BevBR]              ; whole rect in bottom/right colour
    43 00000F91 A2[6619]            <1>     mov [FillCol],al
    44 00000F94 A1[6A19]            <1>     mov ax,[BvX]
    45 00000F97 8B1E[6C19]          <1>     mov bx,[BvY]
    46 00000F9B 8B0E[6E19]          <1>     mov cx,[BvW]
    47 00000F9F 8B16[7019]          <1>     mov dx,[BvH]
    48 00000FA3 E8ABFF              <1>     call FillRect
    49                              <1> 
    50 00000FA6 A0[6719]            <1>     mov al,[BevTL]              ; top/left highlight
    51 00000FA9 A2[6619]            <1>     mov [FillCol],al
    52 00000FAC A1[6A19]            <1>     mov ax,[BvX]
    53 00000FAF 8B1E[6C19]          <1>     mov bx,[BvY]
    54 00000FB3 8B0E[6E19]          <1>     mov cx,[BvW]
    55 00000FB7 83E902              <1>     sub cx,2
    56 00000FBA 8B16[7019]          <1>     mov dx,[BvH]
    57 00000FBE 83EA02              <1>     sub dx,2
    58 00000FC1 E88DFF              <1>     call FillRect
    59                              <1> 
    60 00000FC4 A0[6919]            <1>     mov al,[BevFace]            ; face
    61 00000FC7 A2[6619]            <1>     mov [FillCol],al
    62 00000FCA A1[6A19]            <1>     mov ax,[BvX]
    63 00000FCD 83C002              <1>     add ax,2
    64 00000FD0 8B1E[6C19]          <1>     mov bx,[BvY]
    65 00000FD4 83C302              <1>     add bx,2
    66 00000FD7 8B0E[6E19]          <1>     mov cx,[BvW]
    67 00000FDB 83E904              <1>     sub cx,4
    68 00000FDE 8B16[7019]          <1>     mov dx,[BvH]
    69 00000FE2 83EA04              <1>     sub dx,4
    70 00000FE5 E869FF              <1>     call FillRect
    71 00000FE8 61                  <1>     popa
    72 00000FE9 C3                  <1>     ret
    73                              <1> 
