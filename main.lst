    35                                  %include "src/menu.asm"         ; main menu, mode/shop menus
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Text-mode front end (80x25) - v3 menu UI
     3                              <1> ;   * big block-letter MINESWEEPER logo, ice-white to steel-blue + shadow
     4                              <1> ;   * dimmed minefield backdrop so menu details stand out
     5                              <1> ;   * steel-blue pinstripes framing the black masthead / stage
     6                              <1> ;   * one data-driven menu engine (RunMenu) used by main/mode/shop
     7                              <1> ;   * arrow keys / W,S + Enter, number hotkeys, Esc = back
     8                              <1> ;   * highlight bar, per-item description line, locked-item styling
     9                              <1> ;   * everything drawn straight into video RAM (B800h): no flicker
    10                              <1> ; [CurrentMode] values unchanged (0 vanilla, 1 endless, 2 rapid).
    11                              <1> ; Only background colours 0-7 are used, so the BIOS blink bit is
    12                              <1> ; never an issue.
    13                              <1> ; -------------------------------------------------------------------
    14                              <1> 
    15                              <1> PC          equ 15              ; panel left column (panel is 50 wide, centred)
    16                              <1> RBN         equ 12              ; entries in the rainbow palette
    17                              <1> 
    18                              <1> ; --- low-level helpers ----------------------------------------------
    19                              <1> 
    20                              <1> ; ClearScr: fresh 80x25 mode, cleared to blue/white chrome
    21                              <1> ClearScr:
    22 00001407 60                  <1>     pusha
    23 00001408 B80300              <1>     mov ax,0003h
    24 0000140B CD10                <1>     int 10h
    25 0000140D B80006              <1>     mov ax,0600h
    26 00001410 B71F                <1>     mov bh,1Fh
    27 00001412 B90000              <1>     mov cx,0000h
    28 00001415 BA4F18              <1>     mov dx,184Fh
    29 00001418 CD10                <1>     int 10h
    30 0000141A B402                <1>     mov ah,02h
    31 0000141C B700                <1>     mov bh,0
    32 0000141E 31D2                <1>     xor dx,dx
    33 00001420 CD10                <1>     int 10h
    34 00001422 E80200              <1>     call HideCursor             ; a mode reset brings the cursor back
    35 00001425 61                  <1>     popa
    36 00001426 C3                  <1>     ret
    37                              <1> 
    38                              <1> ; HideCursor: hide the blinking text-mode cursor (menus draw straight
    39                              <1> ; to video RAM, so a visible cursor just blinks in the top-left corner)
    40                              <1> HideCursor:
    41 00001427 60                  <1>     pusha
    42 00001428 B401                <1>     mov ah,01h
    43 0000142A B90020              <1>     mov cx,2000h
    44 0000142D CD10                <1>     int 10h
    45 0000142F 61                  <1>     popa
    46 00001430 C3                  <1>     ret
    47                              <1> 
    48                              <1> ; ClearFast: clear to blue/white WITHOUT a mode reset (no flicker)
    49                              <1> ClearFast:
    50 00001431 60                  <1>     pusha
    51 00001432 B80006              <1>     mov ax,0600h
    52 00001435 B71F                <1>     mov bh,1Fh
    53 00001437 31C9                <1>     xor cx,cx
    54 00001439 BA4F18              <1>     mov dx,184Fh
    55 0000143C CD10                <1>     int 10h
    56 0000143E 61                  <1>     popa
    57 0000143F C3                  <1>     ret
    58                              <1> 
