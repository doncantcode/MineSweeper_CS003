   772 000033DB F636[0062]          <1>     div byte [CurCols]          ; AL = row, AH = col
   773 000033DF 88C7                <1>     mov bh, al
   774 000033E1 88E3                <1>     mov bl, ah
   775 000033E3 E889FC              <1>     call RevealCell
   776                              <1> .nextCell:
