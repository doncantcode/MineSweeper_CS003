    83 00002C35 A2[E464]            <1>     mov [SelectedClass],al
    84 00002C38 803E[CB64]0C        <1>     cmp byte [LoadValid],12
    85 00002C3D 7238                <1>     jb .defaults
    86 00002C3F BE[D464]            <1>     mov si,SaveBuffer+8         ; potions, clamped to the carry limit
    87 00002C42 BF[C064]            <1>     mov di,PotionOracle
