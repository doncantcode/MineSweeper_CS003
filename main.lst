    49 00000445 C606[0410]01        <1>     mov byte [GameOver],1
    50 0000044A C606[0610]00        <1>     mov byte [TimerOn],0
    51 0000044F C706[0D10]FFFF      <1>     mov word [HitCell],0FFFFh
    52                              <1> 
