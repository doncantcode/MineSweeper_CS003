   193                              <1> .done:
   194 000036A8 58                  <1>     pop ax
   195 000036A9 C3                  <1>     ret
    42                                  %include "src/pcspeaker.asm"    ; PIT / port 61h hardware layer
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; PC speaker hardware driver: PIT channel 2 (ports 42h/43h) plus the
     3                              <1> ; port 61h gate.  SpeakerOn takes the frequency in Hz in BX.
     4                              <1> ;
     5                              <1> ; This is the only module that touches the speaker hardware; the
     6                              <1> ; sequencing logic in audio.asm is written against these two calls.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> SpeakerOn:
     9 000036AA BA1200              <1>     mov dx,0012h
    10 000036AD B8DE34              <1>     mov ax,34DEh                ; DX:AX = 1193182 (PIT clock)
    11 000036B0 F7F3                <1>     div bx                      ; AX = PIT divisor
    12 000036B2 89C3                <1>     mov bx,ax
    13 000036B4 B0B6                <1>     mov al,0B6h                 ; channel 2, lo/hi, square wave
    14 000036B6 E643                <1>     out 43h,al
    15 000036B8 88D8                <1>     mov al,bl
    16 000036BA E642                <1>     out 42h,al
    17 000036BC 88F8                <1>     mov al,bh
    18 000036BE E642                <1>     out 42h,al
    19 000036C0 E461                <1>     in al,61h
    20 000036C2 0C03                <1>     or al,3                     ; gate + speaker on
    21 000036C4 E661                <1>     out 61h,al
    22 000036C6 C3                  <1>     ret
    23                              <1> 
    24                              <1> SpeakerOff:
    25 000036C7 E461                <1>     in al,61h
    26 000036C9 24FC                <1>     and al,0FCh
    27 000036CB E661                <1>     out 61h,al
    28 000036CD C3                  <1>     ret
