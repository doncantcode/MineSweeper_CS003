   750 00003606 8A16[8464]          <1>     mov dl, [CurCols]
   751 0000360A F6E2                <1>     mul dl                      ; AX = row * width
   752 0000360C 89C6                <1>     mov si, ax
   753 0000360E 89C1                <1>     mov cx, ax
   754 00003610 020E[8464]          <1>     add cl, [CurCols]
   755 00003614 80D500              <1>     adc ch, 0                   ; CX = (row + 1) * width
   756                              <1> 
   757                              <1> .sweepLp:
   758 00003617 39CE                <1>     cmp si, cx
   759 00003619 7328                <1>     jae .sweepDone
   760 0000361B F684[2B62]01        <1>     test byte [Board+si], 1     ; mine?
