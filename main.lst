    59 00002BED 803E[CE64]48        <1>     cmp byte [SaveBuffer+2],'H'
    60 00002BF2 0F859700            <1>     jne .invalid
    61 00002BF6 803E[CF64]31        <1>     cmp byte [SaveBuffer+3],'1'
    62 00002BFB 0F858E00            <1>     jne .invalid
    63 00002BFF A0[D264]            <1>     mov al,[SaveBuffer+6]
