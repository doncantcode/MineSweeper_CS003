    76 00002C21 C606[D364]00        <1>     mov byte [SaveBuffer+7],0   ; equipped but not owned: just unequip it
    77                              <1> .valid:
    78 00002C26 A1[D064]            <1>     mov ax,[SaveBuffer+4]
    79 00002C29 A3[C464]            <1>     mov [Shrapnels],ax
