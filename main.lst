    46                                  %include "src/audio.asm"        ; PC speaker engine (music + effects)
     1                              <1> ; -------------------------------------------------------------------
     2                              <1> ; Sound engine: one-shot effects (SfxBoom / SfxWin) on the PC speaker
     3                              <1> ; (PIT channel 2, port 61h gate).  An effect takes the speaker over,
     4                              <1> ; stopping the music, and the tune picks up again from Riff 1 when the
     5                              <1> ; effect has finished.  Song and effect entries share one format:
     6                              <1> ; (frequency Hz, ticks); 0 Hz = rest; 0FFFFh = loop back / stop.
     7                              <1> ; -------------------------------------------------------------------
     8                              <1> MusicStep:                      ; AX = BIOS ticks since last call
     9 00001BC5 60                  <1>     pusha
    10 00001BC6 803E[3B2A]00        <1>     cmp byte [SfxOn],0
    11 00001BCB 741D                <1>     je .music
    12 00001BCD 8B1E[3E2A]          <1>     mov bx,[SfxLeft]            ; --- effect playing ---
    13 00001BD1 39D8                <1>     cmp ax,bx
    14 00001BD3 7205                <1>     jb .sfxhold
    15 00001BD5 E85C00              <1>     call SfxAdvance             ; effect note finished -> next one
    16 00001BD8 EB58                <1>     jmp .done
    17                              <1> .sfxhold:
    18 00001BDA 29C3                <1>     sub bx,ax
    19 00001BDC 891E[3E2A]          <1>     mov [SfxLeft],bx
    20 00001BE0 83FB01              <1>     cmp bx,1
    21 00001BE3 774D                <1>     ja .done
    22 00001BE5 E8D300              <1>     call SpeakerOff             ; last tick of an effect note
    23 00001BE8 EB48                <1>     jmp .done
    24                              <1> 
    25                              <1> .music:
    26 00001BEA 803E[362A]00        <1>     cmp byte [MusicOn],0
    27 00001BEF 7441                <1>     je .done
    28 00001BF1 8B1E[372A]          <1>     mov bx,[NoteLeft]
    29 00001BF5 39D8                <1>     cmp ax,bx
    30 00001BF7 7310                <1>     jae .next                   ; current note finished
    31 00001BF9 29C3                <1>     sub bx,ax
    32 00001BFB 891E[372A]          <1>     mov [NoteLeft],bx
    33 00001BFF 83FB01              <1>     cmp bx,1
    34 00001C02 772E                <1>     ja .done
    35 00001C04 E8B400              <1>     call SpeakerOff             ; last tick of a note = short gap
    36 00001C07 EB29                <1>     jmp .done
    37                              <1> .next:
    38 00001C09 8B36[392A]          <1>     mov si,[MusicPtr]
    39 00001C0D 8B1C                <1>     mov bx,[si]
    40 00001C0F 83FBFF              <1>     cmp bx,0FFFFh
    41 00001C12 7505                <1>     jne .play
    42 00001C14 BE[D227]            <1>     mov si,SongTable            ; end of tune -> loop
    43 00001C17 8B1C                <1>     mov bx,[si]
    44                              <1> .play:
    45 00001C19 8B4402              <1>     mov ax,[si+2]
    46 00001C1C A3[372A]            <1>     mov [NoteLeft],ax
    47 00001C1F 83C604              <1>     add si,4
    48 00001C22 8936[392A]          <1>     mov [MusicPtr],si
    49 00001C26 09DB                <1>     or bx,bx
    50 00001C28 7405                <1>     jz .rest
    51 00001C2A E87100              <1>     call SpeakerOn
    52 00001C2D EB03                <1>     jmp .done
    53                              <1> .rest:
    54 00001C2F E88900              <1>     call SpeakerOff
    55                              <1> .done:
    56 00001C32 61                  <1>     popa
    57 00001C33 C3                  <1>     ret
    58                              <1> 
    59                              <1> ; Pull the next entry of the running effect.  When the table ends the
    60                              <1> ; effect is over and the tune restarts from Riff 1 (unless muted).
    61                              <1> SfxAdvance:
    62 00001C34 60                  <1>     pusha
    63 00001C35 8B36[3C2A]          <1>     mov si,[SfxPtr]
